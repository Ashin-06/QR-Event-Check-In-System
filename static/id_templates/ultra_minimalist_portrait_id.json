{
  "name": "Ultra Minimalist Portrait ID",
  "html": "<main class=\"card-container bg-surface flex flex-col relative overflow-hidden rounded-xl border border-outline-variant\">\n<!-- Header Section -->\n<header class=\"p-card-padding flex justify-between items-start\">\n<div class=\"flex flex-col\">\n<span class=\"font-id-role text-id-role text-primary tracking-widest uppercase\">{Event}</span>\n<h1 class=\"font-serif-display text-2xl text-on-surface mt-1\">{Name}</h1>\n</div>\n<div class=\"thin-border p-1 rounded-sm\">\n<span class=\"material-symbols-outlined text-on-surface-variant\" data-icon=\"badge\">badge</span>\n</div>\n</header>\n<!-- Portrait Section -->\n<section class=\"px-card-padding flex justify-center\">\n<div class=\"w-full aspect-[4/5] relative grayscale-filter bg-surface-container overflow-hidden rounded-sm thin-border\">\n<img alt=\"{Name}\" class=\"w-full h-full object-cover\" data-alt=\"A professional studio portrait of a woman with a confident, calm expression. She has dark hair styled neatly. The image is rendered in a high-contrast black and white, minimalist style. The lighting is soft and directional, emphasizing the clean lines of her face. The background is a flat, neutral gray, contributing to the ultra-minimalist, architectural aesthetic of the credential.\" src=\"{PHOTO_URL}\"/>\n</div>\n</section>\n<!-- Data Grid Section -->\n<section class=\"flex-grow p-card-padding grid grid-cols-2 gap-y-element-gap gap-x-4 border-t border-outline-variant/30 mt-6 pt-6\">\n<!-- Row 1 -->\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant mb-1 uppercase\">Role</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant mb-1 uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-on-surface\">ID-992-ARC-01</span>\n</div>\n<!-- Row 2 -->\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant mb-1 uppercase\">Branch</span>\n<span class=\"font-id-role text-id-role text-on-surface\">Central Bureau</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant mb-1 uppercase\">Department</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Subgroup}</span>\n</div>\n<!-- Row 3 -->\n<div class=\"flex flex-col col-span-2\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant mb-1 uppercase\">Email</span>\n<span class=\"font-id-role text-id-role text-on-surface\">e.kostic@{Event}.org</span>\n</div>\n</section>\n<!-- Footer / Integrated QR -->\n<footer class=\"p-card-padding bg-surface-container-lowest flex justify-between items-end\">\n<div class=\"flex flex-col gap-2\">\n<div class=\"flex items-center gap-2\">\n<div class=\"w-2 h-2 rounded-full bg-secondary\"></div>\n<span class=\"font-label-caps text-label-caps text-secondary uppercase\">Level 4 Access</span>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"font-id-number text-id-number text-outline\">EXPIRES: 12/2026</span>\n</div>\n</div>\n<!-- QR Code Area -->\n<div class=\"relative w-20 h-20 bg-white p-1 rounded-sm thin-border\">\n<img alt=\"Security QR Code\" class=\"w-full h-full opacity-90\" src=\"{QR_CODE_URL}\"/>\n<!-- Shimmer Overlay for \"Security\" -->\n<div class=\"shimmer-hologram absolute inset-0 pointer-events-none\"></div>\n</div>\n</footer>\n<!-- Micro-detail: Vertical \"Security\" spine -->\n<div class=\"absolute right-0 top-1/2 -translate-y-1/2 flex items-center px-1\">\n<span class=\"font-label-caps text-[8px] text-outline-variant uppercase [writing-mode:vertical-lr] tracking-[0.4em]\">AUTHENTICATED CREDENTIAL</span>\n</div>\n</main>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;\n        }\n        .grayscale-filter {\n            filter: grayscale(100%) contrast(1.1);\n        }\n        .card-container {\n            width: 380px;\n            height: 580px;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);\n        }\n        .thin-border {\n            border: 0.5px solid #121c2a;\n        }\n        .shimmer-hologram {\n            background: linear-gradient(135deg, rgba(0, 50, 125, 0.1) 0%, rgba(255, 174, 60, 0.1) 50%, rgba(0, 108, 73, 0.1) 100%);\n            opacity: 0.4;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}