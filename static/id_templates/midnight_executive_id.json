{
  "name": "Midnight Executive ID",
  "html": "<!-- TopAppBar (Shared Component) -->\n<header class=\"w-full top-0 sticky flex justify-between items-center px-section-margin bg-surface dark:bg-on-surface border-b border-outline-variant dark:border-outline z-50 py-4\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary-fixed\" data-icon=\"badge\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary dark:text-primary-fixed tracking-tight\">ID Registry</h1>\n</div>\n<div class=\"flex items-center gap-4\">\n<div class=\"hidden md:flex gap-6 items-center px-4\">\n<a class=\"text-primary dark:text-primary-fixed font-medium transition-colors hover:text-primary-container\" href=\"#\">Dashboard</a>\n<a class=\"text-on-surface-variant dark:text-outline-variant font-medium transition-colors hover:text-primary\" href=\"#\">Registry</a>\n</div>\n<div class=\"w-10 h-10 rounded-full overflow-hidden border border-outline-variant\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" data-alt=\"A professional headshot of a corporate executive for a profile avatar. The man is wearing a crisp navy suit and has a confident, approachable expression. The lighting is high-end studio quality with a clean, light-grey background that fits a modern light-mode interface.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</header>\n<main class=\"flex flex-col md:flex-row min-h-[calc(100vh-72px)] pb-20 md:pb-0\">\n<!-- NavigationDrawer (Shared Component - Web Only) -->\n<aside class=\"hidden md:flex flex-col h-[calc(100vh-72px)] w-80 bg-surface-container-low dark:bg-on-surface shadow-md sticky top-[72px] z-40 transition-all\">\n<div class=\"p-6 border-b border-outline-variant/30\">\n<div class=\"flex items-center gap-4\">\n<div class=\"w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-white\" data-icon=\"admin_panel_settings\">admin_panel_settings</span>\n</div>\n<div>\n<p class=\"font-id-name text-id-name text-primary leading-tight\">System Admin</p>\n<p class=\"font-id-role text-id-role text-on-surface-variant opacity-70\">Bulk Management</p>\n</div>\n</div>\n</div>\n<nav class=\"flex-1 p-4 space-y-2\">\n<a class=\"flex items-center gap-4 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-full scale-95 duration-150 transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"app_registration\">app_registration</span>\n<span class=\"font-id-role text-id-role\">Registration</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant transition-colors duration-200 rounded-full\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"style\">style</span>\n<span class=\"font-id-role text-id-role\">Templates</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant transition-colors duration-200 rounded-full\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-id-role text-id-role\">Analytics</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant transition-colors duration-200 rounded-full\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n<span class=\"font-id-role text-id-role\">Settings</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant transition-colors duration-200 rounded-full\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"help\">help</span>\n<span class=\"font-id-role text-id-role\">Help</span>\n</a>\n</nav>\n</aside>\n<!-- Main Content Area (Canvas) -->\n<section class=\"flex-1 p-6 md:p-12 flex flex-col items-center justify-center bg-surface-bright\">\n<div class=\"mb-10 text-center\">\n<h2 class=\"font-id-name text-3xl text-primary mb-2\">Midnight Executive Template</h2>\n<p class=\"text-on-surface-variant font-id-role\">Previewing high-fidelity credential layout</p>\n</div>\n<!-- CR80 ID Card Template -->\n<div class=\"cr80-card bg-white rounded-xl shadow-2xl flex flex-col overflow-hidden relative border border-outline-variant/20\">\n<!-- Security Hologram Digital Overlay -->\n<div class=\"absolute inset-0 pointer-events-none shimmer opacity-10\"></div>\n<!-- Top Side: Header -->\n<div class=\"h-28 bg-midnight-charcoal relative flex flex-col items-center justify-center pt-4\">\n<div class=\"gold-gradient-border h-[2px] w-full absolute top-0\"></div>\n<p class=\"font-label-caps text-label-caps text-gold-trim tracking-[0.2em] mb-2 uppercase\">REGISTRY AUTHORIZED</p>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-gold-trim text-sm\" data-icon=\"workspace_premium\" style=\"font-variation-settings: 'FILL' 1;\">workspace_premium</span>\n<p class=\"font-id-name text-white tracking-widest text-lg uppercase\">EXECUTIVE ACCESS</p>\n</div>\n</div>\n<!-- Gold Separator -->\n<div class=\"h-1 bg-gold-trim\"></div>\n<!-- Circular Photo Placeholder -->\n<div class=\"absolute top-20 left-1/2 -translate-x-1/2 z-10\">\n<div class=\"w-28 h-28 rounded-full border-4 border-white shadow-lg overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A portrait of a male corporate professional with a focused and serious expression, ideal for a security identification card. He is wearing a dark grey executive blazer. The lighting is sharp, creating a high-contrast industrial utility feel with a clean white background and high-visibility details.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n<!-- Card Content -->\n<div class=\"flex-1 pt-24 px-8 pb-4 flex flex-col\">\n<div class=\"text-center mb-6\">\n<h3 class=\"font-id-name text-2xl text-midnight-charcoal\">{Name}</h3>\n<p class=\"font-id-role text-primary-container font-semibold tracking-wider uppercase\">{Pass Type}</p>\n</div>\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-4\">\n<div class=\"space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">ID Number</label>\n<p class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</p>\n</div>\n<div class=\"space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">Branch</label>\n<p class=\"font-body-sm text-on-surface font-semibold\">{Unique ID}</p>\n</div>\n<div class=\"col-span-2 space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">Department</label>\n<p class=\"font-body-sm text-on-surface font-semibold\">EXECUTIVE OPERATIONS COUNCIL</p>\n</div>\n<div class=\"col-span-2 space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">Email Address</label>\n<p class=\"font-body-sm text-primary underline decoration-gold-trim/50\">{Email Address}</p>\n</div>\n</div>\n<!-- Bottom Content: Date, Venue, QR -->\n<div class=\"mt-auto pt-6 flex items-end justify-between border-t border-outline-variant/30\">\n<div class=\"space-y-2\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-xs text-on-surface-variant\" data-icon=\"calendar_today\">calendar_today</span>\n<p class=\"font-label-caps text-label-caps text-on-surface uppercase\">JAN 24, 2025</p>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-xs text-on-surface-variant\" data-icon=\"location_on\">location_on</span>\n<p class=\"font-label-caps text-label-caps text-on-surface uppercase\">Summit Hall, DC</p>\n</div>\n</div>\n<!-- QR Code Container -->\n<div class=\"w-20 h-20 bg-white p-1 border border-outline-variant\">\n<img alt=\"QR Access Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</div>\n<!-- Footer Status Bar -->\n<div class=\"h-2 bg-midnight-charcoal\"></div>\n<div class=\"h-1 bg-gold-trim\"></div>\n</div>\n<!-- Download / Action Buttons -->\n<div class=\"mt-12 flex gap-4\">\n<button class=\"bg-primary text-white font-id-role px-8 py-3 rounded-xl flex items-center gap-2 hover:bg-primary-container transition-all active:scale-95 shadow-lg\">\n<span class=\"material-symbols-outlined\" data-icon=\"download\">download</span>\n                    Print Digital Copy\n                </button>\n<button class=\"bg-white text-primary border border-primary font-id-role px-8 py-3 rounded-xl flex items-center gap-2 hover:bg-surface-container transition-all active:scale-95 shadow-sm\">\n<span class=\"material-symbols-outlined\" data-icon=\"edit\">edit</span>\n                    Edit Record\n                </button>\n</div>\n</section>\n</main>\n<!-- BottomNavBar (Shared Component - Mobile Only) -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant shadow-lg z-50\">\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-[8px] mt-1 uppercase\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-[8px] mt-1 uppercase\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-[8px] mt-1 uppercase\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-[8px] mt-1 uppercase\">Profile</span>\n</div>\n</nav>\n<script>\n        // Micro-interaction for card tilt effect (Desktop only)\n        const card = document.querySelector('.cr80-card');\n        const container = card.parentElement;\n\n        container.addEventListener('mousemove', (e) => {\n            if (window.innerWidth < 768) return;\n            const rect = container.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            const rotateX = (y - centerY) / 20;\n            const rotateY = (centerX - x) / 20;\n\n            card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n\n        container.addEventListener('mouseleave', () => {\n            card.style.transform = `rotateX(0deg) rotateY(0deg)`;\n        });\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .gold-gradient-border {\n            background: linear-gradient(to right, #d4af37, #fcf6ba, #d4af37, #fcf6ba, #d4af37);\n        }\n        .cr80-card {\n            width: 350px;\n            height: 540px;\n            perspective: 1000px;\n        }\n        .glass-overlay {\n            backdrop-filter: blur(8px);\n            background: rgba(255, 255, 255, 0.05);\n        }\n        .shimmer {\n            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.2), transparent);\n            background-size: 200% 100%;\n            animation: shimmer 3s infinite;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}