{
  "name": "Midnight Executive ID",
  "html": "<div class=\"cr80-card bg-white rounded-xl shadow-2xl flex flex-col overflow-hidden relative border border-outline-variant/20\">\n<!-- Security Hologram Digital Overlay -->\n<div class=\"absolute inset-0 pointer-events-none shimmer opacity-10\"></div>\n<!-- Top Side: Header -->\n<div class=\"h-28 bg-midnight-charcoal relative flex flex-col items-center justify-center pt-4\">\n<div class=\"gold-gradient-border h-[2px] w-full absolute top-0\"></div>\n<p class=\"font-label-caps text-label-caps text-gold-trim tracking-[0.2em] mb-2 uppercase\">REGISTRY AUTHORIZED</p>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-gold-trim text-sm\" data-icon=\"workspace_premium\" style=\"font-variation-settings: 'FILL' 1;\">workspace_premium</span>\n<p class=\"font-id-name text-white tracking-widest text-lg uppercase\">EXECUTIVE ACCESS</p>\n</div>\n</div>\n<!-- Gold Separator -->\n<div class=\"h-1 bg-gold-trim\"></div>\n<!-- Circular Photo Placeholder -->\n<div class=\"absolute top-20 left-1/2 -translate-x-1/2 z-10\">\n<div class=\"w-28 h-28 rounded-full border-4 border-white shadow-lg overflow-hidden bg-surface-container\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A portrait of a male corporate professional with a focused and serious expression, ideal for a security identification card. He is wearing a dark grey executive blazer. The lighting is sharp, creating a high-contrast industrial utility feel with a clean white background and high-visibility details.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n<!-- Card Content -->\n<div class=\"flex-1 pt-24 px-8 pb-4 flex flex-col\">\n<div class=\"text-center mb-6\">\n<h3 class=\"font-id-name text-2xl text-midnight-charcoal\">{Name}</h3>\n<p class=\"font-id-role text-primary-container font-semibold tracking-wider uppercase\">{Pass Type}</p>\n</div>\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-4\">\n<div class=\"space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">ID Number</label>\n<p class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</p>\n</div>\n<div class=\"space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">Branch</label>\n<p class=\"font-body-sm text-on-surface font-semibold\">{Unique ID}</p>\n</div>\n<div class=\"col-span-2 space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">Department</label>\n<p class=\"font-body-sm text-on-surface font-semibold\">EXECUTIVE OPERATIONS COUNCIL</p>\n</div>\n<div class=\"col-span-2 space-y-1\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-60\">Email Address</label>\n<p class=\"font-body-sm text-primary underline decoration-gold-trim/50\">{Email Address}</p>\n</div>\n</div>\n<!-- Bottom Content: Date, Venue, QR -->\n<div class=\"mt-auto pt-6 flex items-end justify-between border-t border-outline-variant/30\">\n<div class=\"space-y-2\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-xs text-on-surface-variant\" data-icon=\"calendar_today\">calendar_today</span>\n<p class=\"font-label-caps text-label-caps text-on-surface uppercase\">JAN 24, 2025</p>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-xs text-on-surface-variant\" data-icon=\"location_on\">location_on</span>\n<p class=\"font-label-caps text-label-caps text-on-surface uppercase\">Summit Hall, DC</p>\n</div>\n</div>\n<!-- QR Code Container -->\n<div class=\"w-20 h-20 bg-white p-1 border border-outline-variant\">\n<img alt=\"QR Access Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</div>\n<!-- Footer Status Bar -->\n<div class=\"h-2 bg-midnight-charcoal\"></div>\n<div class=\"h-1 bg-gold-trim\"></div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .gold-gradient-border {\n            background: linear-gradient(to right, #d4af37, #fcf6ba, #d4af37, #fcf6ba, #d4af37);\n        }\n        .cr80-card {\n            width: 350px;\n            height: 540px;\n            perspective: 1000px;\n        }\n        .glass-overlay {\n            backdrop-filter: blur(8px);\n            background: rgba(255, 255, 255, 0.05);\n        }\n        .shimmer {\n            background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.2), transparent);\n            background-size: 200% 100%;\n            animation: shimmer 3s infinite;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface font-body-sm text-on-background",
  "tailwind_config": "{\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-container\": \"#0047ab\",\n                        \"on-surface-variant\": \"#434653\",\n                        \"surface-container\": \"#e6eeff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-fixed\": \"#dae2ff\",\n                        \"on-background\": \"#121c2a\",\n                        \"secondary\": \"#006c49\",\n                        \"primary\": \"#00327d\",\n                        \"surface\": \"#f8f9ff\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-dim\": \"#d0dbed\",\n                        \"background\": \"#f8f9ff\",\n                        \"on-secondary-fixed\": \"#002113\",\n                        \"on-primary-fixed\": \"#001946\",\n                        \"on-primary-fixed-variant\": \"#00419e\",\n                        \"surface-tint\": \"#2559bd\",\n                        \"inverse-surface\": \"#27313f\",\n                        \"on-secondary-container\": \"#00714d\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"surface-variant\": \"#d9e3f6\",\n                        \"outline-variant\": \"#c3c6d5\",\n                        \"inverse-primary\": \"#b1c5ff\",\n                        \"primary-fixed-dim\": \"#b1c5ff\",\n                        \"on-tertiary-fixed-variant\": \"#653e00\",\n                        \"surface-bright\": \"#f8f9ff\",\n                        \"on-tertiary-fixed\": \"#2a1700\",\n                        \"secondary-container\": \"#6cf8bb\",\n                        \"tertiary-container\": \"#6e4400\",\n                        \"tertiary\": \"#4f3000\",\n                        \"on-surface\": \"#121c2a\",\n                        \"on-error-container\": \"#93000a\",\n                        \"error\": \"#ba1a1a\",\n                        \"surface-container-highest\": \"#d9e3f6\",\n                        \"on-error\": \"#ffffff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#ffddb8\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"on-secondary-fixed-variant\": \"#005236\",\n                        \"secondary-fixed-dim\": \"#4edea3\",\n                        \"secondary-fixed\": \"#6ffbbe\",\n                        \"outline\": \"#737784\",\n                        \"tertiary-fixed-dim\": \"#ffb95f\",\n                        \"surface-container-high\": \"#dee9fc\",\n                        \"on-tertiary-container\": \"#ffae3c\",\n                        \"on-primary-container\": \"#a5bdff\",\n                        \"midnight-charcoal\": \"#1a1c1e\",\n                        \"gold-trim\": \"#d4af37\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"element-gap\": \"0.75rem\",\n                        \"photo-size-lg\": \"120px\",\n                        \"card-padding\": \"1.5rem\",\n                        \"section-margin\": \"1rem\",\n                        \"photo-size-sm\": \"80px\"\n                    },\n                    \"fontFamily\": {\n                        \"id-name\": [\"Hanken Grotesk\"],\n                        \"id-role\": [\"Inter\"],\n                        \"body-sm\": [\"Inter\"],\n                        \"label-caps\": [\"Inter\"],\n                        \"id-number\": [\"JetBrains Mono\"]\n                    },\n                    \"fontSize\": {\n                        \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                        \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                        \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n                    }\n                },\n            },\n        }"
}