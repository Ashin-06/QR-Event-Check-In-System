{
  "name": "Cyberpunk Neon ID",
  "html": "<div class=\"relative w-[340px] h-[540px] bg-black border-2 border-outline/40 shadow-[0_0_30px_rgba(0,255,0,0.1)] overflow-hidden rounded-lg flex flex-col p-6 cyber-grid\">\n<!-- Background Atmospheric Effects -->\n<div class=\"absolute top-0 right-0 w-32 h-32 bg-error opacity-10 blur-[60px]\"></div>\n<div class=\"absolute bottom-0 left-0 w-40 h-40 bg-outline opacity-10 blur-[80px]\"></div>\n<div class=\"scanline\"></div>\n<!-- TOP SECTION: HEADER -->\n<div class=\"relative z-20 flex justify-between items-start mb-6 border-b border-outline/30 pb-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-error neon-pink-glow uppercase mb-1\">Authorization Status</span>\n<h2 class=\"font-id-name text-[24px] text-white tracking-widest uppercase italic font-black\">{Pass Type}</h2>\n</div>\n<div class=\"flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-outline text-[18px]\">person</span>\n<span class=\"font-id-number text-[10px] text-outline font-bold\">V.2.0.5</span>\n</div>\n</div>\n<!-- RIGHT SIDE: VERTICAL STATUS BAR -->\n<div class=\"absolute right-0 top-1/2 -translate-y-1/2 flex flex-col items-center gap-12 pr-1 h-[60%]\">\n<div class=\"h-full w-[2px] bg-gradient-to-b from-transparent via-outline to-transparent opacity-30\"></div>\n<div class=\"rotate-90 origin-center whitespace-nowrap\">\n<span class=\"font-id-role text-[24px] text-outline neon-green-glow font-black tracking-[0.4em] uppercase\">LEVEL 5</span>\n</div>\n<div class=\"h-full w-[2px] bg-gradient-to-b from-transparent via-outline to-transparent opacity-30\"></div>\n</div>\n<!-- PHOTO CONTAINER -->\n<div class=\"relative z-20 w-48 h-48 mx-auto mb-8 glitch-border bg-surface-dim overflow-hidden shadow-[0_0_15px_rgba(0,255,0,0.2)]\">\n<img alt=\"Operative Photo\" class=\"w-full h-full object-cover filter contrast-125 saturate-150\" data-alt=\"A gritty, cinematic portrait of a cyberpunk character with neon green light illuminating one side of their face. They are wearing high-tech urban gear with intricate textures. The image is filtered with a subtle digital grain and glitch aberrations, set against a pitch-black background with hints of magenta flares.\" src=\"{PHOTO_URL}\"/>\n<!-- Overlays -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent\"></div>\n<div class=\"absolute bottom-2 left-2 flex items-center gap-1\">\n<div class=\"w-2 h-2 rounded-full bg-outline animate-pulse\"></div>\n<span class=\"font-label-caps text-[8px] text-outline\">ACTIVE SYNC</span>\n</div>\n</div>\n<!-- DATA FIELDS SECTION (7 Fields) -->\n<div class=\"relative z-20 grid grid-cols-2 gap-x-4 gap-y-4 mr-10\">\n<div class=\"col-span-2 border-l-2 border-error pl-3 mb-2\">\n<p class=\"font-label-caps text-label-caps text-on-surface-variant uppercase opacity-70\">Designation</p>\n<p class=\"font-id-name text-id-name text-white tracking-wide\">{Name}</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Clearance</p>\n<p class=\"font-id-number text-id-number text-outline font-bold\">{Unique ID}</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Dept</p>\n<p class=\"font-id-number text-id-number text-white\">NEURAL-OPS</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Issue Date</p>\n<p class=\"font-id-number text-id-number text-white\">{Registration Number}</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Expiry</p>\n<p class=\"font-id-number text-id-number text-error neon-pink-glow\">INDEFINITE</p>\n</div>\n<div class=\"col-span-2 flex items-center justify-between mt-2 pt-2 border-t border-outline/10\">\n<div class=\"flex flex-col\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">ID Hash</p>\n<p class=\"font-id-number text-[9px] text-outline/60 overflow-hidden text-ellipsis w-32\">0x8f22e7...a4491c</p>\n</div>\n<!-- GLOWING QR CODE -->\n<div class=\"relative group\">\n<div class=\"absolute -inset-1 bg-outline rounded-sm blur opacity-20 group-hover:opacity-100 transition duration-1000\"></div>\n<div class=\"relative w-12 h-12 bg-white p-1 flex items-center justify-center border border-outline\">\n<div class=\"w-full h-full bg-black relative\">\n<div class=\"absolute inset-0 flex flex-wrap gap-px\"><img alt=\"QR Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- FOOTER DECORATION -->\n<div class=\"mt-auto flex justify-between items-end\">\n<div class=\"flex gap-1\">\n<div class=\"w-1 h-4 bg-outline\"></div>\n<div class=\"w-1 h-3 bg-outline/60\"></div>\n<div class=\"w-1 h-2 bg-outline/30\"></div>\n</div>\n<p class=\"font-id-number text-[8px] text-outline/40 italic\">GENUINE SYSTEM ASSET — UNAUTHORIZED DUPLICATION IS PUNISHABLE BY DE-RES</p>\n</div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 48;\n        }\n        .neon-pink-glow {\n            text-shadow: 0 0 5px #ff00ff, 0 0 10px #ff00ff;\n            box-shadow: 0 0 5px #ff00ff, inset 0 0 5px #ff00ff;\n        }\n        .neon-green-glow {\n            text-shadow: 0 0 5px #00ff00, 0 0 10px #00ff00;\n            box-shadow: 0 0 5px #00ff00, inset 0 0 5px #00ff00;\n        }\n        .glitch-border {\n            position: relative;\n            border: 2px solid #00ff00;\n        }\n        .glitch-border::before {\n            content: '';\n            position: absolute;\n            top: -4px;\n            left: -4px;\n            right: -4px;\n            bottom: -4px;\n            border: 1px solid #ff00ff;\n            animation: glitch-anim 2s infinite linear alternate-reverse;\n            opacity: 0.6;\n        }\n        @keyframes glitch-anim {\n            0% { clip-path: inset(80% 0 0 0); transform: translate(-2px, 2px); }\n            20% { clip-path: inset(20% 0 60% 0); transform: translate(2px, -2px); }\n            40% { clip-path: inset(40% 0 40% 0); transform: translate(-2px, -2px); }\n            60% { clip-path: inset(0 0 80% 0); transform: translate(2px, 2px); }\n            100% { clip-path: inset(10% 0 50% 0); transform: translate(0, 0); }\n        }\n        .scanline {\n            width: 100%;\n            height: 2px;\n            background: rgba(0, 255, 0, 0.3);\n            position: absolute;\n            top: 0;\n            left: 0;\n            z-index: 10;\n            animation: scan 4s linear infinite;\n        }\n        @keyframes scan {\n            from { top: 0; }\n            to { top: 100%; }\n        }\n        .cyber-grid {\n            background-image: \n                linear-gradient(to right, rgba(0, 255, 0, 0.05) 1px, transparent 1px),\n                linear-gradient(to bottom, rgba(0, 255, 0, 0.05) 1px, transparent 1px);\n            background-size: 20px 20px;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-background text-on-surface font-body-sm py-10 px-4",
  "tailwind_config": "{\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-container\": \"#0047ab\",\n                        \"on-surface-variant\": \"#434653\",\n                        \"surface-container\": \"#e6eeff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-fixed\": \"#dae2ff\",\n                        \"on-background\": \"#121c2a\",\n                        \"secondary\": \"#006c49\",\n                        \"primary\": \"#00327d\",\n                        \"surface\": \"#050505\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-dim\": \"#0a0a0a\",\n                        \"background\": \"#000000\",\n                        \"on-secondary-fixed\": \"#002113\",\n                        \"on-primary-fixed\": \"#001946\",\n                        \"on-primary-fixed-variant\": \"#00419e\",\n                        \"surface-tint\": \"#2559bd\",\n                        \"inverse-surface\": \"#27313f\",\n                        \"on-secondary-container\": \"#00714d\",\n                        \"surface-container-lowest\": \"#000000\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"surface-variant\": \"#1a1a1a\",\n                        \"outline-variant\": \"#c3c6d5\",\n                        \"inverse-primary\": \"#b1c5ff\",\n                        \"primary-fixed-dim\": \"#b1c5ff\",\n                        \"on-tertiary-fixed-variant\": \"#653e00\",\n                        \"surface-bright\": \"#111111\",\n                        \"on-tertiary-fixed\": \"#2a1700\",\n                        \"secondary-container\": \"#6cf8bb\",\n                        \"tertiary-container\": \"#6e4400\",\n                        \"tertiary\": \"#4f3000\",\n                        \"on-surface\": \"#ffffff\",\n                        \"on-error-container\": \"#93000a\",\n                        \"error\": \"#ff00ff\",\n                        \"surface-container-highest\": \"#d9e3f6\",\n                        \"on-error\": \"#ffffff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#ffddb8\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"on-secondary-fixed-variant\": \"#005236\",\n                        \"secondary-fixed-dim\": \"#4edea3\",\n                        \"secondary-fixed\": \"#6ffbbe\",\n                        \"outline\": \"#00ff00\",\n                        \"tertiary-fixed-dim\": \"#ffb95f\",\n                        \"surface-container-high\": \"#dee9fc\",\n                        \"on-tertiary-container\": \"#ffae3c\",\n                        \"on-primary-container\": \"#a5bdff\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.125rem\",\n                        \"lg\": \"0.25rem\",\n                        \"xl\": \"0.5rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"element-gap\": \"0.75rem\",\n                        \"photo-size-lg\": \"120px\",\n                        \"card-padding\": \"1.5rem\",\n                        \"section-margin\": \"1rem\",\n                        \"photo-size-sm\": \"80px\"\n                    },\n                    \"fontFamily\": {\n                        \"id-name\": [\"Hanken Grotesk\"],\n                        \"id-role\": [\"Inter\"],\n                        \"body-sm\": [\"Inter\"],\n                        \"label-caps\": [\"Inter\"],\n                        \"id-number\": [\"JetBrains Mono\"]\n                    },\n                    \"fontSize\": {\n                        \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"800\"}],\n                        \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.1em\", \"fontWeight\": \"600\"}],\n                        \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.15em\", \"fontWeight\": \"700\"}],\n                        \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n                    }\n                },\n            },\n        }"
}