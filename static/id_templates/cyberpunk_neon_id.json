{
  "name": "Cyberpunk Neon ID",
  "html": "<!-- Main Container -->\n<div class=\"relative w-full max-w-4xl flex flex-col md:flex-row gap-10 items-start justify-center\">\n<!-- SIDENAV (Instructional Requirement) -->\n<nav class=\"hidden md:flex fixed left-0 top-0 h-full z-40 bg-surface-container-lowest border-r border-outline/30 w-72 flex-col p-6 shadow-2xl\">\n<div class=\"mb-10\">\n<span class=\"font-id-name text-id-name text-outline uppercase tracking-widest block\">ID Registry</span>\n<span class=\"font-label-caps text-label-caps text-on-surface-variant opacity-60\">ADMINISTRATION CONSOLE</span>\n</div>\n<div class=\"flex flex-col gap-4 flex-grow\">\n<a class=\"flex items-center gap-3 p-3 bg-secondary-container/10 text-outline rounded-xl transition-all hover:bg-secondary-container/20 group\" href=\"#\">\n<span class=\"material-symbols-outlined text-outline\">app_registration</span>\n<span class=\"font-id-role text-id-role\">Registration</span>\n</a>\n<a class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant/20 rounded-xl transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">style</span>\n<span class=\"font-id-role text-id-role\">Templates</span>\n</a>\n<a class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant/20 rounded-xl transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">analytics</span>\n<span class=\"font-id-role text-id-role\">Analytics</span>\n</a>\n<a class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant/20 rounded-xl transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">settings</span>\n<span class=\"font-id-role text-id-role\">Settings</span>\n</a>\n<a class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant/20 rounded-xl transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">help</span>\n<span class=\"font-id-role text-id-role\">Help</span>\n</a>\n</div>\n<div class=\"mt-auto pt-6 border-t border-outline/20 flex items-center gap-4\">\n<div class=\"w-10 h-10 rounded-full overflow-hidden border border-outline shadow-[0_0_10px_rgba(0,255,0,0.3)]\">\n<img alt=\"Admin\" class=\"w-full h-full object-cover\" data-alt=\"A cinematic close-up portrait of a futuristic system administrator wearing high-tech eyewear. The lighting is dominated by sharp, cool cyan and neon green reflections. The style is hyper-realistic with a dark, moody atmosphere, emphasizing fine details of the skin and reflective surfaces of the tech accessories.\" src=\"{QR_CODE_URL}\"/>\n</div>\n<div>\n<p class=\"font-id-role text-[12px] text-on-surface leading-none font-bold\">System Admin</p>\n<p class=\"font-label-caps text-[10px] text-on-surface-variant uppercase tracking-tighter\">Bulk Management</p>\n</div>\n</div>\n</nav>\n<!-- TOP BAR (Mobile) -->\n<header class=\"md:hidden fixed top-0 left-0 w-full z-50 bg-surface border-b border-outline/20 px-6 py-4 flex justify-between items-center\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-outline\" style=\"font-variation-settings: 'FILL' 1;\">badge</span>\n<h1 class=\"font-id-name text-id-name text-outline uppercase\">ID Registry</h1>\n</div>\n<div class=\"w-8 h-8 rounded-full border border-outline overflow-hidden\">\n<img alt=\"Profile\" class=\"w-full h-full object-cover\" data-alt=\"A focused headshot of a person in a cyberpunk environment, with soft pink and green ambient light hitting their profile. The aesthetic is high-energy tech with a dark background.\" src=\"{PHOTO_URL}\"/>\n</div>\n</header>\n<!-- PORTRAIT ID CARD CANVAS -->\n<main class=\"relative mt-20 md:mt-0 md:ml-80 flex-grow flex items-center justify-center p-4\">\n<!-- THE ID CARD -->\n<div class=\"relative w-[340px] h-[540px] bg-black border-2 border-outline/40 shadow-[0_0_30px_rgba(0,255,0,0.1)] overflow-hidden rounded-lg flex flex-col p-6 cyber-grid\">\n<!-- Background Atmospheric Effects -->\n<div class=\"absolute top-0 right-0 w-32 h-32 bg-error opacity-10 blur-[60px]\"></div>\n<div class=\"absolute bottom-0 left-0 w-40 h-40 bg-outline opacity-10 blur-[80px]\"></div>\n<div class=\"scanline\"></div>\n<!-- TOP SECTION: HEADER -->\n<div class=\"relative z-20 flex justify-between items-start mb-6 border-b border-outline/30 pb-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-error neon-pink-glow uppercase mb-1\">Authorization Status</span>\n<h2 class=\"font-id-name text-[24px] text-white tracking-widest uppercase italic font-black\">{Pass Type}</h2>\n</div>\n<div class=\"flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-outline text-[18px]\">person</span>\n<span class=\"font-id-number text-[10px] text-outline font-bold\">V.2.0.5</span>\n</div>\n</div>\n<!-- RIGHT SIDE: VERTICAL STATUS BAR -->\n<div class=\"absolute right-0 top-1/2 -translate-y-1/2 flex flex-col items-center gap-12 pr-1 h-[60%]\">\n<div class=\"h-full w-[2px] bg-gradient-to-b from-transparent via-outline to-transparent opacity-30\"></div>\n<div class=\"rotate-90 origin-center whitespace-nowrap\">\n<span class=\"font-id-role text-[24px] text-outline neon-green-glow font-black tracking-[0.4em] uppercase\">LEVEL 5</span>\n</div>\n<div class=\"h-full w-[2px] bg-gradient-to-b from-transparent via-outline to-transparent opacity-30\"></div>\n</div>\n<!-- PHOTO CONTAINER -->\n<div class=\"relative z-20 w-48 h-48 mx-auto mb-8 glitch-border bg-surface-dim overflow-hidden shadow-[0_0_15px_rgba(0,255,0,0.2)]\">\n<img alt=\"Operative Photo\" class=\"w-full h-full object-cover filter contrast-125 saturate-150\" data-alt=\"A gritty, cinematic portrait of a cyberpunk character with neon green light illuminating one side of their face. They are wearing high-tech urban gear with intricate textures. The image is filtered with a subtle digital grain and glitch aberrations, set against a pitch-black background with hints of magenta flares.\" src=\"{PHOTO_URL}\"/>\n<!-- Overlays -->\n<div class=\"absolute inset-0 bg-gradient-to-t from-black/60 to-transparent\"></div>\n<div class=\"absolute bottom-2 left-2 flex items-center gap-1\">\n<div class=\"w-2 h-2 rounded-full bg-outline animate-pulse\"></div>\n<span class=\"font-label-caps text-[8px] text-outline\">ACTIVE SYNC</span>\n</div>\n</div>\n<!-- DATA FIELDS SECTION (7 Fields) -->\n<div class=\"relative z-20 grid grid-cols-2 gap-x-4 gap-y-4 mr-10\">\n<div class=\"col-span-2 border-l-2 border-error pl-3 mb-2\">\n<p class=\"font-label-caps text-label-caps text-on-surface-variant uppercase opacity-70\">Designation</p>\n<p class=\"font-id-name text-id-name text-white tracking-wide\">{Name}</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Clearance</p>\n<p class=\"font-id-number text-id-number text-outline font-bold\">{Unique ID}</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Dept</p>\n<p class=\"font-id-number text-id-number text-white\">NEURAL-OPS</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Issue Date</p>\n<p class=\"font-id-number text-id-number text-white\">{Registration Number}</p>\n</div>\n<div class=\"border-l border-outline/30 pl-2\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">Expiry</p>\n<p class=\"font-id-number text-id-number text-error neon-pink-glow\">INDEFINITE</p>\n</div>\n<div class=\"col-span-2 flex items-center justify-between mt-2 pt-2 border-t border-outline/10\">\n<div class=\"flex flex-col\">\n<p class=\"font-label-caps text-[8px] text-on-surface-variant uppercase\">ID Hash</p>\n<p class=\"font-id-number text-[9px] text-outline/60 overflow-hidden text-ellipsis w-32\">0x8f22e7...a4491c</p>\n</div>\n<!-- GLOWING QR CODE -->\n<div class=\"relative group\">\n<div class=\"absolute -inset-1 bg-outline rounded-sm blur opacity-20 group-hover:opacity-100 transition duration-1000\"></div>\n<div class=\"relative w-12 h-12 bg-white p-1 flex items-center justify-center border border-outline\">\n<div class=\"w-full h-full bg-black relative\">\n<div class=\"absolute inset-0 flex flex-wrap gap-px\">\n<!-- Mock QR squares -->\n<div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-outline\"></div>\n<div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-black\"></div>\n<div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-outline\"></div><div class=\"w-2 h-2 bg-black\"></div><div class=\"w-2 h-2 bg-outline\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- FOOTER DECORATION -->\n<div class=\"mt-auto flex justify-between items-end\">\n<div class=\"flex gap-1\">\n<div class=\"w-1 h-4 bg-outline\"></div>\n<div class=\"w-1 h-3 bg-outline/60\"></div>\n<div class=\"w-1 h-2 bg-outline/30\"></div>\n</div>\n<p class=\"font-id-number text-[8px] text-outline/40 italic\">GENUINE SYSTEM ASSET — UNAUTHORIZED DUPLICATION IS PUNISHABLE BY DE-RES</p>\n</div>\n</div>\n</main>\n<!-- BOTTOM NAV (Mobile) -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full z-50 bg-surface-container-highest border-t border-outline/20 flex justify-around p-2\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container/20 text-outline rounded-xl p-2 px-4 shadow-[inset_0_0_10px_rgba(0,255,0,0.2)]\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</a>\n</nav>\n</div>\n<!-- Background Decoration -->\n<div class=\"fixed inset-0 pointer-events-none z-[-1] opacity-20\">\n<div class=\"absolute top-1/4 left-1/4 w-96 h-96 bg-primary-container rounded-full blur-[120px]\"></div>\n<div class=\"absolute bottom-1/4 right-1/4 w-96 h-96 bg-error rounded-full blur-[120px]\"></div>\n</div>\n<script>\n        // Micro-interaction for the glitch border\n        const photoContainer = document.querySelector('.glitch-border');\n        photoContainer.addEventListener('mouseover', () => {\n            photoContainer.style.filter = 'hue-rotate(90deg) brightness(1.2)';\n            setTimeout(() => {\n                photoContainer.style.filter = 'none';\n            }, 150);\n        });\n\n        // Interactive scanning line speed change\n        const scanline = document.querySelector('.scanline');\n        setInterval(() => {\n            const randomSpeed = Math.random() * 3 + 1;\n            scanline.style.animationDuration = `${randomSpeed}s`;\n        }, 5000);\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 48;\n        }\n        .neon-pink-glow {\n            text-shadow: 0 0 5px #ff00ff, 0 0 10px #ff00ff;\n            box-shadow: 0 0 5px #ff00ff, inset 0 0 5px #ff00ff;\n        }\n        .neon-green-glow {\n            text-shadow: 0 0 5px #00ff00, 0 0 10px #00ff00;\n            box-shadow: 0 0 5px #00ff00, inset 0 0 5px #00ff00;\n        }\n        .glitch-border {\n            position: relative;\n            border: 2px solid #00ff00;\n        }\n        .glitch-border::before {\n            content: '';\n            position: absolute;\n            top: -4px;\n            left: -4px;\n            right: -4px;\n            bottom: -4px;\n            border: 1px solid #ff00ff;\n            animation: glitch-anim 2s infinite linear alternate-reverse;\n            opacity: 0.6;\n        }\n        @keyframes glitch-anim {\n            0% { clip-path: inset(80% 0 0 0); transform: translate(-2px, 2px); }\n            20% { clip-path: inset(20% 0 60% 0); transform: translate(2px, -2px); }\n            40% { clip-path: inset(40% 0 40% 0); transform: translate(-2px, -2px); }\n            60% { clip-path: inset(0 0 80% 0); transform: translate(2px, 2px); }\n            100% { clip-path: inset(10% 0 50% 0); transform: translate(0, 0); }\n        }\n        .scanline {\n            width: 100%;\n            height: 2px;\n            background: rgba(0, 255, 0, 0.3);\n            position: absolute;\n            top: 0;\n            left: 0;\n            z-index: 10;\n            animation: scan 4s linear infinite;\n        }\n        @keyframes scan {\n            from { top: 0; }\n            to { top: 100%; }\n        }\n        .cyber-grid {\n            background-image: \n                linear-gradient(to right, rgba(0, 255, 0, 0.05) 1px, transparent 1px),\n                linear-gradient(to bottom, rgba(0, 255, 0, 0.05) 1px, transparent 1px);\n            background-size: 20px 20px;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}