{
  "name": "Glassmorphism Dark ID",
  "html": "<div class=\"relative w-[340px] h-[520px] rounded-[24px] overflow-hidden shadow-2xl glass-card flex flex-col p-6\">\n<!-- Shimmer Effect -->\n<div class=\"absolute inset-0 shimmer pointer-events-none\"></div>\n<!-- Top Side / Header -->\n<div class=\"flex justify-between items-start mb-6\">\n<div class=\"flex flex-col\">\n<span class=\"text-primary-fixed font-id-name text-[14px] tracking-widest uppercase\">{Event}</span>\n<span class=\"text-on-primary-container font-id-name text-[18px] font-extrabold -mt-1\">2024</span>\n</div>\n<div class=\"w-10 h-10 rounded-lg flex items-center justify-center bg-primary-container/30 border border-white/10\">\n<span class=\"material-symbols-outlined text-primary-fixed\" data-icon=\"badge\">badge</span>\n</div>\n</div>\n<!-- Circular Photo -->\n<div class=\"flex justify-center mb-6 relative\">\n<div class=\"relative p-1 rounded-full border-2 border-dashed border-primary-fixed/30\">\n<div class=\"w-[140px] h-[140px] rounded-full overflow-hidden border-4 border-white/10 shadow-inner\">\n<img alt=\"Professional Profile\" class=\"w-full h-full object-cover\" data-alt=\"A cinematic close-up portrait of a professional male attendee for a high-tech corporate summit. He has a focused expression and is wearing a sleek charcoal suit. The background is a soft-focus office interior with cool blue and deep navy ambient lighting, fitting a dark-mode premium aesthetic. The overall mood is serious, sophisticated, and technologically forward.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute bottom-1 right-1 bg-secondary-container px-2 py-0.5 rounded-full border border-secondary-fixed/50 flex items-center gap-1 shadow-lg\">\n<div class=\"w-1.5 h-1.5 bg-on-secondary-fixed rounded-full animate-pulse\"></div>\n<span class=\"text-[8px] font-bold text-on-secondary-fixed uppercase tracking-tighter\">check_circle</span>\n</div>\n</div>\n</div>\n<!-- Identity Details -->\n<div class=\"flex flex-col items-center mb-6\">\n<h2 class=\"font-id-name text-id-name text-primary-fixed text-center\">{Name}</h2>\n<p class=\"font-id-role text-id-role text-on-primary-container opacity-80 uppercase tracking-widest\">{Pass Type}</p>\n</div>\n<!-- Data Fields Bento Grid (Small) -->\n<div class=\"grid grid-cols-2 gap-2 mb-6 flex-grow\">\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Access Level</span>\n<span class=\"font-id-role text-[12px] text-white\">Tier 01 Alpha</span>\n</div>\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Department</span>\n<span class=\"font-id-role text-[12px] text-white\">Neural Infra</span>\n</div>\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-white\">8804-X99</span>\n</div>\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Expires</span>\n<span class=\"font-id-number text-id-number text-white\">12.31.2024</span>\n</div>\n</div>\n<!-- Footer with QR and Secure Key -->\n<div class=\"mt-auto pt-4 border-t border-white/10 flex justify-between items-center\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Secure Key</span>\n<span class=\"font-id-number text-id-number text-secondary-fixed\">{Unique ID}</span>\n</div>\n<div class=\"p-1.5 bg-white rounded-lg shadow-inner\">\n<img alt=\"QR Code\" class=\"w-12 h-12 grayscale\" data-alt=\"A clean, high-contrast black and white QR code isolated on a square white background. The QR code contains digital security encryption data for an identification system. It is sharp and perfectly geometric, designed for reliable scanning in a professional security environment.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Digital Hologram Overlay -->\n<div class=\"absolute bottom-2 right-2 w-16 h-16 hologram rounded-full blur-xl opacity-40\"></div>\n</div>",
  "css": "\n        body {\n            background-color: #0d1117;\n            overflow-x: hidden;\n        }\n        .glass-card {\n            background: rgba(255, 255, 255, 0.03);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .glass-field {\n            background: rgba(255, 255, 255, 0.05);\n            border: 1px solid rgba(255, 255, 255, 0.08);\n        }\n        .shimmer {\n            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);\n            background-size: 200% 100%;\n            animation: shimmer 3s infinite;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .hologram {\n            background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), rgba(255, 0, 255, 0.1), rgba(255, 215, 0, 0.1));\n            mix-blend-mode: overlay;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "font-id-role",
  "tailwind_config": "{\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-container\": \"#0047ab\",\n                        \"on-surface-variant\": \"#434653\",\n                        \"surface-container\": \"#e6eeff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-fixed\": \"#dae2ff\",\n                        \"on-background\": \"#121c2a\",\n                        \"secondary\": \"#006c49\",\n                        \"primary\": \"#00327d\",\n                        \"surface\": \"#f8f9ff\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-dim\": \"#d0dbed\",\n                        \"background\": \"#f8f9ff\",\n                        \"on-secondary-fixed\": \"#002113\",\n                        \"on-primary-fixed\": \"#001946\",\n                        \"on-primary-fixed-variant\": \"#00419e\",\n                        \"surface-tint\": \"#2559bd\",\n                        \"inverse-surface\": \"#27313f\",\n                        \"on-secondary-container\": \"#00714d\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"surface-variant\": \"#d9e3f6\",\n                        \"outline-variant\": \"#c3c6d5\",\n                        \"inverse-primary\": \"#b1c5ff\",\n                        \"primary-fixed-dim\": \"#b1c5ff\",\n                        \"on-tertiary-fixed-variant\": \"#653e00\",\n                        \"surface-bright\": \"#f8f9ff\",\n                        \"on-tertiary-fixed\": \"#2a1700\",\n                        \"secondary-container\": \"#6cf8bb\",\n                        \"tertiary-container\": \"#6e4400\",\n                        \"tertiary\": \"#4f3000\",\n                        \"on-surface\": \"#121c2a\",\n                        \"on-error-container\": \"#93000a\",\n                        \"error\": \"#ba1a1a\",\n                        \"surface-container-highest\": \"#d9e3f6\",\n                        \"on-error\": \"#ffffff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#ffddb8\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"on-secondary-fixed-variant\": \"#005236\",\n                        \"secondary-fixed-dim\": \"#4edea3\",\n                        \"secondary-fixed\": \"#6ffbbe\",\n                        \"outline\": \"#737784\",\n                        \"tertiary-fixed-dim\": \"#ffb95f\",\n                        \"surface-container-high\": \"#dee9fc\",\n                        \"on-tertiary-container\": \"#ffae3c\",\n                        \"on-primary-container\": \"#a5bdff\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"element-gap\": \"0.75rem\",\n                        \"photo-size-lg\": \"120px\",\n                        \"card-padding\": \"1.5rem\",\n                        \"section-margin\": \"1rem\",\n                        \"photo-size-sm\": \"80px\"\n                    },\n                    \"fontFamily\": {\n                        \"id-name\": [\"Hanken Grotesk\"],\n                        \"id-role\": [\"Inter\"],\n                        \"body-sm\": [\"Inter\"],\n                        \"label-caps\": [\"Inter\"],\n                        \"id-number\": [\"JetBrains Mono\"]\n                    },\n                    \"fontSize\": {\n                        \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                        \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                        \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n                    }\n                },\n            },\n        }"
}