{
  "name": "Glassmorphism Dark ID",
  "html": "<!-- Background Decoration -->\n<div class=\"fixed inset-0 z-0 overflow-hidden pointer-events-none\">\n<div class=\"absolute -top-[10%] -left-[10%] w-[50%] h-[50%] bg-primary opacity-20 blur-[120px] rounded-full\"></div>\n<div class=\"absolute -bottom-[10%] -right-[10%] w-[50%] h-[50%] bg-secondary opacity-20 blur-[120px] rounded-full\"></div>\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80%] h-[80%] bg-on-primary-fixed-variant opacity-5 blur-[150px] rounded-full\"></div>\n</div>\n<!-- Main Container -->\n<div class=\"relative z-10 w-full max-w-4xl grid grid-cols-1 md:grid-cols-[350px_1fr] gap-8\">\n<!-- ID CARD COMPONENT (CR80 Portrait) -->\n<div class=\"flex justify-center\">\n<div class=\"relative w-[340px] h-[520px] rounded-[24px] overflow-hidden shadow-2xl glass-card flex flex-col p-6\">\n<!-- Shimmer Effect -->\n<div class=\"absolute inset-0 shimmer pointer-events-none\"></div>\n<!-- Top Side / Header -->\n<div class=\"flex justify-between items-start mb-6\">\n<div class=\"flex flex-col\">\n<span class=\"text-primary-fixed font-id-name text-[14px] tracking-widest uppercase\">{Event}</span>\n<span class=\"text-on-primary-container font-id-name text-[18px] font-extrabold -mt-1\">2024</span>\n</div>\n<div class=\"w-10 h-10 rounded-lg flex items-center justify-center bg-primary-container/30 border border-white/10\">\n<span class=\"material-symbols-outlined text-primary-fixed\" data-icon=\"badge\">badge</span>\n</div>\n</div>\n<!-- Circular Photo -->\n<div class=\"flex justify-center mb-6 relative\">\n<div class=\"relative p-1 rounded-full border-2 border-dashed border-primary-fixed/30\">\n<div class=\"w-[140px] h-[140px] rounded-full overflow-hidden border-4 border-white/10 shadow-inner\">\n<img alt=\"Professional Profile\" class=\"w-full h-full object-cover\" data-alt=\"A cinematic close-up portrait of a professional male attendee for a high-tech corporate summit. He has a focused expression and is wearing a sleek charcoal suit. The background is a soft-focus office interior with cool blue and deep navy ambient lighting, fitting a dark-mode premium aesthetic. The overall mood is serious, sophisticated, and technologically forward.\" src=\"{QR_CODE_URL}\"/>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute bottom-1 right-1 bg-secondary-container px-2 py-0.5 rounded-full border border-secondary-fixed/50 flex items-center gap-1 shadow-lg\">\n<div class=\"w-1.5 h-1.5 bg-on-secondary-fixed rounded-full animate-pulse\"></div>\n<span class=\"text-[8px] font-bold text-on-secondary-fixed uppercase tracking-tighter\">check_circle</span>\n</div>\n</div>\n</div>\n<!-- Identity Details -->\n<div class=\"flex flex-col items-center mb-6\">\n<h2 class=\"font-id-name text-id-name text-primary-fixed text-center\">{Name}</h2>\n<p class=\"font-id-role text-id-role text-on-primary-container opacity-80 uppercase tracking-widest\">{Pass Type}</p>\n</div>\n<!-- Data Fields Bento Grid (Small) -->\n<div class=\"grid grid-cols-2 gap-2 mb-6 flex-grow\">\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Access Level</span>\n<span class=\"font-id-role text-[12px] text-white\">Tier 01 Alpha</span>\n</div>\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Department</span>\n<span class=\"font-id-role text-[12px] text-white\">Neural Infra</span>\n</div>\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-white\">8804-X99</span>\n</div>\n<div class=\"glass-field rounded-xl p-2 flex flex-col justify-center\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Expires</span>\n<span class=\"font-id-number text-id-number text-white\">12.31.2024</span>\n</div>\n</div>\n<!-- Footer with QR and Secure Key -->\n<div class=\"mt-auto pt-4 border-t border-white/10 flex justify-between items-center\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Secure Key</span>\n<span class=\"font-id-number text-id-number text-secondary-fixed\">{Unique ID}</span>\n</div>\n<div class=\"p-1.5 bg-white rounded-lg shadow-inner\">\n<img alt=\"QR Code\" class=\"w-12 h-12 grayscale\" data-alt=\"A clean, high-contrast black and white QR code isolated on a square white background. The QR code contains digital security encryption data for an identification system. It is sharp and perfectly geometric, designed for reliable scanning in a professional security environment.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Digital Hologram Overlay -->\n<div class=\"absolute bottom-2 right-2 w-16 h-16 hologram rounded-full blur-xl opacity-40\"></div>\n</div>\n</div>\n<!-- DASHBOARD/MANAGEMENT INTERFACE -->\n<div class=\"flex flex-col space-y-6\">\n<!-- Top App Bar Mock -->\n<div class=\"glass-card rounded-2xl p-4 flex justify-between items-center px-6\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary-fixed text-2xl\" data-icon=\"shield_lock\">shield_lock</span>\n<h1 class=\"font-id-name text-id-name text-primary-fixed\">Registry Portal</h1>\n</div>\n<div class=\"flex items-center gap-4\">\n<button class=\"w-10 h-10 rounded-full glass-field flex items-center justify-center text-white/70 hover:text-white transition-colors\">\n<span class=\"material-symbols-outlined\" data-icon=\"notifications\">notifications</span>\n</button>\n<div class=\"w-10 h-10 rounded-full border border-white/20 overflow-hidden\">\n<img alt=\"Admin Profile\" data-alt=\"A high-quality studio portrait of a technology administrator with a friendly and professional appearance. The lighting is soft and even, highlighting a modern office setting in the distant background. The style is clean and high-fidelity, using a palette of soft grays and blues to maintain a premium digital feel.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n</div>\n<!-- Stats Grid -->\n<div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n<div class=\"glass-card rounded-2xl p-5 border-l-4 border-primary\">\n<span class=\"text-label-caps font-label-caps text-outline-variant uppercase\">Active IDs</span>\n<div class=\"text-2xl font-bold text-white mt-1\">1,284</div>\n<div class=\"text-[10px] text-secondary-fixed mt-2 flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[12px]\" data-icon=\"trending_up\">trending_up</span>\n                        +12% this week\n                    </div>\n</div>\n<div class=\"glass-card rounded-2xl p-5 border-l-4 border-secondary\">\n<span class=\"text-label-caps font-label-caps text-outline-variant uppercase\">Check-ins</span>\n<div class=\"text-2xl font-bold text-white mt-1\">892</div>\n<div class=\"text-[10px] text-outline-variant mt-2\">Real-time tracking</div>\n</div>\n<div class=\"glass-card rounded-2xl p-5 border-l-4 border-error\">\n<span class=\"text-label-caps font-label-caps text-outline-variant uppercase\">Alerts</span>\n<div class=\"text-2xl font-bold text-white mt-1\">3</div>\n<div class=\"text-[10px] text-error mt-2 flex items-center gap-1\">\n<span class=\"material-symbols-outlined text-[12px]\" data-icon=\"warning\">warning</span>\n                        Manual review needed\n                    </div>\n</div>\n</div>\n<!-- Main Content Area / Management Table -->\n<div class=\"glass-card rounded-2xl flex-grow overflow-hidden flex flex-col\">\n<div class=\"p-6 border-b border-white/10 flex justify-between items-center\">\n<h3 class=\"text-white font-id-role font-semibold\">Credential Requests</h3>\n<div class=\"flex gap-2\">\n<button class=\"bg-primary-container text-on-primary-container px-4 py-2 rounded-lg text-[12px] font-bold hover:brightness-110 transition-all flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-[18px]\" data-icon=\"add_circle\">add_circle</span>\n                            GENERATE NEW\n                        </button>\n</div>\n</div>\n<div class=\"p-4 overflow-x-auto\">\n<table class=\"w-full text-left\">\n<thead>\n<tr class=\"text-label-caps text-outline-variant uppercase border-b border-white/5\">\n<th class=\"pb-3 font-semibold px-2\">Member</th>\n<th class=\"pb-3 font-semibold\">Tier</th>\n<th class=\"pb-3 font-semibold\">Status</th>\n<th class=\"pb-3 font-semibold text-right px-2\">Action</th>\n</tr>\n</thead>\n<tbody class=\"text-[13px] text-white\">\n<tr class=\"border-b border-white/5 hover:bg-white/5 transition-colors group\">\n<td class=\"py-4 px-2\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full bg-surface-variant/20 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[18px] text-primary-fixed\" data-icon=\"person\">person</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-semibold\">Sarah Jenkins</span>\n<span class=\"text-[10px] text-outline-variant\">sarah.j@neural.io</span>\n</div>\n</div>\n</td>\n<td class=\"py-4\">Executive</td>\n<td class=\"py-4\">\n<span class=\"px-2 py-0.5 rounded bg-secondary/20 text-secondary-fixed text-[10px] font-bold\">ACTIVE</span>\n</td>\n<td class=\"py-4 text-right px-2\">\n<button class=\"text-outline-variant hover:text-white\"><span class=\"material-symbols-outlined\" data-icon=\"more_vert\">more_vert</span></button>\n</td>\n</tr>\n<tr class=\"border-b border-white/5 hover:bg-white/5 transition-colors group\">\n<td class=\"py-4 px-2\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full bg-surface-variant/20 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[18px] text-primary-fixed\" data-icon=\"person\">person</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-semibold\">Marcus Thorne</span>\n<span class=\"text-[10px] text-outline-variant\">m.thorne@security.net</span>\n</div>\n</div>\n</td>\n<td class=\"py-4\">Security</td>\n<td class=\"py-4\">\n<span class=\"px-2 py-0.5 rounded bg-primary-container/20 text-primary-fixed text-[10px] font-bold\">PENDING</span>\n</td>\n<td class=\"py-4 text-right px-2\">\n<button class=\"text-outline-variant hover:text-white\"><span class=\"material-symbols-outlined\" data-icon=\"more_vert\">more_vert</span></button>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n<!-- Micro-interaction Script -->\n<script>\n        document.addEventListener('mousemove', (e) => {\n            const cards = document.querySelectorAll('.glass-card');\n            const mouseX = e.clientX;\n            const mouseY = e.clientY;\n\n            cards.forEach(card => {\n                const rect = card.getBoundingClientRect();\n                const cardX = rect.left + rect.width / 2;\n                const cardY = rect.top + rect.height / 2;\n\n                const angleX = (mouseY - cardY) / 60;\n                const angleY = (cardX - mouseX) / 60;\n\n                // Subtle tilt effect for the ID card only for extra premium feel\n                if (card.parentElement.classList.contains('justify-center')) {\n                    card.style.transform = `perspective(1000px) rotateX(${angleX}deg) rotateY(${angleY}deg)`;\n                }\n            });\n        });\n\n        // Add a pulsing effect to the hologram\n        const hologram = document.querySelector('.hologram');\n        if(hologram) {\n            let opacity = 0.4;\n            let direction = 1;\n            setInterval(() => {\n                opacity += 0.01 * direction;\n                if (opacity >= 0.6 || opacity <= 0.2) direction *= -1;\n                hologram.style.opacity = opacity;\n            }, 50);\n        }\n    </script>",
  "css": "\n        body {\n            background-color: #0d1117;\n            overflow-x: hidden;\n        }\n        .glass-card {\n            background: rgba(255, 255, 255, 0.03);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n        }\n        .glass-field {\n            background: rgba(255, 255, 255, 0.05);\n            border: 1px solid rgba(255, 255, 255, 0.08);\n        }\n        .shimmer {\n            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);\n            background-size: 200% 100%;\n            animation: shimmer 3s infinite;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .hologram {\n            background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), rgba(255, 0, 255, 0.1), rgba(255, 215, 0, 0.1));\n            mix-blend-mode: overlay;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}