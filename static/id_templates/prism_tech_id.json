{
  "name": "Prism Tech ID",
  "html": "<!-- Top Navigation Bar (Shared Component) -->\n<header class=\"bg-surface dark:bg-on-surface text-primary dark:text-primary-fixed w-full top-0 sticky border-b border-outline-variant dark:border-outline flex justify-between items-center px-section-margin w-full h-16 z-50 fixed shadow-sm\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"badge\">badge</span>\n<span class=\"font-id-name text-id-name\">ID Registry</span>\n</div>\n<div class=\"flex items-center gap-4\">\n<span class=\"font-label-caps text-label-caps uppercase text-on-surface-variant\">Prism Dashboard</span>\n<div class=\"w-8 h-8 rounded-full bg-primary-container flex items-center justify-center overflow-hidden\">\n<img alt=\"Profile\" class=\"w-full h-full object-cover\" data-alt=\"A professional close-up portrait of a technology administrator in a bright, modern office setting. The person has a friendly expression, wearing minimalist spectacles and a crisp navy blazer. Soft daylight filters through large windows in the background, creating a clean, high-fidelity corporate aesthetic consistent with a blue and white brand palette.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n</header>\n<!-- Main Content Area -->\n<main class=\"mt-20 flex flex-col items-center gap-8 w-full max-w-4xl\">\n<!-- ID Card Section -->\n<div class=\"relative group\">\n<!-- Glow Effect -->\n<div class=\"absolute -inset-1 bg-gradient-to-r from-primary-container to-secondary-fixed-dim rounded-[2rem] blur opacity-25 group-hover:opacity-50 transition duration-1000\"></div>\n<!-- Card Body (CR80 Portrait) -->\n<div class=\"relative w-[340px] h-[540px] prism-mesh rounded-[1.5rem] shadow-2xl overflow-hidden flex flex-col border border-white/20 shimmer-overlay\">\n<!-- Card Header -->\n<div class=\"h-14 w-full flex items-center justify-center glass-panel border-b border-white/10 px-6\">\n<span class=\"font-id-name text-id-name text-white tracking-widest\">VIRTUAL ACCESS</span>\n</div>\n<!-- Main Layout Body -->\n<div class=\"flex-grow flex\">\n<!-- Left Sidebar (Vertical Badge) -->\n<div class=\"w-12 h-full bg-primary/20 backdrop-blur-md flex items-center justify-center border-r border-white/10\">\n<div class=\"vertical-text font-label-caps text-label-caps text-secondary-fixed-dim tracking-[0.3em] font-bold\">\n                            {Pass Type}\n                        </div>\n</div>\n<!-- Right Main Content -->\n<div class=\"flex-grow p-6 flex flex-col gap-6\">\n<!-- Photo Container -->\n<div class=\"relative mx-auto\">\n<div class=\"w-[140px] h-[140px] rounded-xl overflow-hidden border-2 border-secondary-fixed-dim/50 shadow-lg relative z-10\">\n<img alt=\"Subject\" class=\"w-full h-full object-cover\" data-alt=\"A futuristic portrait of a young man with sharp features and thoughtful eyes, set against a dark background with subtle blue rim lighting. The style is modern and high-tech, resembling a professional security badge photo. The lighting is crisp, emphasizing clean lines and a tech-forward atmosphere, perfectly aligned with a blue-to-teal color scheme.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Decorative accent -->\n<div class=\"absolute -bottom-2 -right-2 w-8 h-8 bg-secondary-fixed-dim rounded-lg flex items-center justify-center shadow-lg z-20\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n<!-- Data Fields Grid (6 Fields) -->\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Name</span>\n<span class=\"font-id-role text-id-role text-white truncate\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Handle</span>\n<span class=\"font-id-role text-id-role text-secondary-fixed\">{Email Address}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">UID</span>\n<span class=\"font-id-number text-id-number text-white/90\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Team</span>\n<span class=\"font-id-role text-id-role text-white\">{Event}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Level</span>\n<div class=\"flex gap-1 mt-1\">\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed\"></div>\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed\"></div>\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed/30\"></div>\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed/30\"></div>\n</div>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Status</span>\n<span class=\"font-id-role text-id-role text-secondary-container flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 bg-secondary-container rounded-full animate-pulse\"></span>\n                                    ACTIVE\n                                </span>\n</div>\n</div>\n<!-- QR Code & Security Hologram -->\n<div class=\"mt-auto flex items-end justify-between\">\n<div class=\"p-2 bg-white/10 rounded-lg border border-white/20 shadow-[0_0_15px_rgba(78,222,163,0.3)]\">\n<div class=\"w-16 h-16 bg-white p-1 rounded-md\">\n<!-- Using a representative QR image placeholder -->\n<img alt=\"QR Access\" class=\"w-full h-full\" data-alt=\"A high-contrast black and white QR code designed for digital scanning. The code is sharp and clean, centered within a small white frame. The surrounding environment suggests a high-security access control interface with glowing teal light accents and a sophisticated technological aesthetic.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Digital Security Hologram -->\n<div class=\"w-14 h-14 opacity-40 mix-blend-screen relative\">\n<div class=\"absolute inset-0 bg-gradient-to-tr from-cyan-400 via-magenta-400 to-yellow-400 animate-spin\" style=\"animation-duration: 8s; clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);\"></div>\n<div class=\"absolute inset-1 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px] text-white\">fingerprint</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Footer Bar -->\n<div class=\"h-1 w-full bg-secondary-fixed shadow-[0_-4px_10px_rgba(78,222,163,0.5)]\"></div>\n</div>\n</div>\n<!-- Action Section (Bento Style) -->\n<div class=\"w-full grid grid-cols-1 md:grid-cols-3 gap-4 pb-24\">\n<div class=\"p-6 rounded-2xl bg-white shadow-sm border border-outline-variant flex flex-col gap-3\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"share\">share</span>\n<h3 class=\"font-id-name text-id-name text-on-surface\">Digital Export</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Generate a secure Apple/Google Wallet pass for mobile access.</p>\n<button class=\"mt-auto px-4 py-2 bg-primary-container text-white rounded-lg font-id-role text-id-role hover:bg-primary transition-colors\">Export Pass</button>\n</div>\n<div class=\"p-6 rounded-2xl bg-primary-container text-white shadow-sm flex flex-col gap-3 overflow-hidden relative\">\n<div class=\"absolute top-0 right-0 p-4 opacity-20 transform translate-x-4 -translate-y-4\">\n<span class=\"material-symbols-outlined text-6xl\" data-icon=\"print\">print</span>\n</div>\n<h3 class=\"font-id-name text-id-name\">PVC Printing</h3>\n<p class=\"font-body-sm text-body-sm opacity-90\">Queue high-definition print for physical CR80 card shipping.</p>\n<button class=\"mt-auto px-4 py-2 bg-secondary-fixed text-on-secondary-fixed rounded-lg font-id-role text-id-role hover:bg-secondary-fixed-dim transition-colors\">Order Physical</button>\n</div>\n<div class=\"p-6 rounded-2xl bg-surface-container-high shadow-sm border border-outline-variant flex flex-col gap-3\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"history\">history</span>\n<h3 class=\"font-id-name text-id-name text-on-surface\">Access Log</h3>\n<p class=\"font-body-sm text-body-sm text-on-surface-variant\">Last check_circle at Central Node: 14:32 UTC Today.</p>\n<button class=\"mt-auto px-4 py-2 border border-outline text-primary rounded-lg font-id-role text-id-role hover:bg-white transition-colors\">View Logs</button>\n</div>\n</div>\n</main>\n<!-- Bottom Navigation Bar (Shared Component) -->\n<nav class=\"fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant shadow-lg z-50 md:hidden\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-colors\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\" style=\"font-variation-settings: 'FILL' 1;\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n<!-- Micro-interactions Script -->\n<script>\n        document.addEventListener('mousemove', (e) => {\n            const card = document.querySelector('.prism-mesh');\n            if (!card) return;\n            \n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            \n            const rotateX = (y - centerY) / 25;\n            const rotateY = (centerX - x) / 25;\n            \n            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n\n        document.querySelector('.prism-mesh')?.addEventListener('mouseleave', () => {\n            const card = document.querySelector('.prism-mesh');\n            if (card) card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n        });\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .prism-mesh {\n            background-color: #0047ab;\n            background-image: \n                radial-gradient(at 0% 0%, #00f2fe 0px, transparent 50%),\n                radial-gradient(at 100% 0%, #0047ab 0px, transparent 50%),\n                radial-gradient(at 100% 100%, #4edea3 0px, transparent 50%),\n                radial-gradient(at 0% 100%, #00327d 0px, transparent 50%);\n        }\n        .glass-panel {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n        @keyframes shimmer {\n            0% { transform: translateX(-100%) rotate(45deg); }\n            100% { transform: translateX(100%) rotate(45deg); }\n        }\n        .shimmer-overlay::after {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 200%;\n            height: 200%;\n            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);\n            animation: shimmer 4s infinite linear;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}