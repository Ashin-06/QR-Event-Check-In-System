{
  "name": "Prism Tech ID",
  "html": "<div class=\"relative w-[340px] h-[540px] prism-mesh rounded-[1.5rem] shadow-2xl overflow-hidden flex flex-col border border-white/20 shimmer-overlay\">\n<!-- Card Header -->\n<div class=\"h-14 w-full flex items-center justify-center glass-panel border-b border-white/10 px-6\">\n<span class=\"font-id-name text-id-name text-white tracking-widest\">VIRTUAL ACCESS</span>\n</div>\n<!-- Main Layout Body -->\n<div class=\"flex-grow flex\">\n<!-- Left Sidebar (Vertical Badge) -->\n<div class=\"w-12 h-full bg-primary/20 backdrop-blur-md flex items-center justify-center border-r border-white/10\">\n<div class=\"vertical-text font-label-caps text-label-caps text-secondary-fixed-dim tracking-[0.3em] font-bold\">\n                            {Pass Type}\n                        </div>\n</div>\n<!-- Right Main Content -->\n<div class=\"flex-grow p-6 flex flex-col gap-6\">\n<!-- Photo Container -->\n<div class=\"relative mx-auto\">\n<div class=\"w-[140px] h-[140px] rounded-xl overflow-hidden border-2 border-secondary-fixed-dim/50 shadow-lg relative z-10\">\n<img alt=\"Subject\" class=\"w-full h-full object-cover\" data-alt=\"A futuristic portrait of a young man with sharp features and thoughtful eyes, set against a dark background with subtle blue rim lighting. The style is modern and high-tech, resembling a professional security badge photo. The lighting is crisp, emphasizing clean lines and a tech-forward atmosphere, perfectly aligned with a blue-to-teal color scheme.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Decorative accent -->\n<div class=\"absolute -bottom-2 -right-2 w-8 h-8 bg-secondary-fixed-dim rounded-lg flex items-center justify-center shadow-lg z-20\">\n<span class=\"material-symbols-outlined text-primary text-[16px]\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n<!-- Data Fields Grid (6 Fields) -->\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Name</span>\n<span class=\"font-id-role text-id-role text-white truncate\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Handle</span>\n<span class=\"font-id-role text-id-role text-secondary-fixed\">{Email Address}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">UID</span>\n<span class=\"font-id-number text-id-number text-white/90\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Team</span>\n<span class=\"font-id-role text-id-role text-white\">{Event}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Level</span>\n<div class=\"flex gap-1 mt-1\">\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed\"></div>\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed\"></div>\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed/30\"></div>\n<div class=\"w-3 h-3 rounded-full bg-secondary-fixed/30\"></div>\n</div>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Status</span>\n<span class=\"font-id-role text-id-role text-secondary-container flex items-center gap-1\">\n<span class=\"w-1.5 h-1.5 bg-secondary-container rounded-full animate-pulse\"></span>\n                                    ACTIVE\n                                </span>\n</div>\n</div>\n<!-- QR Code & Security Hologram -->\n<div class=\"mt-auto flex items-end justify-between\">\n<div class=\"p-2 bg-white/10 rounded-lg border border-white/20 shadow-[0_0_15px_rgba(78,222,163,0.3)]\">\n<div class=\"w-16 h-16 bg-white p-1 rounded-md\">\n<!-- Using a representative QR image placeholder -->\n<img alt=\"QR Access\" class=\"w-full h-full\" data-alt=\"A high-contrast black and white QR code designed for digital scanning. The code is sharp and clean, centered within a small white frame. The surrounding environment suggests a high-security access control interface with glowing teal light accents and a sophisticated technological aesthetic.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Digital Security Hologram -->\n<div class=\"w-14 h-14 opacity-40 mix-blend-screen relative\">\n<div class=\"absolute inset-0 bg-gradient-to-tr from-cyan-400 via-magenta-400 to-yellow-400 animate-spin\" style=\"animation-duration: 8s; clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);\"></div>\n<div class=\"absolute inset-1 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[20px] text-white\">fingerprint</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Footer Bar -->\n<div class=\"h-1 w-full bg-secondary-fixed shadow-[0_-4px_10px_rgba(78,222,163,0.5)]\"></div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .prism-mesh {\n            background-color: #0047ab;\n            background-image: \n                radial-gradient(at 0% 0%, #00f2fe 0px, transparent 50%),\n                radial-gradient(at 100% 0%, #0047ab 0px, transparent 50%),\n                radial-gradient(at 100% 100%, #4edea3 0px, transparent 50%),\n                radial-gradient(at 0% 100%, #00327d 0px, transparent 50%);\n        }\n        .glass-panel {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n        @keyframes shimmer {\n            0% { transform: translateX(-100%) rotate(45deg); }\n            100% { transform: translateX(100%) rotate(45deg); }\n        }\n        .shimmer-overlay::after {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 200%;\n            height: 200%;\n            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);\n            animation: shimmer 4s infinite linear;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface-dim",
  "tailwind_config": "{\n          darkMode: \"class\",\n          theme: {\n            extend: {\n              \"colors\": {\n                      \"primary-container\": \"#0047ab\",\n                      \"on-surface-variant\": \"#434653\",\n                      \"surface-container\": \"#e6eeff\",\n                      \"surface-container-low\": \"#eff4ff\",\n                      \"primary-fixed\": \"#dae2ff\",\n                      \"on-background\": \"#121c2a\",\n                      \"secondary\": \"#006c49\",\n                      \"primary\": \"#00327d\",\n                      \"surface\": \"#f8f9ff\",\n                      \"error-container\": \"#ffdad6\",\n                      \"surface-dim\": \"#d0dbed\",\n                      \"background\": \"#f8f9ff\",\n                      \"on-secondary-fixed\": \"#002113\",\n                      \"on-primary-fixed\": \"#001946\",\n                      \"on-primary-fixed-variant\": \"#00419e\",\n                      \"surface-tint\": \"#2559bd\",\n                      \"inverse-surface\": \"#27313f\",\n                      \"on-secondary-container\": \"#00714d\",\n                      \"surface-container-lowest\": \"#ffffff\",\n                      \"on-secondary\": \"#ffffff\",\n                      \"on-primary\": \"#ffffff\",\n                      \"surface-variant\": \"#d9e3f6\",\n                      \"outline-variant\": \"#c3c6d5\",\n                      \"inverse-primary\": \"#b1c5ff\",\n                      \"primary-fixed-dim\": \"#b1c5ff\",\n                      \"on-tertiary-fixed-variant\": \"#653e00\",\n                      \"surface-bright\": \"#f8f9ff\",\n                      \"on-tertiary-fixed\": \"#2a1700\",\n                      \"secondary-container\": \"#6cf8bb\",\n                      \"tertiary-container\": \"#6e4400\",\n                      \"tertiary\": \"#4f3000\",\n                      \"on-surface\": \"#121c2a\",\n                      \"on-error-container\": \"#93000a\",\n                      \"error\": \"#ba1a1a\",\n                      \"surface-container-highest\": \"#d9e3f6\",\n                      \"on-error\": \"#ffffff\",\n                      \"on-tertiary\": \"#ffffff\",\n                      \"tertiary-fixed\": \"#ffddb8\",\n                      \"inverse-on-surface\": \"#eaf1ff\",\n                      \"on-secondary-fixed-variant\": \"#005236\",\n                      \"secondary-fixed-dim\": \"#4edea3\",\n                      \"secondary-fixed\": \"#6ffbbe\",\n                      \"outline\": \"#737784\",\n                      \"tertiary-fixed-dim\": \"#ffb95f\",\n                      \"surface-container-high\": \"#dee9fc\",\n                      \"on-tertiary-container\": \"#ffae3c\",\n                      \"on-primary-container\": \"#a5bdff\"\n              },\n              \"borderRadius\": {\n                      \"DEFAULT\": \"0.25rem\",\n                      \"lg\": \"0.5rem\",\n                      \"xl\": \"0.75rem\",\n                      \"full\": \"9999px\"\n              },\n              \"spacing\": {\n                      \"element-gap\": \"0.75rem\",\n                      \"photo-size-lg\": \"120px\",\n                      \"card-padding\": \"1.5rem\",\n                      \"section-margin\": \"1rem\",\n                      \"photo-size-sm\": \"80px\"\n              },\n              \"fontFamily\": {\n                      \"id-name\": [\"Hanken Grotesk\"],\n                      \"id-role\": [\"Inter\"],\n                      \"body-sm\": [\"Inter\"],\n                      \"label-caps\": [\"Inter\"],\n                      \"id-number\": [\"JetBrains Mono\"]\n              },\n              \"fontSize\": {\n                      \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                      \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                      \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                      \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                      \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n              }\n            },\n          },\n        }"
}