{
  "name": "Classic Royal ID",
  "html": "<!-- Top Navigation (Contextual Filter Applied: Not Transactional) -->\n<header class=\"bg-surface dark:bg-on-surface text-primary dark:text-primary-fixed border-b border-outline-variant dark:border-outline font-id-name text-id-name w-full top-0 sticky flex justify-between items-center px-4 py-3 z-50\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined\">badge</span>\n<span class=\"font-id-name text-id-name text-primary dark:text-primary-fixed\">ID Registry</span>\n</div>\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-on-surface-variant hover:bg-surface-container transition-colors duration-200 p-2 rounded-full cursor-pointer\">search</span>\n<img alt=\"User Profile\" class=\"w-8 h-8 rounded-full border border-outline-variant\" src=\"{PHOTO_URL}\"/>\n</div>\n</header>\n<main class=\"flex-grow flex items-center justify-center p-section-margin pb-24 md:pb-8\">\n<!-- ID Card Canvas -->\n<div class=\"relative w-[340px] h-[540px] classic-royal-gradient rounded-[20px] shadow-2xl overflow-hidden border-[6px] border-royal-gold/20 flex flex-col items-center p-6 text-white\">\n<!-- Security Hologram Overlay -->\n<div class=\"absolute inset-0 hologram-shimmer opacity-10 pointer-events-none\"></div>\n<!-- Header Section -->\n<div class=\"w-full text-center mb-6 pt-4\">\n<div class=\"text-[12px] tracking-[0.3em] font-bold gold-shimmer uppercase mb-1\">{Pass Type}</div>\n<div class=\"h-[1px] w-full bg-gradient-to-r from-transparent via-royal-gold to-transparent\"></div>\n</div>\n<!-- Photo Area -->\n<div class=\"relative mb-8\">\n<div class=\"w-32 h-44 oval-crop gold-border overflow-hidden bg-black/20\">\n<img alt=\"Delegate Portrait\" class=\"w-full h-full object-cover grayscale brightness-110\" data-alt=\"A dignified portrait of a middle-aged male diplomat with graying hair and a composed expression, wearing a dark formal suit and a silk tie. The lighting is sophisticated, using a Rembrandt setup that highlights bone structure against a deep, shadowed background. The overall aesthetic is classical and high-contrast, echoing themes of institutional trust and minimalist luxury. The image feels like a high-end black and white studio photograph.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 bg-royal-gold text-royal-burgundy px-3 py-0.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-md border border-white/20\">\n                    check_circle\n                </div>\n</div>\n<!-- Data Fields Area -->\n<div class=\"w-full space-y-4 mb-8\">\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Full Name</span>\n<span class=\"serif-header text-lg gold-shimmer\">{Name}</span>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Delegation</span>\n<span class=\"font-id-role text-[13px] text-white\">{Unique ID}</span>\n</div>\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Security Level</span>\n<span class=\"font-id-role text-[13px] text-white\">Level IV - Alpha</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Issue Date</span>\n<span class=\"font-id-number text-[12px] text-white/90\">OCT 2023</span>\n</div>\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Credential ID</span>\n<span class=\"font-id-number text-[12px] text-white/90\">{Registration Number}</span>\n</div>\n</div>\n</div>\n<!-- Footer Section -->\n<div class=\"mt-auto w-full flex items-end justify-between\">\n<div class=\"text-left\">\n<div class=\"data-label text-[9px] text-royal-gold/60 uppercase\">Event Location</div>\n<div class=\"font-id-role text-[12px] text-white/80\">St. James Palace, London</div>\n</div>\n<!-- QR Code Container -->\n<div class=\"w-16 h-16 bg-white p-1 rounded-sm gold-border\">\n<img alt=\"Verification QR\" class=\"w-full h-full opacity-90 contrast-125\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Security Threading -->\n<div class=\"absolute bottom-4 left-0 w-full h-[2px] bg-royal-gold/10 overflow-hidden\">\n<div class=\"w-1/2 h-full bg-royal-gold/40 animate-[shimmer_2s_infinite]\"></div>\n</div>\n</div>\n</main>\n<!-- Bottom Navigation (Mobile Only) -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant flex justify-around p-2 z-50\">\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n<!-- Side Navigation Drawer (Desktop Context) -->\n<aside class=\"hidden lg:flex fixed left-0 top-0 h-full w-80 bg-surface-container-low shadow-md z-40 flex-col py-6\">\n<div class=\"px-6 mb-10 flex items-center gap-4\">\n<img alt=\"Admin Avatar\" class=\"w-12 h-12 rounded-full\" src=\"{PHOTO_URL}\"/>\n<div>\n<h3 class=\"font-id-role text-id-role text-primary\">System Admin</h3>\n<p class=\"text-on-surface-variant text-[11px] uppercase tracking-wider\">Bulk Management</p>\n</div>\n</div>\n<nav class=\"flex-grow px-4 space-y-2\">\n<a class=\"flex items-center gap-4 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-full scale-95 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">app_registration</span>\n<span class=\"font-id-role text-id-role\">Registration</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">style</span>\n<span class=\"font-id-role text-id-role\">Templates</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">analytics</span>\n<span class=\"font-id-role text-id-role\">Analytics</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">settings</span>\n<span class=\"font-id-role text-id-role\">Settings</span>\n</a>\n<a class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all\" href=\"#\">\n<span class=\"material-symbols-outlined\">help</span>\n<span class=\"font-id-role text-id-role\">Help</span>\n</a>\n</nav>\n<div class=\"px-8 py-4 border-t border-outline-variant\">\n<div class=\"text-[10px] text-outline uppercase tracking-widest\">Version 2.4.0-Royal</div>\n</div>\n</aside>\n<script>\n        // Simple interactive shimmer effect on mouse move\n        const card = document.querySelector('.classic-royal-gradient');\n        card.addEventListener('mousemove', (e) => {\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const shimmer = card.querySelector('.hologram-shimmer');\n            shimmer.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0) 70%)`;\n        });\n        \n        card.addEventListener('mouseleave', () => {\n            const shimmer = card.querySelector('.hologram-shimmer');\n            shimmer.style.background = `linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 100%)`;\n        });\n    </script>",
  "css": "\n        .classic-royal-gradient {\n            background: linear-gradient(135deg, #4a0404 0%, #2d0202 100%);\n        }\n        .gold-shimmer {\n            background: linear-gradient(45deg, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n        .gold-border {\n            border: 2px solid transparent;\n            background: linear-gradient(#2d0202, #2d0202) padding-box,\n                        linear-gradient(45deg, #bf953f, #fcf6ba, #aa771c) border-box;\n        }\n        .oval-crop {\n            clip-path: ellipse(45% 50% at 50% 50%);\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 100%);\n            background-size: 200% 200%;\n            animation: shimmer 4s infinite linear;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .serif-header {\n            font-family: 'Playfair Display', serif;\n        }\n        .data-label {\n            font-family: 'Libre Baskerville', serif;\n            font-variant: small-caps;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}