{
  "name": "Classic Royal ID",
  "html": "<div class=\"relative w-[340px] h-[540px] classic-royal-gradient rounded-[20px] shadow-2xl overflow-hidden border-[6px] border-royal-gold/20 flex flex-col items-center p-6 text-white\">\n<!-- Security Hologram Overlay -->\n<div class=\"absolute inset-0 hologram-shimmer opacity-10 pointer-events-none\"></div>\n<!-- Header Section -->\n<div class=\"w-full text-center mb-6 pt-4\">\n<div class=\"text-[12px] tracking-[0.3em] font-bold gold-shimmer uppercase mb-1\">{Pass Type}</div>\n<div class=\"h-[1px] w-full bg-gradient-to-r from-transparent via-royal-gold to-transparent\"></div>\n</div>\n<!-- Photo Area -->\n<div class=\"relative mb-8\">\n<div class=\"w-32 h-44 oval-crop gold-border overflow-hidden bg-black/20\">\n<img alt=\"Delegate Portrait\" class=\"w-full h-full object-cover grayscale brightness-110\" data-alt=\"A dignified portrait of a middle-aged male diplomat with graying hair and a composed expression, wearing a dark formal suit and a silk tie. The lighting is sophisticated, using a Rembrandt setup that highlights bone structure against a deep, shadowed background. The overall aesthetic is classical and high-contrast, echoing themes of institutional trust and minimalist luxury. The image feels like a high-end black and white studio photograph.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 bg-royal-gold text-royal-burgundy px-3 py-0.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-md border border-white/20\">\n                    check_circle\n                </div>\n</div>\n<!-- Data Fields Area -->\n<div class=\"w-full space-y-4 mb-8\">\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Full Name</span>\n<span class=\"serif-header text-lg gold-shimmer\">{Name}</span>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Delegation</span>\n<span class=\"font-id-role text-[13px] text-white\">{Unique ID}</span>\n</div>\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Security Level</span>\n<span class=\"font-id-role text-[13px] text-white\">Level IV - Alpha</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Issue Date</span>\n<span class=\"font-id-number text-[12px] text-white/90\">OCT 2023</span>\n</div>\n<div class=\"border-b border-royal-gold/30 pb-1\">\n<span class=\"data-label text-[10px] text-royal-gold/80 block uppercase tracking-tighter\">Credential ID</span>\n<span class=\"font-id-number text-[12px] text-white/90\">{Registration Number}</span>\n</div>\n</div>\n</div>\n<!-- Footer Section -->\n<div class=\"mt-auto w-full flex items-end justify-between\">\n<div class=\"text-left\">\n<div class=\"data-label text-[9px] text-royal-gold/60 uppercase\">Event Location</div>\n<div class=\"font-id-role text-[12px] text-white/80\">St. James Palace, London</div>\n</div>\n<!-- QR Code Container -->\n<div class=\"w-16 h-16 bg-white p-1 rounded-sm gold-border\">\n<img alt=\"Verification QR\" class=\"w-full h-full opacity-90 contrast-125\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Security Threading -->\n<div class=\"absolute bottom-4 left-0 w-full h-[2px] bg-royal-gold/10 overflow-hidden\">\n<div class=\"w-1/2 h-full bg-royal-gold/40 animate-[shimmer_2s_infinite]\"></div>\n</div>\n</div>",
  "css": "\n        .classic-royal-gradient {\n            background: linear-gradient(135deg, #4a0404 0%, #2d0202 100%);\n        }\n        .gold-shimmer {\n            background: linear-gradient(45deg, #bf953f, #fcf6ba, #b38728, #fbf5b7, #aa771c);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n        .gold-border {\n            border: 2px solid transparent;\n            background: linear-gradient(#2d0202, #2d0202) padding-box,\n                        linear-gradient(45deg, #bf953f, #fcf6ba, #aa771c) border-box;\n        }\n        .oval-crop {\n            clip-path: ellipse(45% 50% at 50% 50%);\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.2) 50%, rgba(255,255,255,0) 100%);\n            background-size: 200% 200%;\n            animation: shimmer 4s infinite linear;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .serif-header {\n            font-family: 'Playfair Display', serif;\n        }\n        .data-label {\n            font-family: 'Libre Baskerville', serif;\n            font-variant: small-caps;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface-container font-body-sm text-on-surface",
  "tailwind_config": "{\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-container\": \"#0047ab\",\n                        \"on-surface-variant\": \"#434653\",\n                        \"surface-container\": \"#e6eeff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-fixed\": \"#dae2ff\",\n                        \"on-background\": \"#121c2a\",\n                        \"secondary\": \"#006c49\",\n                        \"primary\": \"#00327d\",\n                        \"surface\": \"#f8f9ff\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-dim\": \"#d0dbed\",\n                        \"background\": \"#f8f9ff\",\n                        \"on-secondary-fixed\": \"#002113\",\n                        \"on-primary-fixed\": \"#001946\",\n                        \"on-primary-fixed-variant\": \"#00419e\",\n                        \"surface-tint\": \"#2559bd\",\n                        \"inverse-surface\": \"#27313f\",\n                        \"on-secondary-container\": \"#00714d\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"surface-variant\": \"#d9e3f6\",\n                        \"outline-variant\": \"#c3c6d5\",\n                        \"inverse-primary\": \"#b1c5ff\",\n                        \"primary-fixed-dim\": \"#b1c5ff\",\n                        \"on-tertiary-fixed-variant\": \"#653e00\",\n                        \"surface-bright\": \"#f8f9ff\",\n                        \"on-tertiary-fixed\": \"#2a1700\",\n                        \"secondary-container\": \"#6cf8bb\",\n                        \"tertiary-container\": \"#6e4400\",\n                        \"tertiary\": \"#4f3000\",\n                        \"on-surface\": \"#121c2a\",\n                        \"on-error-container\": \"#93000a\",\n                        \"error\": \"#ba1a1a\",\n                        \"surface-container-highest\": \"#d9e3f6\",\n                        \"on-error\": \"#ffffff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#ffddb8\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"on-secondary-fixed-variant\": \"#005236\",\n                        \"secondary-fixed-dim\": \"#4edea3\",\n                        \"secondary-fixed\": \"#6ffbbe\",\n                        \"outline\": \"#737784\",\n                        \"tertiary-fixed-dim\": \"#ffb95f\",\n                        \"surface-container-high\": \"#dee9fc\",\n                        \"on-tertiary-container\": \"#ffae3c\",\n                        \"on-primary-container\": \"#a5bdff\",\n                        \"royal-burgundy\": \"#4a0404\",\n                        \"royal-gold\": \"#bf953f\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"element-gap\": \"0.75rem\",\n                        \"photo-size-lg\": \"120px\",\n                        \"card-padding\": \"1.5rem\",\n                        \"section-margin\": \"1rem\",\n                        \"photo-size-sm\": \"80px\"\n                    },\n                    \"fontFamily\": {\n                        \"id-name\": [\"Hanken Grotesk\"],\n                        \"id-role\": [\"Inter\"],\n                        \"body-sm\": [\"Inter\"],\n                        \"label-caps\": [\"Inter\"],\n                        \"id-number\": [\"JetBrains Mono\"]\n                    },\n                    \"fontSize\": {\n                        \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                        \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                        \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n                    }\n                }\n            }\n        }"
}