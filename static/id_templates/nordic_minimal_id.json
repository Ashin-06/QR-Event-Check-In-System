{
  "name": "Nordic Minimal ID",
  "html": "<!-- Main Canvas -->\n<div class=\"flex flex-col items-center gap-8 py-12\">\n<!-- Header from Shared Components -->\n<header class=\"bg-surface dark:bg-on-surface text-primary dark:text-primary-fixed font-id-name text-id-name w-full top-0 sticky border-b border-outline-variant dark:border-outline flex justify-between items-center px-4 py-3 z-50\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"badge\">badge</span>\n<span class=\"font-id-name text-id-name\">ID Registry</span>\n</div>\n<div class=\"w-8 h-8 rounded-full bg-surface-container-high overflow-hidden border border-outline-variant\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" data-alt=\"A close-up portrait of a professional system administrator in a high-tech corporate office. The lighting is soft and natural, emphasizing a clean and approachable demeanor. The background is a blurred office setting with cool blue and white tones, matching a Nordic minimalist design aesthetic. The image is crisp, high-resolution, and projects reliability.\" src=\"{PHOTO_URL}\"/>\n</div>\n</header>\n<!-- The ID Card Canvas -->\n<div class=\"card-container\">\n<div class=\"mesh-bg\"></div>\n<div class=\"content-layer\">\n<!-- Top Status -->\n<div class=\"flex justify-between items-center mb-8\">\n<span class=\"font-id-role text-[10px] tracking-[0.2em] text-primary uppercase opacity-60\">ACCESS GRANTED</span>\n<span class=\"material-symbols-outlined text-primary opacity-40 text-lg\" data-icon=\"sensor_occupied\">sensor_occupied</span>\n</div>\n<!-- Main Grid Layout -->\n<div class=\"flex flex-col flex-grow\">\n<!-- Photo -->\n<div class=\"mb-8\">\n<div class=\"w-[90px] h-[90px] rounded-lg overflow-hidden border border-surface-variant bg-surface-container-low shadow-sm\">\n<img alt=\"Employee ID Photo\" class=\"w-full h-full object-cover\" data-alt=\"A centered portrait of a tech professional with a neutral expression, set against a solid off-white background. The lighting is flat and professional, suitable for a high-security identification card. The person is wearing a simple gray crew neck sweater, aligning with a Nordic minimalist style. The overall tone is clean, bright, and highly legible.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Left Aligned Fields (7 Fields) -->\n<div class=\"grid grid-cols-1 gap-y-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Full Name</span>\n<span class=\"font-id-name text-[18px] text-on-surface\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Role</span>\n<span class=\"font-id-role text-id-role text-primary\">{Pass Type}</span>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Employee ID</span>\n<span class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Department</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Unique ID}</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Issue Date</span>\n<span class=\"font-id-number text-id-number text-on-surface\">02.14.2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Expiry</span>\n<span class=\"font-id-number text-id-number text-on-surface\">02.14.2029</span>\n</div>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Clearance</span>\n<div class=\"flex items-center gap-1.5 mt-1\">\n<span class=\"w-2 h-2 rounded-full bg-secondary\"></span>\n<span class=\"font-id-role text-id-role text-on-surface\">Level 4 (Secure)</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Footer and QR -->\n<div class=\"flex justify-between items-end mt-auto pt-4 border-t border-surface-variant\">\n<div class=\"flex flex-col\">\n<span class=\"font-id-role text-[9px] tracking-wider text-on-surface-variant opacity-50 uppercase\">INTERNAL USE ONLY</span>\n<span class=\"font-id-role text-[8px] text-on-surface-variant opacity-40 mt-1\">Found? Return to: HQ Oslo, Nordic Hub</span>\n</div>\n<div class=\"p-1.5 bg-white border border-surface-variant rounded-md shadow-sm\">\n<div class=\"w-14 h-14 bg-on-surface flex items-center justify-center rounded-[2px]\">\n<span class=\"material-symbols-outlined text-white text-4xl\" data-icon=\"qr_code_2\">qr_code_2</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Navigation Drawer (Desktop Version - Simulating Shell) -->\n<nav class=\"hidden md:flex flex-col bg-surface-container-low dark:bg-on-surface h-[600px] w-80 rounded-xl shadow-md fixed right-10 top-24 z-40 overflow-hidden\">\n<div class=\"p-6 flex flex-col items-start bg-surface-container-low\">\n<div class=\"w-12 h-12 rounded-full bg-surface-container-high mb-3 border-2 border-primary overflow-hidden\">\n<img alt=\"Admin Avatar\" class=\"w-full h-full object-cover\" data-alt=\"A minimalist, professional avatar of a system administrator. The style is clean, modern, and fits into a Nordic design aesthetic with soft grays and blues. The person looks confident and approachable, reflecting institutional trust and reliability.\" src=\"{PHOTO_URL}\"/>\n</div>\n<h3 class=\"font-id-name text-id-name text-primary\">System Admin</h3>\n<p class=\"font-id-role text-id-role text-on-surface-variant\">Bulk Management</p>\n</div>\n<div class=\"flex flex-col p-4 gap-2\">\n<button class=\"flex items-center gap-4 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-full transition-transform active:scale-95 duration-150\">\n<span class=\"material-symbols-outlined\" data-icon=\"app_registration\">app_registration</span>\n<span class=\"font-id-role text-id-role\">Registration</span>\n</button>\n<button class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all duration-150\">\n<span class=\"material-symbols-outlined\" data-icon=\"style\">style</span>\n<span class=\"font-id-role text-id-role\">Templates</span>\n</button>\n<button class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all duration-150\">\n<span class=\"material-symbols-outlined\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-id-role text-id-role\">Analytics</span>\n</button>\n<button class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all duration-150\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n<span class=\"font-id-role text-id-role\">Settings</span>\n</button>\n<button class=\"flex items-center gap-4 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all duration-150\">\n<span class=\"material-symbols-outlined\" data-icon=\"help\">help</span>\n<span class=\"font-id-role text-id-role\">Help</span>\n</button>\n</div>\n</nav>\n<!-- Bottom Navigation for Mobile -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full bg-surface-container-highest dark:bg-on-surface flex justify-around p-2 border-t border-outline-variant shadow-lg z-50\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\" style=\"font-variation-settings: 'FILL' 1;\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n</div>\n<script>\n        // Micro-interaction for the card\n        const card = document.querySelector('.card-container');\n        card.addEventListener('mousemove', (e) => {\n            const { left, top, width, height } = card.getBoundingClientRect();\n            const x = (e.clientX - left) / width - 0.5;\n            const y = (e.clientY - top) / height - 0.5;\n            \n            card.style.transform = `perspective(1000px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg)`;\n        });\n\n        card.addEventListener('mouseleave', () => {\n            card.style.transform = `perspective(1000px) rotateY(0deg) rotateX(0deg)`;\n            card.style.transition = 'transform 0.5s ease';\n        });\n\n        card.addEventListener('mouseenter', () => {\n            card.style.transition = 'none';\n        });\n    </script>",
  "css": "\n        body {\n            background-color: #f0f2f5;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            margin: 0;\n            overflow-x: hidden;\n        }\n        .card-container {\n            width: 320px;\n            height: 500px;\n            background-color: #ffffff;\n            border-radius: 1.5rem;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n            display: flex;\n            flex-direction: column;\n            position: relative;\n            overflow: hidden;\n            border: 1px solid #e5e7eb;\n        }\n        .mesh-bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            z-index: 0;\n            opacity: 0.4;\n            background-image: radial-gradient(at 0% 0%, #f8f9ff 0, transparent 50%), \n                              radial-gradient(at 100% 0%, #e6eeff 0, transparent 50%);\n        }\n        .content-layer {\n            position: relative;\n            z-index: 10;\n            display: flex;\n            flex-direction: column;\n            height: 100%;\n            padding: 1.5rem;\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;\n        }\n        .glass-overlay {\n            backdrop-filter: blur(8px);\n            background: rgba(255, 255, 255, 0.2);\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}