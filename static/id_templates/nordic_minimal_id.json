{
  "name": "Nordic Minimal ID",
  "html": "<div class=\"card-container\">\n<div class=\"mesh-bg\"></div>\n<div class=\"content-layer\">\n<!-- Top Status -->\n<div class=\"flex justify-between items-center mb-8\">\n<span class=\"font-id-role text-[10px] tracking-[0.2em] text-primary uppercase opacity-60\">ACCESS GRANTED</span>\n<span class=\"material-symbols-outlined text-primary opacity-40 text-lg\" data-icon=\"sensor_occupied\">sensor_occupied</span>\n</div>\n<!-- Main Grid Layout -->\n<div class=\"flex flex-col flex-grow\">\n<!-- Photo -->\n<div class=\"mb-8\">\n<div class=\"w-[90px] h-[90px] rounded-lg overflow-hidden border border-surface-variant bg-surface-container-low shadow-sm\">\n<img alt=\"Employee ID Photo\" class=\"w-full h-full object-cover\" data-alt=\"A centered portrait of a tech professional with a neutral expression, set against a solid off-white background. The lighting is flat and professional, suitable for a high-security identification card. The person is wearing a simple gray crew neck sweater, aligning with a Nordic minimalist style. The overall tone is clean, bright, and highly legible.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n<!-- Left Aligned Fields (7 Fields) -->\n<div class=\"grid grid-cols-1 gap-y-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Full Name</span>\n<span class=\"font-id-name text-[18px] text-on-surface\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Role</span>\n<span class=\"font-id-role text-id-role text-primary\">{Pass Type}</span>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Employee ID</span>\n<span class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Department</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Unique ID}</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Issue Date</span>\n<span class=\"font-id-number text-id-number text-on-surface\">02.14.2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Expiry</span>\n<span class=\"font-id-number text-id-number text-on-surface\">02.14.2029</span>\n</div>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase mb-0.5\">Clearance</span>\n<div class=\"flex items-center gap-1.5 mt-1\">\n<span class=\"w-2 h-2 rounded-full bg-secondary\"></span>\n<span class=\"font-id-role text-id-role text-on-surface\">Level 4 (Secure)</span>\n</div>\n</div>\n</div>\n</div>\n<!-- Footer and QR -->\n<div class=\"flex justify-between items-end mt-auto pt-4 border-t border-surface-variant\">\n<div class=\"flex flex-col\">\n<span class=\"font-id-role text-[9px] tracking-wider text-on-surface-variant opacity-50 uppercase\">INTERNAL USE ONLY</span>\n<span class=\"font-id-role text-[8px] text-on-surface-variant opacity-40 mt-1\">Found? Return to: HQ Oslo, Nordic Hub</span>\n</div>\n<div class=\"p-1.5 bg-white border border-surface-variant rounded-md shadow-sm\">\n<div class=\"w-14 h-14 bg-on-surface flex items-center justify-center rounded-[2px]\"><img alt=\"QR Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/></div>\n</div>\n</div>\n</div>\n</div>",
  "css": "\n        body {\n            background-color: #f0f2f5;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            margin: 0;\n            overflow-x: hidden;\n        }\n        .card-container {\n            width: 320px;\n            height: 500px;\n            background-color: #ffffff;\n            border-radius: 1.5rem;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);\n            display: flex;\n            flex-direction: column;\n            position: relative;\n            overflow: hidden;\n            border: 1px solid #e5e7eb;\n        }\n        .mesh-bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            z-index: 0;\n            opacity: 0.4;\n            background-image: radial-gradient(at 0% 0%, #f8f9ff 0, transparent 50%), \n                              radial-gradient(at 100% 0%, #e6eeff 0, transparent 50%);\n        }\n        .content-layer {\n            position: relative;\n            z-index: 10;\n            display: flex;\n            flex-direction: column;\n            height: 100%;\n            padding: 1.5rem;\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;\n        }\n        .glass-overlay {\n            backdrop-filter: blur(8px);\n            background: rgba(255, 255, 255, 0.2);\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "",
  "tailwind_config": "{\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-container\": \"#0047ab\",\n                        \"on-surface-variant\": \"#434653\",\n                        \"surface-container\": \"#e6eeff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-fixed\": \"#dae2ff\",\n                        \"on-background\": \"#121c2a\",\n                        \"secondary\": \"#006c49\",\n                        \"primary\": \"#00327d\",\n                        \"surface\": \"#f8f9ff\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-dim\": \"#d0dbed\",\n                        \"background\": \"#f8f9ff\",\n                        \"on-secondary-fixed\": \"#002113\",\n                        \"on-primary-fixed\": \"#001946\",\n                        \"on-primary-fixed-variant\": \"#00419e\",\n                        \"surface-tint\": \"#2559bd\",\n                        \"inverse-surface\": \"#27313f\",\n                        \"on-secondary-container\": \"#00714d\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"surface-variant\": \"#d9e3f6\",\n                        \"outline-variant\": \"#c3c6d5\",\n                        \"inverse-primary\": \"#b1c5ff\",\n                        \"primary-fixed-dim\": \"#b1c5ff\",\n                        \"on-tertiary-fixed-variant\": \"#653e00\",\n                        \"surface-bright\": \"#f8f9ff\",\n                        \"on-tertiary-fixed\": \"#2a1700\",\n                        \"secondary-container\": \"#6cf8bb\",\n                        \"tertiary-container\": \"#6e4400\",\n                        \"tertiary\": \"#4f3000\",\n                        \"on-surface\": \"#121c2a\",\n                        \"on-error-container\": \"#93000a\",\n                        \"error\": \"#ba1a1a\",\n                        \"surface-container-highest\": \"#d9e3f6\",\n                        \"on-error\": \"#ffffff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#ffddb8\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"on-secondary-fixed-variant\": \"#005236\",\n                        \"secondary-fixed-dim\": \"#4edea3\",\n                        \"secondary-fixed\": \"#6ffbbe\",\n                        \"outline\": \"#737784\",\n                        \"tertiary-fixed-dim\": \"#ffb95f\",\n                        \"surface-container-high\": \"#dee9fc\",\n                        \"on-tertiary-container\": \"#ffae3c\",\n                        \"on-primary-container\": \"#a5bdff\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"element-gap\": \"0.75rem\",\n                        \"photo-size-lg\": \"120px\",\n                        \"card-padding\": \"1.5rem\",\n                        \"section-margin\": \"1rem\",\n                        \"photo-size-sm\": \"80px\"\n                    },\n                    \"fontFamily\": {\n                        \"id-name\": [\"Hanken Grotesk\"],\n                        \"id-role\": [\"Inter\"],\n                        \"body-sm\": [\"Inter\"],\n                        \"label-caps\": [\"Inter\"],\n                        \"id-number\": [\"JetBrains Mono\"]\n                    },\n                    \"fontSize\": {\n                        \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                        \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                        \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n                    }\n                },\n            },\n        }"
}