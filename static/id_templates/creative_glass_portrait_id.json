{
  "name": "Creative Glass Portrait ID",
  "html": "<!-- Top Navigation Shell (Suppressing as per Task Context Focus) -->\n<header class=\"fixed top-0 w-full flex justify-between items-center px-section-margin py-4 bg-surface/10 backdrop-blur-md z-50 border-b border-white/20\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"badge\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary\">ID Registry</h1>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high border border-outline-variant overflow-hidden\">\n<img alt=\"Admin\" class=\"w-full h-full object-cover\" src=\"{QR_CODE_URL}\"/>\n</div>\n</header>\n<main class=\"w-full max-w-md flex flex-col items-center gap-8 mt-16\">\n<!-- ID Card Container -->\n<div class=\"relative w-[340px] h-[540px] rounded-[2rem] overflow-hidden shadow-2xl transition-transform duration-500 hover:scale-[1.02] active:scale-95 group\">\n<!-- Animated Background Layers -->\n<div class=\"absolute inset-0 z-0\">\n\n</div>\n<!-- Glass Overlay Card Body -->\n<div class=\"glass-panel absolute inset-0 z-10 p-card-padding flex flex-col items-center\">\n<!-- Card Header -->\n<div class=\"w-full flex justify-between items-start mb-6\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant opacity-80 uppercase\">Creative Tech Hub</span>\n<span class=\"font-id-role text-id-role text-primary font-bold\">IDENTITY CARD</span>\n</div>\n<div class=\"w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center backdrop-blur-sm border border-white/30\">\n<span class=\"material-symbols-outlined text-primary text-3xl\" data-icon=\"hub\">hub</span>\n</div>\n</div>\n<!-- Profile Image Section -->\n<div class=\"relative w-40 h-40 mb-6\">\n<div class=\"absolute inset-0 bg-primary-container rounded-3xl blur-xl opacity-30 group-hover:opacity-50 transition-opacity\"></div>\n<div class=\"relative w-full h-full rounded-3xl overflow-hidden border-4 border-white/50 shadow-lg\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional high-resolution portrait of a woman named {Name} with a warm, confident expression. She has dark hair styled neatly and is wearing a modern professional outfit. The background is a soft-focus creative studio environment with cool blue and purple ambient lighting that complements a vibrant tech aesthetic. The lighting is crisp and cinematic, emphasizing her features with a gentle glow that matches a minimalist luxury design style.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute -bottom-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-secondary-container text-on-secondary-container rounded-full shadow-md flex items-center gap-1 border border-white/40\">\n<span class=\"material-symbols-outlined text-[14px]\" data-icon=\"check_circle\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n<span class=\"font-label-caps text-label-caps font-bold\">check_circle</span>\n</div>\n</div>\n<!-- Primary Identity Details -->\n<div class=\"text-center mb-8\">\n<h2 class=\"font-id-name text-[24px] leading-tight text-on-surface\">{Name}</h2>\n<p class=\"font-id-role text-id-role text-primary-container font-semibold mt-1\">{Pass Type}</p>\n</div>\n<!-- Grid Data Fields -->\n<div class=\"w-full grid grid-cols-2 gap-y-4 gap-x-6 mb-8\">\n<div class=\"flex flex-col\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant opacity-60\">STUDIO</label>\n<span class=\"font-body-sm text-body-sm font-semibold\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant opacity-60\">ID NUMBER</label>\n<span class=\"font-id-number text-id-number font-medium\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant opacity-60\">PROJECT CODE</label>\n<span class=\"font-id-number text-id-number font-medium\">NEON-VIBE-24</span>\n</div>\n<div class=\"flex flex-col\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant opacity-60\">SECURITY TIER</label>\n<span class=\"font-body-sm text-body-sm font-bold text-secondary\">Level 05</span>\n</div>\n</div>\n<!-- Footer Section with QR -->\n<div class=\"mt-auto w-full flex items-end justify-between\">\n<div class=\"flex flex-col gap-1\">\n<div class=\"flex items-center gap-2 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"mail\">mail</span>\n<span class=\"font-body-sm text-[10px]\">{Email Address}</span>\n</div>\n<div class=\"flex items-center gap-2 text-on-surface-variant\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"location_on\">location_on</span>\n<span class=\"font-body-sm text-[10px]\">Austin Tech District</span>\n</div>\n</div>\n<!-- QR Code Area -->\n<div class=\"relative w-16 h-16 bg-white p-1 rounded-lg shadow-inner\">\n<img alt=\"QR Code\" class=\"w-full h-full\" src=\"{QR_CODE_URL}\"/>\n<div class=\"hologram-shimmer absolute inset-0 rounded-lg pointer-events-none\"></div>\n</div>\n</div>\n</div>\n<!-- Subtle Security Hologram Element -->\n<div class=\"absolute bottom-4 right-4 z-20 opacity-20 pointer-events-none\">\n<span class=\"material-symbols-outlined text-5xl text-white/50\" data-icon=\"security\">security</span>\n</div>\n</div>\n<!-- Action Area (Success Page Context - Simple back/home) -->\n<div class=\"flex gap-4\">\n<button class=\"px-6 py-2 rounded-full bg-primary text-on-primary font-id-role flex items-center gap-2 shadow-lg hover:brightness-110 active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined\" data-icon=\"print\">print</span>\n                Print Physical Card\n            </button>\n<button class=\"px-6 py-2 rounded-full bg-white/20 backdrop-blur-md text-on-background font-id-role border border-white/30 flex items-center gap-2 hover:bg-white/40 active:scale-95 transition-all\">\n<span class=\"material-symbols-outlined\" data-icon=\"share\">share</span>\n                Digital Share\n            </button>\n</div>\n</main>\n<!-- Bottom Navigation Shell (Suppressing as per Destination Rule for focused task) -->\n<!-- The user is viewing a specific entity card, making it a \"Details/Success\" view -->\n<script>\n        // Micro-interaction for the card following mouse tilt\n        const card = document.querySelector('.group');\n        document.addEventListener('mousemove', (e) => {\n            if (!card) return;\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            \n            const rotateX = (y - centerY) / 20;\n            const rotateY = (centerX - x) / 20;\n            \n            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n\n        document.addEventListener('mouseleave', () => {\n            if (!card) return;\n            card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n        });\n    </script>",
  "css": "\n        .glass-panel {\n            background: rgba(255, 255, 255, 0.4);\n            backdrop-filter: blur(16px);\n            -webkit-backdrop-filter: blur(16px);\n            border: 1px solid rgba(255, 255, 255, 0.3);\n        }\n        .mesh-gradient {\n            background-color: #f8f9ff;\n            background-image: \n                radial-gradient(at 0% 0%, #b1c5ff 0px, transparent 50%),\n                radial-gradient(at 100% 0%, #6ffbbe 0px, transparent 50%),\n                radial-gradient(at 100% 100%, #ffddb8 0px, transparent 50%),\n                radial-gradient(at 0% 100%, #dae2ff 0px, transparent 50%);\n            background-size: 100% 100%;\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.3) 0%, rgba(255,0,255,0.3) 50%, rgba(255,255,0,0.3) 100%);\n            mix-blend-mode: soft-light;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}