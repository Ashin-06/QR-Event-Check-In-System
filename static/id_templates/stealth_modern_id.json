{
  "name": "Stealth Modern ID",
  "html": "<!-- Top Navigation Bar (Shared Component) -->\n<header class=\"w-full top-0 sticky bg-surface border-b border-outline-variant flex justify-between items-center px-section-margin py-4 z-50\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"badge\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary\">ID Registry</h1>\n</div>\n<div class=\"flex items-center gap-4\">\n<nav class=\"hidden md:flex gap-6\">\n<a class=\"font-id-role text-id-role text-primary transition-colors duration-200\" href=\"#\">Registration</a>\n<a class=\"font-id-role text-id-role text-on-surface-variant hover:bg-surface-container transition-colors duration-200 p-1 px-2 rounded\" href=\"#\">Templates</a>\n<a class=\"font-id-role text-id-role text-on-surface-variant hover:bg-surface-container transition-colors duration-200 p-1 px-2 rounded\" href=\"#\">Analytics</a>\n</nav>\n<div class=\"w-10 h-10 rounded-full bg-surface-variant overflow-hidden border border-outline-variant\">\n<img alt=\"Admin\" data-alt=\"A professional close-up portrait of a senior system administrator with a focused and calm expression. The lighting is crisp and studio-quality, highlighting facial features against a dark, tech-oriented background. The image maintains a high-end corporate modernism style with a cool blue and dark gray color palette.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n</header>\n<main class=\"flex flex-col md:flex-row min-h-[calc(100vh-72px)]\">\n<!-- Sidebar Navigation (Shared Component) -->\n<aside class=\"hidden md:flex h-auto w-80 bg-surface-container-low shadow-md flex-col z-40 p-4 border-r border-outline-variant\">\n<div class=\"mb-8 p-4\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-12 h-12 bg-primary rounded-xl flex items-center justify-center text-white\">\n<span class=\"material-symbols-outlined\" data-icon=\"shield\">shield</span>\n</div>\n<div>\n<p class=\"font-id-name text-id-name text-on-surface\">System Admin</p>\n<p class=\"font-body-sm text-on-surface-variant\">Bulk Management</p>\n</div>\n</div>\n</div>\n<nav class=\"space-y-2\">\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-xl cursor-pointer transition-transform duration-150 active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"app_registration\">app_registration</span>\n<span class=\"font-id-role text-id-role\">Registration</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 bg-secondary-container text-on-secondary-container rounded-full cursor-pointer transition-transform duration-150 active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"style\">style</span>\n<span class=\"font-id-role text-id-role\">Templates</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-xl cursor-pointer transition-transform duration-150 active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-id-role text-id-role\">Analytics</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-xl cursor-pointer transition-transform duration-150 active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n<span class=\"font-id-role text-id-role\">Settings</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-xl cursor-pointer transition-transform duration-150 active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"help\">help</span>\n<span class=\"font-id-role text-id-role\">Help</span>\n</div>\n</nav>\n</aside>\n<!-- Main Canvas -->\n<section class=\"flex-1 p-4 md:p-12 flex flex-col items-center justify-center bg-surface-bright relative\">\n<div class=\"w-full max-w-4xl grid md:grid-cols-2 gap-12 items-center\">\n<!-- Left: Configuration Controls -->\n<div class=\"order-2 md:order-1\">\n<h2 class=\"font-id-name text-[32px] leading-tight mb-4 text-on-surface\">Stealth Modern <span class=\"text-primary\">Template</span></h2>\n<p class=\"text-on-surface-variant mb-8 font-body-sm leading-relaxed max-w-md\">\n                        The 'Stealth Modern' configuration is designed for high-clearance environments. Its ultra-low visibility aesthetic ensures security while maintaining a high-end technical signature.\n                    </p>\n<div class=\"space-y-4\">\n<div class=\"p-4 bg-surface-container rounded-xl flex items-center justify-between\">\n<div>\n<p class=\"font-id-role text-id-role\">Active Layer: High-Contrast</p>\n<p class=\"text-[11px] text-on-surface-variant uppercase tracking-widest\">Matte Finish Enabled</p>\n</div>\n<div class=\"w-12 h-6 bg-primary rounded-full relative\">\n<div class=\"absolute right-1 top-1 w-4 h-4 bg-white rounded-full\"></div>\n</div>\n</div>\n<div class=\"p-4 bg-surface-container-low border border-outline-variant rounded-xl flex items-center justify-between\">\n<span class=\"font-id-role text-id-role\">Security Tier Level</span>\n<span class=\"bg-inverse-surface text-inverse-on-surface px-3 py-1 rounded-full text-[10px] font-bold\">TIER 1</span>\n</div>\n</div>\n<button class=\"mt-12 w-full py-4 bg-primary text-on-primary font-id-name rounded-xl shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all\">\n                        GENERATE PHYSICAL ENCODING\n                    </button>\n</div>\n<!-- Right: The Card (CR80 Portrait) -->\n<div class=\"order-1 md:order-2 flex justify-center\">\n<!-- Physical Card Representation -->\n<div class=\"relative w-[340px] h-[540px] matte-black-texture rounded-[24px] shadow-2xl overflow-hidden border border-white/5 flex flex-col p-6 group\">\n<!-- Top Header Area -->\n<div class=\"flex justify-between items-start mb-6\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-bold tracking-[0.3em] text-outline uppercase mb-1\">Status</span>\n<div class=\"flex items-center gap-1.5\">\n<div class=\"w-2 h-2 rounded-full bg-secondary shadow-[0_0_8px_rgba(0,108,73,0.8)] animate-pulse\"></div>\n<span class=\"text-[12px] font-id-role text-secondary font-bold uppercase tracking-wider\">SECURE</span>\n</div>\n</div>\n<div class=\"text-right\">\n<p class=\"text-[10px] font-id-role text-outline-variant font-bold leading-none tracking-widest uppercase\">Security Clearance</p>\n<p class=\"text-[8px] font-id-number text-outline tracking-tighter opacity-50\">{Unique ID}</p>\n</div>\n</div>\n<!-- ID Photo Container (Corporate/Industrial Hybrid) -->\n<div class=\"relative w-full aspect-[4/5] bg-on-background rounded-xl mb-6 overflow-hidden border border-white/10 group-hover:border-white/20 transition-colors\">\n<img alt=\"Clearance Subject\" class=\"w-full h-full object-cover grayscale brightness-90 contrast-125\" data-alt=\"A high-contrast cinematic portrait of a young adult male with sharp features, styled in a stealth tech aesthetic. The lighting is moody and dramatic, with deep shadows and a singular harsh key light from the side, creating a high-end security badge appearance. The overall color profile is monochromatic, dominated by matte blacks and dark charcoal grays, evoking a sense of elite tier-one security clearance.\" src=\"{PHOTO_URL}\"/>\n<!-- Tactical Overlay -->\n<div class=\"absolute inset-0 border-[1px] border-white/10 pointer-events-none\"></div>\n<div class=\"absolute top-4 right-4 w-6 h-6 border-t border-r border-white/40\"></div>\n<div class=\"absolute bottom-4 left-4 w-6 h-6 border-b border-l border-white/40\"></div>\n<!-- Access Label -->\n<div class=\"absolute bottom-0 w-full glass-overlay py-2 flex justify-center\">\n<span class=\"text-[10px] font-label-caps text-white tracking-[0.4em] uppercase\">check_circle SUBJECT</span>\n</div>\n</div>\n<!-- Data Fields -->\n<div class=\"flex-1 space-y-4\">\n<div class=\"flex flex-col border-l-2 border-primary/40 pl-3\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Full Name</span>\n<span class=\"text-id-name font-id-name text-white tracking-wide\">{Name}</span>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Assigned Role</span>\n<span class=\"text-[13px] font-id-role text-white/80\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Employee ID</span>\n<span class=\"text-[13px] font-id-number text-white/80\">{Registration Number}</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Issue Date</span>\n<span class=\"text-[12px] font-id-role text-white/60\">01 / 2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Expiration</span>\n<span class=\"text-[12px] font-id-role text-white/60\">01 / 2026</span>\n</div>\n</div>\n</div>\n<!-- Footer Area (Tier 1 & QR) -->\n<div class=\"mt-4 pt-6 border-t border-white/10 flex justify-between items-end\">\n<div class=\"flex flex-col\">\n<span class=\"text-[20px] font-bold font-id-name text-white tracking-[0.2em]\">TIER 1</span>\n<span class=\"text-[9px] font-label-caps text-outline tracking-widest uppercase\">Operational Clearance</span>\n</div>\n<!-- QR Code Placeholder -->\n<div class=\"w-16 h-16 bg-white p-1 rounded-lg opacity-80 hover:opacity-100 transition-opacity flex items-center justify-center\">\n<div class=\"w-full h-full bg-on-background relative overflow-hidden\">\n<!-- Simple CSS generated QR-like pattern -->\n<div class=\"absolute inset-0 opacity-40\" style=\"background-image: repeating-conic-gradient(#fff 0% 25%, #000 0% 50%); background-size: 8px 8px;\"></div>\n<div class=\"absolute inset-2 bg-on-background border border-white/20\"></div>\n<span class=\"material-symbols-outlined text-white text-[16px] absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2\" data-icon=\"qr_code_2\">qr_code_2</span>\n</div>\n</div>\n</div>\n<!-- Security Hologram (Digital) -->\n<div class=\"absolute bottom-4 right-20 w-24 h-12 security-shimmer opacity-30 rounded-full rotate-[-15deg] pointer-events-none\"></div>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Bottom Navigation Bar (Mobile Shared Component) -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full bg-surface-container-highest border-t border-outline-variant flex justify-around p-2 z-50\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n<!-- Floating Action Button (Contextual) -->\n<button class=\"fixed bottom-24 right-6 md:bottom-8 md:right-8 w-14 h-14 bg-primary-container text-on-primary-container rounded-full shadow-lg flex items-center justify-center hover:scale-110 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"add\">add</span>\n</button>\n<script>\n        // Subtle micro-interaction: holographic effect follows mouse\n        const card = document.querySelector('.matte-black-texture');\n        const hologram = document.querySelector('.security-shimmer');\n\n        card.addEventListener('mousemove', (e) => {\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const moveX = (x / rect.width) * 20 - 10;\n            const moveY = (y / rect.height) * 20 - 10;\n            \n            hologram.style.transform = `translate(${moveX}px, ${moveY}px) rotate(-15deg)`;\n            hologram.style.opacity = (Math.abs(moveX) + Math.abs(moveY)) / 40 + 0.1;\n        });\n\n        card.addEventListener('mouseleave', () => {\n            hologram.style.transform = `translate(0, 0) rotate(-15deg)`;\n            hologram.style.opacity = 0.3;\n        });\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .matte-black-texture {\n            background-color: #121c2a; /* Closest to on-background/inverse-surface */\n            background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.02) 1px, transparent 0);\n            background-size: 24px 24px;\n        }\n        .security-shimmer {\n            background: linear-gradient(135deg, rgba(0,71,171,0.1) 0%, rgba(0,108,73,0.1) 50%, rgba(110,68,0,0.1) 100%);\n            backdrop-filter: blur(4px);\n        }\n        .glass-overlay {\n            background: rgba(255, 255, 255, 0.03);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}