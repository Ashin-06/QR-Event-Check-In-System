  "name": "Stealth Modern ID",
  "html": "<div class=\"relative w-[340px] h-[540px] matte-black-texture rounded-[24px] shadow-2xl overflow-hidden border border-white/5 flex flex-col p-6 group\">\n<!-- Top Header Area -->\n<div class=\"flex justify-between items-start mb-6\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-bold tracking-[0.3em] text-outline uppercase mb-1\">Status</span>\n<div class=\"flex items-center gap-1.5\">\n<div class=\"w-2 h-2 rounded-full bg-secondary shadow-[0_0_8px_rgba(0,108,73,0.8)] animate-pulse\"></div>\n<span class=\"text-[12px] font-id-role text-secondary font-bold uppercase tracking-wider\">SECURE</span>\n</div>\n</div>\n<div class=\"text-right\">\n<p class=\"text-[10px] font-id-role text-outline-variant font-bold leading-none tracking-widest uppercase\">Security Clearance</p>\n<p class=\"text-[8px] font-id-number text-outline tracking-tighter opacity-50\">{Unique ID}</p>\n</div>\n</div>\n<!-- ID Photo Container (Corporate/Industrial Hybrid) -->\n<div class=\"relative w-full aspect-[4/5] bg-on-background rounded-xl mb-6 overflow-hidden border border-white/10 group-hover:border-white/20 transition-colors\">\n<img alt=\"Clearance Subject\" class=\"w-full h-full object-cover grayscale brightness-90 contrast-125\" data-alt=\"A high-contrast cinematic portrait of a young adult male with sharp features, styled in a stealth tech aesthetic. The lighting is moody and dramatic, with deep shadows and a singular harsh key light from the side, creating a high-end security badge appearance. The overall color profile is monochromatic, dominated by matte blacks and dark charcoal grays, evoking a sense of elite tier-one security clearance.\" src=\"{PHOTO_URL}\"/>\n<!-- Tactical Overlay -->\n<div class=\"absolute inset-0 border-[1px] border-white/10 pointer-events-none\"></div>\n<div class=\"absolute top-4 right-4 w-6 h-6 border-t border-r border-white/40\"></div>\n<div class=\"absolute bottom-4 left-4 w-6 h-6 border-b border-l border-white/40\"></div>\n<!-- Access Label -->\n<div class=\"absolute bottom-0 w-full glass-overlay py-2 flex justify-center\">\n<span class=\"text-[10px] font-label-caps text-white tracking-[0.4em] uppercase\">check_circle SUBJECT</span>\n</div>\n</div>\n<!-- Data Fields -->\n<div class=\"flex-1 space-y-4\">\n<div class=\"flex flex-col border-l-2 border-primary/40 pl-3\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Full Name</span>\n<span class=\"text-id-name font-id-name text-white tracking-wide\">{Name}</span>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Assigned Role</span>\n<span class=\"text-[13px] font-id-role text-white/80\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Employee ID</span>\n<span class=\"text-[13px] font-id-number text-white/80\">{Registration Number}</span>\n</div>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Issue Date</span>\n<span class=\"text-[12px] font-id-role text-white/60\">01 / 2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"text-[10px] font-label-caps text-outline uppercase tracking-widest\">Expiration</span>\n<span class=\"text-[12px] font-id-role text-white/60\">01 / 2026</span>\n</div>\n</div>\n</div>\n<!-- Footer Area (Tier 1 & QR) -->\n<div class=\"mt-4 pt-6 border-t border-white/10 flex justify-between items-end\">\n<div class=\"flex flex-col\">\n<span class=\"text-[20px] font-bold font-id-name text-white tracking-[0.2em]\">TIER 1</span>\n<span class=\"text-[9px] font-label-caps text-outline tracking-widest uppercase\">Operational Clearance</span>\n</div>\n<!-- QR Code Placeholder -->\n<div class=\"w-16 h-16 bg-white p-1 rounded-lg opacity-80 hover:opacity-100 transition-opacity flex items-center justify-center\">\n<div class=\"w-full h-full bg-on-background relative overflow-hidden\">\n<!-- Simple CSS generated QR-like pattern -->\n<div class=\"absolute inset-0 opacity-40\" style=\"background-image: repeating-conic-gradient(#fff 0% 25%, #000 0% 50%); background-size: 8px 8px;\"></div>\n<div class=\"absolute inset-2 bg-on-background border border-white/20\"></div>\n<span class=\"material-symbols-outlined text-white text-[16px] absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2\" data-icon=\"qr_code_2\">qr_code_2</span>\n</div>\n</div>\n</div>\n<!-- Security Hologram (Digital) -->\n<div class=\"absolute bottom-4 right-20 w-24 h-12 security-shimmer opacity-30 rounded-full rotate-[-15deg] pointer-events-none\"></div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .matte-black-texture {\n            background-color: #121c2a; /* Closest to on-background/inverse-surface */\n            background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.02) 1px, transparent 0);\n            background-size: 24px 24px;\n        }\n        .security-shimmer {\n            background: linear-gradient(135deg, rgba(0,71,171,0.1) 0%, rgba(0,108,73,0.1) 50%, rgba(110,68,0,0.1) 100%);\n            backdrop-filter: blur(4px);\n        }\n        .glass-overlay {\n            background: rgba(255, 255, 255, 0.03);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}