{
  "name": "Neo Corporate Portrait ID",
  "html": "<article class=\"cr80-card\">\n<!-- Header Section -->\n<header class=\"header-wave\">\n<div class=\"flex flex-col items-center\">\n<span class=\"material-symbols-outlined text-white text-3xl mb-1\" style=\"font-variation-settings: 'FILL' 1\">badge</span>\n<h1 class=\"font-id-name text-id-name text-white tracking-widest uppercase text-[12px]\">{Event}</h1>\n</div>\n<!-- Photo Container -->\n<div class=\"photo-border\">\n<div class=\"photo-inner\">\n<img alt=\"{Name} Portrait\" class=\"w-full h-full object-cover\" data-alt=\"A professional portrait of {Name}, a middle-aged man with a confident and friendly expression. He is wearing a sharp, tailored navy blue suit with a clean white shirt. The lighting is soft and cinematic, highlighting his features against a neutral, high-key studio background that emphasizes the professional and elite atmosphere of a high-end corporate conference. The overall mood is sophisticated, reliable, and grounded in corporate modernism.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n</header>\n<!-- Main Content Canvas -->\n<main class=\"flex-1 mt-[75px] px-card-padding flex flex-col items-center text-center\">\n<!-- Primary Identity -->\n<div class=\"mb-4\">\n<h2 class=\"font-id-name text-id-name text-on-surface mb-0.5\">{Name}</h2>\n<span class=\"font-id-role text-id-role text-secondary font-semibold\">{Pass Type}</span>\n</div>\n<!-- Access Chip -->\n<div class=\"mb-6\">\n<span class=\"bg-secondary-container text-on-secondary-container px-4 py-1 rounded-full font-label-caps text-label-caps flex items-center gap-1.5 border border-on-secondary-fixed-variant/20\">\n<span class=\"material-symbols-outlined text-[14px]\">person</span>\n                    All-Access VIP\n                </span>\n</div>\n<!-- Data Fields Grid -->\n<div class=\"w-full grid grid-cols-2 gap-y-4 gap-x-2 text-left mb-6\">\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-70\">ID Number</label>\n<p class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</p>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-70\">Branch</label>\n<p class=\"font-body-sm text-body-sm text-on-surface\">North America</p>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-70\">Department</label>\n<p class=\"font-body-sm text-body-sm text-on-surface\">Strategic Ops</p>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase opacity-70\">Email</label>\n<p class=\"font-body-sm text-body-sm text-on-surface truncate\">{Email Address}</p>\n</div>\n</div>\n<!-- Footer / Security Area -->\n<div class=\"mt-auto pb-6 w-full flex flex-col items-center\">\n<div class=\"qr-area mb-3\">\n<img alt=\"Security QR Code\" class=\"w-20 h-20\" data-alt=\"A clean, high-contrast QR code generated in a deep emerald green color. The QR code is perfectly centered within a white, rounded-corner container, creating a minimalist and functional design element suitable for a high-security professional ID. The surrounding space is pristine and emphasizes the technical utility of the code for scanning and verification at a corporate event.\" src=\"{QR_CODE_URL}\"/>\n</div>\n<div class=\"flex items-center gap-2\">\n<span class=\"h-px w-8 bg-outline-variant\"></span>\n<span class=\"font-label-caps text-label-caps text-on-surface-variant tracking-widest uppercase\">Registry Certified</span>\n<span class=\"h-px w-8 bg-outline-variant\"></span>\n</div>\n</div>\n</main>\n<!-- Digital Security Overlay (Hologram) -->\n<div class=\"hologram-shimmer\"></div>\n<div class=\"absolute bottom-2 left-4\">\n<p class=\"font-label-caps text-[8px] text-outline opacity-40 uppercase tracking-tighter\">Issue Date: 12/2023 • Exp: 12/2025</p>\n</div>\n</article>",
  "css": "\n        body {\n            background-color: #f1f5f9;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            margin: 0;\n            -webkit-font-smoothing: antialiased;\n        }\n\n        .cr80-card {\n            width: 337px; /* 85.6mm */\n            height: 539px; /* 136.7mm (Extended Portrait) */\n            background-color: #ffffff;\n            border-radius: 1.25rem;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);\n            position: relative;\n            overflow: hidden;\n            display: flex;\n            flex-direction: column;\n            border: 1px solid #e2e8f0;\n        }\n\n        .header-wave {\n            background-color: #006c49; /* Deep Emerald Green */\n            height: 140px;\n            width: 100%;\n            position: relative;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            padding-top: 1rem;\n        }\n\n        .photo-border {\n            width: 130px;\n            height: 130px;\n            background-color: #ffffff;\n            border-radius: 50%;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            position: absolute;\n            bottom: -65px;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n        }\n\n        .photo-inner {\n            width: 120px;\n            height: 120px;\n            border-radius: 50%;\n            overflow: hidden;\n            background-color: #e2e8f0;\n        }\n\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n            vertical-align: middle;\n        }\n\n        .hologram-shimmer {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, rgba(0, 255, 255, 0.3) 0%, rgba(255, 0, 255, 0.3) 50%, rgba(255, 215, 0, 0.3) 100%);\n            border-radius: 50%;\n            filter: blur(2px);\n            opacity: 0.5;\n            animation: rotate 4s linear infinite;\n        }\n\n        @keyframes rotate {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n\n        .qr-area {\n            background-color: #ffffff;\n            padding: 8px;\n            border-radius: 8px;\n            border: 1px solid #f1f5f9;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"on-primary-fixed-variant\": \"#00419e\",\n                    \"on-primary\": \"#ffffff\",\n                    \"surface-container-highest\": \"#d9e3f6\",\n                    \"on-background\": \"#121c2a\",\n                    \"on-primary-container\": \"#a5bdff\",\n                    \"error\": \"#ba1a1a\",\n                    \"outline\": \"#737784\",\n                    \"on-tertiary-fixed\": \"#2a1700\",\n                    \"background\": \"#f8f9ff\",\n                    \"surface-container-lowest\": \"#ffffff\",\n                    \"surface-container-high\": \"#dee9fc\",\n                    \"error-container\": \"#ffdad6\",\n                    \"surface-container-low\": \"#eff4ff\",\n                    \"secondary-fixed-dim\": \"#4edea3\",\n                    \"on-secondary\": \"#ffffff\",\n                    \"primary-fixed\": \"#dae2ff\",\n                    \"on-secondary-container\": \"#00714d\",\n                    \"surface-dim\": \"#d0dbed\",\n                    \"primary-fixed-dim\": \"#b1c5ff\",\n                    \"tertiary-fixed\": \"#ffddb8\",\n                    \"inverse-on-surface\": \"#eaf1ff\",\n                    \"on-error-container\": \"#93000a\",\n                    \"tertiary-fixed-dim\": \"#ffb95f\",\n                    \"on-tertiary-fixed-variant\": \"#653e00\",\n                    \"surface-container\": \"#e6eeff\",\n                    \"primary-container\": \"#0047ab\",\n                    \"outline-variant\": \"#c3c6d5\",\n                    \"secondary-fixed\": \"#6ffbbe\",\n                    \"inverse-surface\": \"#27313f\",\n                    \"on-surface-variant\": \"#434653\",\n                    \"on-surface\": \"#121c2a\",\n                    \"on-tertiary\": \"#ffffff\",\n                    \"on-primary-fixed\": \"#001946\",\n                    \"primary\": \"#00327d\",\n                    \"tertiary-container\": \"#6e4400\",\n                    \"on-error\": \"#ffffff\",\n                    \"surface-tint\": \"#2559bd\",\n                    \"secondary\": \"#006c49\",\n                    \"secondary-container\": \"#6cf8bb\",\n                    \"inverse-primary\": \"#b1c5ff\",\n                    \"surface-bright\": \"#f8f9ff\",\n                    \"surface\": \"#f8f9ff\",\n                    \"tertiary\": \"#4f3000\",\n                    \"surface-variant\": \"#d9e3f6\",\n                    \"on-tertiary-container\": \"#ffae3c\",\n                    \"on-secondary-fixed\": \"#002113\",\n                    \"on-secondary-fixed-variant\": \"#005236\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"0.75rem\",\n                    \"photo-size-sm\": \"80px\",\n                    \"photo-size-lg\": \"120px\",\n                    \"section-margin\": \"1rem\",\n                    \"card-padding\": \"1.5rem\"\n            },\n            \"fontFamily\": {\n                    \"id-name\": [\"Hanken Grotesk\"],\n                    \"id-number\": [\"JetBrains Mono\"],\n                    \"body-sm\": [\"Inter\"],\n                    \"label-caps\": [\"Inter\"],\n                    \"id-role\": [\"Inter\"]\n            },\n            \"fontSize\": {\n                    \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                    \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}]\n            }\n          },\n        },\n      }"
}