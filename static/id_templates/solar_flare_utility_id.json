{
  "name": "Solar Flare Utility ID",
  "html": "<!-- Top Navigation Anchor -->\n<header class=\"fixed top-0 w-full flex justify-between items-center px-section-margin py-4 bg-surface dark:bg-on-surface border-b border-outline-variant dark:border-outline z-50\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary-fixed\" data-icon=\"badge\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary dark:text-primary-fixed\">ID Registry</h1>\n</div>\n<div class=\"flex items-center gap-4\">\n<nav class=\"hidden md:flex gap-6\">\n<a class=\"font-id-role text-id-role text-primary dark:text-primary-fixed transition-colors duration-200\" href=\"#\">Registration</a>\n<a class=\"font-id-role text-id-role text-on-surface-variant dark:text-outline-variant hover:bg-surface-container transition-colors duration-200 px-2 py-1 rounded\" href=\"#\">Templates</a>\n</nav>\n<div class=\"w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center overflow-hidden border border-outline-variant\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</header>\n<!-- Main Content: CR80 Portrait ID Card -->\n<main class=\"relative mt-20 flex flex-col md:flex-row gap-12 items-start justify-center w-full max-w-5xl\">\n<!-- Left Column: Controls/Context -->\n<section class=\"hidden lg:flex flex-col gap-6 w-80\">\n<div class=\"bg-surface-container-low p-6 rounded-xl shadow-md border border-outline-variant\">\n<h2 class=\"font-id-name text-id-name mb-4 text-on-surface\">Template Parameters</h2>\n<div class=\"space-y-4\">\n<div class=\"flex justify-between items-center border-b border-outline-variant pb-2\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase\">Style Variant</span>\n<span class=\"font-id-role text-id-role text-primary\">Solar Flare</span>\n</div>\n<div class=\"flex justify-between items-center border-b border-outline-variant pb-2\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase\">Layout</span>\n<span class=\"font-id-role text-id-role text-primary\">Industrial Portrait</span>\n</div>\n<div class=\"flex justify-between items-center border-b border-outline-variant pb-2\">\n<span class=\"font-label-caps text-label-caps text-on-surface-variant uppercase\">Print Spec</span>\n<span class=\"font-id-role text-id-role text-primary\">CR80 (86x54mm)</span>\n</div>\n</div>\n</div>\n<div class=\"bg-on-background p-6 rounded-xl shadow-md text-surface\">\n<span class=\"material-symbols-outlined text-solar-flare mb-2\" data-icon=\"warning\" style=\"font-variation-settings: 'FILL' 1;\">warning</span>\n<p class=\"font-body-sm text-body-sm opacity-80\">High security clearance required for \"Zone 4\" access markers. Holographic overlay must be applied post-print.</p>\n</div>\n</section>\n<!-- CENTER: THE ID CARD -->\n<div class=\"relative group\">\n<!-- Physical Card Container (3.375\" x 2.125\" ratio simplified to pixels) -->\n<div class=\"w-[380px] h-[600px] bg-white rounded-[20px] shadow-2xl overflow-hidden flex flex-col border-[6px] border-on-background relative\">\n<!-- TOP SIDE: Safety Stripe Pattern -->\n<div class=\"w-full h-8 safety-stripe\"></div>\n<!-- RIGHT SIDE: Vertical SITE ACCESS label -->\n<div class=\"absolute right-0 top-8 bottom-0 w-12 bg-on-background flex items-center justify-center\">\n<span class=\"vertical-text font-id-name text-2xl tracking-[0.2em] text-solar-flare font-black\">SITE ACCESS</span>\n</div>\n<!-- INNER CANVAS -->\n<div class=\"flex-1 mr-12 p-card-padding flex flex-col gap-element-gap relative\">\n<!-- Header/Identity Section -->\n<div class=\"flex justify-between items-start\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-solar-flare bg-on-background px-2 py-0.5 rounded-sm inline-block w-fit mb-1\">{Pass Type}</span>\n<h2 class=\"font-id-name text-2xl text-on-background leading-tight\">AURORA NEURAL LABS</h2>\n</div>\n<div class=\"w-10 h-10 bg-on-background rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-solar-flare\" data-icon=\"bolt\" style=\"font-variation-settings: 'FILL' 1;\">bolt</span>\n</div>\n</div>\n<!-- PORTRAIT PHOTO -->\n<div class=\"relative w-full flex justify-center my-2\">\n<div class=\"w-photo-size-lg h-photo-size-lg rounded-lg border-2 border-on-background p-1 bg-white relative\">\n<div class=\"w-full h-full overflow-hidden rounded-md bg-surface-variant\">\n<img class=\"w-full h-full object-cover grayscale contrast-125\" data-alt=\"A professional high-fidelity portrait of a middle-aged male technician in a sleek grey industrial uniform. The lighting is crisp and cinematic, characteristic of a high-security facility. The background is a clean, neutral industrial grey with subtle tech textures. The overall mood is serious, authoritative, and perfectly integrated into the bold orange and yellow solar flare design aesthetic.\" src=\"{QR_CODE_URL}\"/>\n</div>\n<!-- Status Overlay -->\n<div class=\"absolute -bottom-2 right-[-10px] bg-solar-flare text-on-background font-label-caps text-[8px] px-2 py-1 rounded shadow-md border border-on-background font-bold\">\n                                check_circle 2024\n                            </div>\n</div>\n</div>\n<!-- DATA FIELDS (7 fields) -->\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-2 mt-4\">\n<!-- 1 -->\n<div class=\"col-span-2 border-l-4 border-solar-flare pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Full Name</label>\n<span class=\"font-id-name text-id-name text-on-background\">{Name}</span>\n</div>\n<!-- 2 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Employee ID</label>\n<span class=\"font-id-number text-id-number text-on-background font-bold tracking-widest\">{Registration Number}</span>\n</div>\n<!-- 3 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Access Level</label>\n<span class=\"font-id-role text-id-role text-on-background\">LEVEL 4 - CRITICAL</span>\n</div>\n<!-- 4 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Pass Tier</label>\n<span class=\"font-id-role text-id-role text-on-background\">{Pass Type}</span>\n</div>\n<!-- 5 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Expires</label>\n<span class=\"font-id-number text-id-number text-error font-bold\">12/2026</span>\n</div>\n<!-- 6 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Station</label>\n<span class=\"font-id-role text-id-role text-on-background\">{Unique ID}</span>\n</div>\n<!-- 7 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Auth Code</label>\n<span class=\"font-id-number text-id-number text-on-background\">K7-DELTA</span>\n</div>\n</div>\n<!-- LOWER SECURITY BLOCK with Integrated QR -->\n<div class=\"mt-auto bg-on-background rounded-xl p-4 flex items-center justify-between gap-4 border-2 border-solar-flare relative overflow-hidden\">\n<!-- Security Mesh Pattern Overlay -->\n<div class=\"absolute inset-0 security-mesh opacity-20 pointer-events-none\"></div>\n<div class=\"flex flex-col gap-1 z-10\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-solar-flare text-sm\" data-icon=\"security\">security</span>\n<span class=\"font-label-caps text-label-caps text-solar-flare\">ENCRYPTED PROTOCOL</span>\n</div>\n<p class=\"text-[9px] text-white/60 leading-tight uppercase font-id-number\">Scan for real-time clearance validation. Tampering voids all access rights.</p>\n</div>\n<div class=\"w-16 h-16 bg-white p-1 rounded-sm shrink-0 z-10 flex items-center justify-center border-2 border-solar-flare\">\n<!-- Placeholder QR Code Representation -->\n<div class=\"w-full h-full bg-on-background flex flex-wrap gap-[2px] p-1\">\n<div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-transparent\"></div>\n<div class=\"w-3 h-3 bg-transparent\"></div><div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-transparent\"></div><div class=\"w-3 h-3 bg-white\"></div>\n<div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-transparent\"></div><div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-white\"></div>\n<div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-white\"></div><div class=\"w-3 h-3 bg-transparent\"></div><div class=\"w-3 h-3 bg-white\"></div>\n</div>\n</div>\n</div>\n</div>\n<!-- Digital Security Hologram Overlay (Bottom Right) -->\n<div class=\"absolute bottom-16 right-14 w-12 h-12 rounded-full opacity-30 pointer-events-none\" style=\"background: linear-gradient(135deg, cyan, magenta, gold);\"></div>\n</div>\n<!-- Hover Interactive Glow -->\n<div class=\"absolute inset-0 bg-solar-flare/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none rounded-[20px] blur-2xl\"></div>\n</div>\n<!-- Right Column: Details/Actions -->\n<aside class=\"flex flex-col gap-6 w-80\">\n<div class=\"bg-surface-container-high p-6 rounded-xl border border-outline-variant\">\n<h3 class=\"font-id-name text-id-name mb-4\">Print Queue</h3>\n<div class=\"space-y-3\">\n<div class=\"flex items-center gap-3 p-2 bg-surface rounded hover:bg-surface-variant cursor-pointer transition-colors\">\n<div class=\"w-8 h-8 rounded bg-on-background flex items-center justify-center text-solar-flare font-bold text-[10px]\">ANL</div>\n<div class=\"flex flex-col\">\n<span class=\"text-body-sm font-bold\">M. Sullivan</span>\n<span class=\"text-[10px] opacity-60 uppercase\">Ready to Print</span>\n</div>\n<span class=\"material-symbols-outlined ml-auto text-on-surface-variant text-sm\" data-icon=\"check_circle\">check_circle</span>\n</div>\n<div class=\"flex items-center gap-3 p-2 bg-surface/50 rounded opacity-50 grayscale\">\n<div class=\"w-8 h-8 rounded bg-on-background flex items-center justify-center text-solar-flare font-bold text-[10px]\">ANL</div>\n<div class=\"flex flex-col\">\n<span class=\"text-body-sm font-bold\">S. Chen</span>\n<span class=\"text-[10px] opacity-60 uppercase\">Awaiting Photo</span>\n</div>\n<span class=\"material-symbols-outlined ml-auto text-on-surface-variant text-sm\" data-icon=\"pending\">pending</span>\n</div>\n</div>\n</div>\n<button class=\"w-full bg-primary text-on-primary font-id-role text-id-role py-4 rounded-xl flex items-center justify-center gap-2 hover:bg-primary-container transition-all active:scale-95 shadow-lg\">\n<span class=\"material-symbols-outlined\" data-icon=\"print\">print</span>\n                EXECUTE PHYSICAL PRINT\n            </button>\n<div class=\"flex gap-2\">\n<button class=\"flex-1 bg-surface-container-highest text-on-surface-variant font-label-caps text-label-caps py-3 rounded-lg border border-outline-variant hover:bg-surface-variant transition-colors\">\n                    EDIT FIELDS\n                </button>\n<button class=\"flex-1 bg-surface-container-highest text-on-surface-variant font-label-caps text-label-caps py-3 rounded-lg border border-outline-variant hover:bg-surface-variant transition-colors\">\n                    RE-PHOTO\n                </button>\n</div>\n</aside>\n</main>\n<!-- Bottom Nav Shell (Mobile Only) -->\n<nav class=\"fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant md:hidden z-50\">\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-[8px] uppercase\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-[8px] uppercase\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-[8px] uppercase\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-[8px] uppercase\">Profile</span>\n</div>\n</nav>\n<script>\n        // Subtle interaction: tilt effect for the ID card\n        const card = document.querySelector('.group');\n        card.addEventListener('mousemove', (e) => {\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            const rotateX = (y - centerY) / 10;\n            const rotateY = (centerX - x) / 10;\n            \n            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;\n        });\n\n        card.addEventListener('mouseleave', () => {\n            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale(1)';\n        });\n    </script>",
  "css": "\n        .safety-stripe {\n            background: repeating-linear-gradient(\n                -45deg,\n                #f59e0b,\n                #f59e0b 10px,\n                #121c2a 10px,\n                #121c2a 20px\n            );\n        }\n        .security-mesh {\n            background-image: radial-gradient(#434653 0.5px, transparent 0.5px);\n            background-size: 4px 4px;\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}