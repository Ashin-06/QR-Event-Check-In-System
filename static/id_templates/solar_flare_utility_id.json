{
  "name": "Solar Flare Utility ID",
  "html": "<div class=\"relative group\">\n<!-- Physical Card Container (3.375\" x 2.125\" ratio simplified to pixels) -->\n<div class=\"w-[380px] h-[600px] bg-white rounded-[20px] shadow-2xl overflow-hidden flex flex-col border-[6px] border-on-background relative\">\n<!-- TOP SIDE: Safety Stripe Pattern -->\n<div class=\"w-full h-8 safety-stripe\"></div>\n<!-- RIGHT SIDE: Vertical SITE ACCESS label -->\n<div class=\"absolute right-0 top-8 bottom-0 w-12 bg-on-background flex items-center justify-center\">\n<span class=\"vertical-text font-id-name text-2xl tracking-[0.2em] text-solar-flare font-black\">SITE ACCESS</span>\n</div>\n<!-- INNER CANVAS -->\n<div class=\"flex-1 mr-12 p-card-padding flex flex-col gap-element-gap relative\">\n<!-- Header/Identity Section -->\n<div class=\"flex justify-between items-start\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-solar-flare bg-on-background px-2 py-0.5 rounded-sm inline-block w-fit mb-1\">{Pass Type}</span>\n<h2 class=\"font-id-name text-2xl text-on-background leading-tight\">AURORA NEURAL LABS</h2>\n</div>\n<div class=\"w-10 h-10 bg-on-background rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-solar-flare\" data-icon=\"bolt\" style=\"font-variation-settings: 'FILL' 1;\">bolt</span>\n</div>\n</div>\n<!-- PORTRAIT PHOTO -->\n<div class=\"relative w-full flex justify-center my-2\">\n<div class=\"w-photo-size-lg h-photo-size-lg rounded-lg border-2 border-on-background p-1 bg-white relative\">\n<div class=\"w-full h-full overflow-hidden rounded-md bg-surface-variant\">\n<img class=\"w-full h-full object-cover grayscale contrast-125\" data-alt=\"A professional high-fidelity portrait of a middle-aged male technician in a sleek grey industrial uniform. The lighting is crisp and cinematic, characteristic of a high-security facility. The background is a clean, neutral industrial grey with subtle tech textures. The overall mood is serious, authoritative, and perfectly integrated into the bold orange and yellow solar flare design aesthetic.\" src=\"{PHOTO_URL}\"/>\n</div>\n<!-- Status Overlay -->\n<div class=\"absolute -bottom-2 right-[-10px] bg-solar-flare text-on-background font-label-caps text-[8px] px-2 py-1 rounded shadow-md border border-on-background font-bold\">\n                                check_circle 2024\n                            </div>\n</div>\n</div>\n<!-- DATA FIELDS (7 fields) -->\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-2 mt-4\">\n<!-- 1 -->\n<div class=\"col-span-2 border-l-4 border-solar-flare pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Full Name</label>\n<span class=\"font-id-name text-id-name text-on-background\">{Name}</span>\n</div>\n<!-- 2 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Employee ID</label>\n<span class=\"font-id-number text-id-number text-on-background font-bold tracking-widest\">{Registration Number}</span>\n</div>\n<!-- 3 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Access Level</label>\n<span class=\"font-id-role text-id-role text-on-background\">LEVEL 4 - CRITICAL</span>\n</div>\n<!-- 4 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Pass Tier</label>\n<span class=\"font-id-role text-id-role text-on-background\">{Pass Type}</span>\n</div>\n<!-- 5 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Expires</label>\n<span class=\"font-id-number text-id-number text-error font-bold\">12/2026</span>\n</div>\n<!-- 6 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Station</label>\n<span class=\"font-id-role text-id-role text-on-background\">{Unique ID}</span>\n</div>\n<!-- 7 -->\n<div class=\"border-l-4 border-on-background pl-2\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block uppercase\">Auth Code</label>\n<span class=\"font-id-number text-id-number text-on-background\">K7-DELTA</span>\n</div>\n</div>\n<!-- LOWER SECURITY BLOCK with Integrated QR -->\n<div class=\"mt-auto bg-on-background rounded-xl p-4 flex items-center justify-between gap-4 border-2 border-solar-flare relative overflow-hidden\">\n<!-- Security Mesh Pattern Overlay -->\n<div class=\"absolute inset-0 security-mesh opacity-20 pointer-events-none\"></div>\n<div class=\"flex flex-col gap-1 z-10\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-solar-flare text-sm\" data-icon=\"security\">security</span>\n<span class=\"font-label-caps text-label-caps text-solar-flare\">ENCRYPTED PROTOCOL</span>\n</div>\n<p class=\"text-[9px] text-white/60 leading-tight uppercase font-id-number\">Scan for real-time clearance validation. Tampering voids all access rights.</p>\n</div>\n<div class=\"w-16 h-16 bg-white p-1 rounded-sm shrink-0 z-10 flex items-center justify-center border-2 border-solar-flare\"><img alt=\"QR Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/></div>\n</div>\n</div>\n<!-- Digital Security Hologram Overlay (Bottom Right) -->\n<div class=\"absolute bottom-16 right-14 w-12 h-12 rounded-full opacity-30 pointer-events-none\" style=\"background: linear-gradient(135deg, cyan, magenta, gold);\"></div>\n</div>\n<!-- Hover Interactive Glow -->\n<div class=\"absolute inset-0 bg-solar-flare/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none rounded-[20px] blur-2xl\"></div>\n</div>",
  "css": "\n        .safety-stripe {\n            background: repeating-linear-gradient(\n                -45deg,\n                #f59e0b,\n                #f59e0b 10px,\n                #121c2a 10px,\n                #121c2a 20px\n            );\n        }\n        .security-mesh {\n            background-image: radial-gradient(#434653 0.5px, transparent 0.5px);\n            background-size: 4px 4px;\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface-dim font-body-sm text-on-surface",
  "tailwind_config": "{\n            darkMode: \"class\",\n            theme: {\n                extend: {\n                    \"colors\": {\n                        \"primary-container\": \"#0047ab\",\n                        \"on-surface-variant\": \"#434653\",\n                        \"surface-container\": \"#e6eeff\",\n                        \"surface-container-low\": \"#eff4ff\",\n                        \"primary-fixed\": \"#dae2ff\",\n                        \"on-background\": \"#121c2a\",\n                        \"secondary\": \"#006c49\",\n                        \"primary\": \"#00327d\",\n                        \"surface\": \"#f8f9ff\",\n                        \"error-container\": \"#ffdad6\",\n                        \"surface-dim\": \"#d0dbed\",\n                        \"background\": \"#f8f9ff\",\n                        \"on-secondary-fixed\": \"#002113\",\n                        \"on-primary-fixed\": \"#001946\",\n                        \"on-primary-fixed-variant\": \"#00419e\",\n                        \"surface-tint\": \"#2559bd\",\n                        \"inverse-surface\": \"#27313f\",\n                        \"on-secondary-container\": \"#00714d\",\n                        \"surface-container-lowest\": \"#ffffff\",\n                        \"on-secondary\": \"#ffffff\",\n                        \"on-primary\": \"#ffffff\",\n                        \"surface-variant\": \"#d9e3f6\",\n                        \"outline-variant\": \"#c3c6d5\",\n                        \"inverse-primary\": \"#b1c5ff\",\n                        \"primary-fixed-dim\": \"#b1c5ff\",\n                        \"on-tertiary-fixed-variant\": \"#653e00\",\n                        \"surface-bright\": \"#f8f9ff\",\n                        \"on-tertiary-fixed\": \"#2a1700\",\n                        \"secondary-container\": \"#6cf8bb\",\n                        \"tertiary-container\": \"#6e4400\",\n                        \"tertiary\": \"#4f3000\",\n                        \"on-surface\": \"#121c2a\",\n                        \"on-error-container\": \"#93000a\",\n                        \"error\": \"#ba1a1a\",\n                        \"surface-container-highest\": \"#d9e3f6\",\n                        \"on-error\": \"#ffffff\",\n                        \"on-tertiary\": \"#ffffff\",\n                        \"tertiary-fixed\": \"#ffddb8\",\n                        \"inverse-on-surface\": \"#eaf1ff\",\n                        \"on-secondary-fixed-variant\": \"#005236\",\n                        \"secondary-fixed-dim\": \"#4edea3\",\n                        \"secondary-fixed\": \"#6ffbbe\",\n                        \"outline\": \"#737784\",\n                        \"tertiary-fixed-dim\": \"#ffb95f\",\n                        \"surface-container-high\": \"#dee9fc\",\n                        \"on-tertiary-container\": \"#ffae3c\",\n                        \"on-primary-container\": \"#a5bdff\",\n                        \"solar-flare\": \"#f59e0b\",\n                        \"solar-accent\": \"#fbbf24\"\n                    },\n                    \"borderRadius\": {\n                        \"DEFAULT\": \"0.25rem\",\n                        \"lg\": \"0.5rem\",\n                        \"xl\": \"0.75rem\",\n                        \"full\": \"9999px\"\n                    },\n                    \"spacing\": {\n                        \"element-gap\": \"0.75rem\",\n                        \"photo-size-lg\": \"120px\",\n                        \"card-padding\": \"1.5rem\",\n                        \"section-margin\": \"1rem\",\n                        \"photo-size-sm\": \"80px\"\n                    },\n                    \"fontFamily\": {\n                        \"id-name\": [\"Hanken Grotesk\"],\n                        \"id-role\": [\"Inter\"],\n                        \"body-sm\": [\"Inter\"],\n                        \"label-caps\": [\"Inter\"],\n                        \"id-number\": [\"JetBrains Mono\"]\n                    },\n                    \"fontSize\": {\n                        \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                        \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                        \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                        \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                        \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n                    }\n                }\n            }\n        }"
}