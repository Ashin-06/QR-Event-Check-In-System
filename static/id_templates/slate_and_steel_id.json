{
  "name": "Slate And Steel ID",
  "html": "<div class=\"card-container\">\n<div class=\"cr80-card\">\n<!-- Top Header: Corporate Headquarters -->\n<div class=\"bg-primary-container h-14 flex items-center justify-center relative overflow-hidden\">\n<div class=\"absolute inset-0 metallic-overlay\"></div>\n<span class=\"font-id-role text-id-role text-on-primary-container tracking-[0.2em] font-extrabold\">CORPORATE HEADQUARTERS</span>\n</div>\n<div class=\"flex flex-1 relative\">\n<!-- Left Side: Est 2024 -->\n<div class=\"w-12 bg-on-surface-variant flex items-center justify-center border-r border-outline-variant\">\n<span class=\"vertical-text font-label-caps text-label-caps text-surface-container tracking-widest rotate-180\">EST. 2024</span>\n</div>\n<!-- Main Content Canvas -->\n<div class=\"flex-1 p-6 flex flex-col gap-element-gap relative\">\n<div class=\"absolute inset-0 hologram-shimmer pointer-events-none opacity-30\"></div>\n<!-- Photo Section -->\n<div class=\"flex justify-center mb-2\">\n<div class=\"w-photo-size-lg h-[140px] border-2 border-outline-variant p-1 bg-white shadow-sm relative overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional portrait of a senior executive in a dark navy blue tailored suit against a metallic gray studio background. The lighting is crisp and sophisticated, highlighting the subject's confident expression. The overall mood is authoritative and corporate, with a clean, high-contrast visual style that matches a slate and steel aesthetic.\" src=\"{PHOTO_URL}\"/>\n<div class=\"absolute bottom-0 left-0 right-0 h-6 bg-primary/80 backdrop-blur-sm flex items-center justify-center\">\n<span class=\"font-label-caps text-label-caps text-white\">check_circle ACCESS</span>\n</div>\n</div>\n</div>\n<!-- Data Fields Grid -->\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Full Name</span>\n<span class=\"font-id-name text-id-name text-on-background\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Designation</span>\n<span class=\"font-id-role text-id-role text-primary\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Department</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Clearance</span>\n<span class=\"inline-flex items-center\">\n<span class=\"w-2 h-2 rounded-full bg-secondary mr-1\"></span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant font-bold\">LEVEL 05</span>\n</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-on-surface-variant\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Expiry</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">12 / 2028</span>\n</div>\n</div>\n<!-- QR Code Footer -->\n<div class=\"mt-auto flex justify-between items-end border-t border-outline-variant pt-4\">\n<div class=\"w-20 h-20 bg-white border border-outline-variant p-1\">\n<img alt=\"Secure QR Code\" class=\"w-full h-full grayscale\" src=\"{QR_CODE_URL}\"/>\n</div>\n<div class=\"text-right\">\n<span class=\"font-label-caps text-label-caps text-outline block\">SECURITY SIGNATURE</span>\n<div class=\"font-id-name text-primary-fixed-dim text-sm italic opacity-50\">SecureAuth-v2.1</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Subtle Bottom Bar -->\n<div class=\"h-2 bg-on-background w-full\"></div>\n</div>\n</div>",
  "css": "\n        body {\n            background-color: #f8f9ff;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            margin: 0;\n            overflow-x: hidden;\n        }\n        .card-container {\n            width: 320px;\n            height: 500px;\n            perspective: 1000px;\n        }\n        .cr80-card {\n            width: 100%;\n            height: 100%;\n            background: #ffffff;\n            border-radius: 1.25rem;\n            position: relative;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);\n            overflow: hidden;\n            border: 1px solid #c3c6d5;\n            display: flex;\n            flex-direction: column;\n        }\n        .metallic-overlay {\n            background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 50%, rgba(255,255,255,0.2) 100%);\n            pointer-events: none;\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, transparent 0%, rgba(0, 71, 171, 0.05) 45%, rgba(111, 251, 190, 0.1) 50%, rgba(0, 71, 171, 0.05) 55%, transparent 100%);\n            background-size: 200% 200%;\n            animation: shimmer 4s infinite linear;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"primary-container\": \"#0047ab\",\n                    \"on-surface-variant\": \"#434653\",\n                    \"surface-container\": \"#e6eeff\",\n                    \"surface-container-low\": \"#eff4ff\",\n                    \"primary-fixed\": \"#dae2ff\",\n                    \"on-background\": \"#121c2a\",\n                    \"secondary\": \"#006c49\",\n                    \"primary\": \"#00327d\",\n                    \"surface\": \"#f8f9ff\",\n                    \"error-container\": \"#ffdad6\",\n                    \"surface-dim\": \"#d0dbed\",\n                    \"background\": \"#f8f9ff\",\n                    \"on-secondary-fixed\": \"#002113\",\n                    \"on-primary-fixed\": \"#001946\",\n                    \"on-primary-fixed-variant\": \"#00419e\",\n                    \"surface-tint\": \"#2559bd\",\n                    \"inverse-surface\": \"#27313f\",\n                    \"on-secondary-container\": \"#00714d\",\n                    \"surface-container-lowest\": \"#ffffff\",\n                    \"on-secondary\": \"#ffffff\",\n                    \"on-primary\": \"#ffffff\",\n                    \"surface-variant\": \"#d9e3f6\",\n                    \"outline-variant\": \"#c3c6d5\",\n                    \"inverse-primary\": \"#b1c5ff\",\n                    \"primary-fixed-dim\": \"#b1c5ff\",\n                    \"on-tertiary-fixed-variant\": \"#653e00\",\n                    \"surface-bright\": \"#f8f9ff\",\n                    \"on-tertiary-fixed\": \"#2a1700\",\n                    \"secondary-container\": \"#6cf8bb\",\n                    \"tertiary-container\": \"#6e4400\",\n                    \"tertiary\": \"#4f3000\",\n                    \"on-surface\": \"#121c2a\",\n                    \"on-error-container\": \"#93000a\",\n                    \"error\": \"#ba1a1a\",\n                    \"surface-container-highest\": \"#d9e3f6\",\n                    \"on-error\": \"#ffffff\",\n                    \"on-tertiary\": \"#ffffff\",\n                    \"tertiary-fixed\": \"#ffddb8\",\n                    \"inverse-on-surface\": \"#eaf1ff\",\n                    \"on-secondary-fixed-variant\": \"#005236\",\n                    \"secondary-fixed-dim\": \"#4edea3\",\n                    \"secondary-fixed\": \"#6ffbbe\",\n                    \"outline\": \"#737784\",\n                    \"tertiary-fixed-dim\": \"#ffb95f\",\n                    \"surface-container-high\": \"#dee9fc\",\n                    \"on-tertiary-container\": \"#ffae3c\",\n                    \"on-primary-container\": \"#a5bdff\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"0.75rem\",\n                    \"photo-size-lg\": \"120px\",\n                    \"card-padding\": \"1.5rem\",\n                    \"section-margin\": \"1rem\",\n                    \"photo-size-sm\": \"80px\"\n            },\n            \"fontFamily\": {\n                    \"id-name\": [\"Hanken Grotesk\"],\n                    \"id-role\": [\"Inter\"],\n                    \"body-sm\": [\"Inter\"],\n                    \"label-caps\": [\"Inter\"],\n                    \"id-number\": [\"JetBrains Mono\"]\n            },\n            \"fontSize\": {\n                    \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                    \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                    \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }"
}