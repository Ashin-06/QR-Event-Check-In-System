{
  "name": "Slate And Steel ID",
  "html": "<!-- Main Navigation Shell -->\n<header class=\"bg-surface dark:bg-on-surface w-full top-0 sticky border-b border-outline-variant dark:border-outline flex justify-between items-center px-section-margin w-full h-16 z-50\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary-fixed\" data-icon=\"badge\">badge</span>\n<span class=\"font-id-name text-id-name text-primary dark:text-primary-fixed\">ID Registry</span>\n</div>\n<div class=\"flex items-center gap-4\">\n<div class=\"hidden md:flex gap-6 items-center\">\n<a class=\"text-primary dark:text-primary-fixed font-id-role text-id-role transition-colors duration-200\" href=\"#\">Registration</a>\n<a class=\"text-on-surface-variant dark:text-outline-variant font-id-role text-id-role hover:bg-surface-container dark:hover:bg-inverse-surface transition-colors duration-200\" href=\"#\">Templates</a>\n<a class=\"text-on-surface-variant dark:text-outline-variant font-id-role text-id-role hover:bg-surface-container dark:hover:bg-inverse-surface transition-colors duration-200\" href=\"#\">Analytics</a>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center overflow-hidden\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n</header>\n<main class=\"flex-grow flex items-center justify-center py-12 px-4\">\n<div class=\"card-container\">\n<div class=\"cr80-card\">\n<!-- Top Header: Corporate Headquarters -->\n<div class=\"bg-primary-container h-14 flex items-center justify-center relative overflow-hidden\">\n<div class=\"absolute inset-0 metallic-overlay\"></div>\n<span class=\"font-id-role text-id-role text-on-primary-container tracking-[0.2em] font-extrabold\">CORPORATE HEADQUARTERS</span>\n</div>\n<div class=\"flex flex-1 relative\">\n<!-- Left Side: Est 2024 -->\n<div class=\"w-12 bg-on-surface-variant flex items-center justify-center border-r border-outline-variant\">\n<span class=\"vertical-text font-label-caps text-label-caps text-surface-container tracking-widest rotate-180\">EST. 2024</span>\n</div>\n<!-- Main Content Canvas -->\n<div class=\"flex-1 p-6 flex flex-col gap-element-gap relative\">\n<div class=\"absolute inset-0 hologram-shimmer pointer-events-none opacity-30\"></div>\n<!-- Photo Section -->\n<div class=\"flex justify-center mb-2\">\n<div class=\"w-photo-size-lg h-[140px] border-2 border-outline-variant p-1 bg-white shadow-sm relative overflow-hidden\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional portrait of a senior executive in a dark navy blue tailored suit against a metallic gray studio background. The lighting is crisp and sophisticated, highlighting the subject's confident expression. The overall mood is authoritative and corporate, with a clean, high-contrast visual style that matches a slate and steel aesthetic.\" src=\"{PHOTO_URL}\"/>\n<div class=\"absolute bottom-0 left-0 right-0 h-6 bg-primary/80 backdrop-blur-sm flex items-center justify-center\">\n<span class=\"font-label-caps text-label-caps text-white\">check_circle ACCESS</span>\n</div>\n</div>\n</div>\n<!-- Data Fields Grid -->\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Full Name</span>\n<span class=\"font-id-name text-id-name text-on-background\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Designation</span>\n<span class=\"font-id-role text-id-role text-primary\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Department</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Clearance</span>\n<span class=\"inline-flex items-center\">\n<span class=\"w-2 h-2 rounded-full bg-secondary mr-1\"></span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant font-bold\">LEVEL 05</span>\n</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-on-surface-variant\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase\">Expiry</span>\n<span class=\"font-body-sm text-body-sm text-on-surface-variant\">12 / 2028</span>\n</div>\n</div>\n<!-- QR Code Footer -->\n<div class=\"mt-auto flex justify-between items-end border-t border-outline-variant pt-4\">\n<div class=\"w-20 h-20 bg-white border border-outline-variant p-1\">\n<img alt=\"Secure QR Code\" class=\"w-full h-full grayscale\" src=\"{QR_CODE_URL}\"/>\n</div>\n<div class=\"text-right\">\n<span class=\"font-label-caps text-label-caps text-outline block\">SECURITY SIGNATURE</span>\n<div class=\"font-id-name text-primary-fixed-dim text-sm italic opacity-50\">SecureAuth-v2.1</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Subtle Bottom Bar -->\n<div class=\"h-2 bg-on-background w-full\"></div>\n</div>\n</div>\n</main>\n<!-- Navigation Drawer (Desktop Hidden by default, showing logic) -->\n<aside class=\"hidden lg:flex fixed left-0 top-16 h-[calc(100vh-64px)] w-80 bg-surface-container-low dark:bg-on-surface shadow-md z-40 rounded-r-xl flex-col p-6 border-r border-outline-variant\">\n<div class=\"flex items-center gap-4 mb-8\">\n<div class=\"w-12 h-12 rounded-lg bg-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-white\" data-icon=\"app_registration\">app_registration</span>\n</div>\n<div>\n<h3 class=\"font-id-name text-id-name text-primary\">System Admin</h3>\n<p class=\"font-id-role text-id-role text-on-surface-variant\">Bulk Management</p>\n</div>\n</div>\n<nav class=\"flex flex-col gap-2\">\n<button class=\"flex items-center gap-3 px-4 py-3 bg-secondary-container text-on-secondary-container rounded-full transition-all active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"app_registration\">app_registration</span>\n<span class=\"font-id-role text-id-role\">Registration</span>\n</button>\n<button class=\"flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"style\">style</span>\n<span class=\"font-id-role text-id-role\">Templates</span>\n</button>\n<button class=\"flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-id-role text-id-role\">Analytics</span>\n</button>\n<button class=\"flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n<span class=\"font-id-role text-id-role\">Settings</span>\n</button>\n<button class=\"flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:bg-surface-variant rounded-full transition-all active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"help\">help</span>\n<span class=\"font-id-role text-id-role\">Help</span>\n</button>\n</nav>\n</aside>\n<!-- Mobile Bottom Navigation -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full bg-surface-container-highest dark:bg-on-surface flex justify-around p-2 border-t border-outline-variant z-50\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n<script>\n        // Micro-interaction for the card\n        const card = document.querySelector('.cr80-card');\n        const container = document.querySelector('.card-container');\n\n        container.addEventListener('mousemove', (e) => {\n            const rect = container.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            \n            const rotateX = (y - centerY) / 10;\n            const rotateY = (centerX - x) / 10;\n            \n            card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n\n        container.addEventListener('mouseleave', () => {\n            card.style.transform = 'rotateX(0deg) rotateY(0deg)';\n            card.style.transition = 'transform 0.5s ease';\n        });\n\n        container.addEventListener('mouseenter', () => {\n            card.style.transition = 'none';\n        });\n    </script>",
  "css": "\n        body {\n            background-color: #f8f9ff;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            margin: 0;\n            overflow-x: hidden;\n        }\n        .card-container {\n            width: 320px;\n            height: 500px;\n            perspective: 1000px;\n        }\n        .cr80-card {\n            width: 100%;\n            height: 100%;\n            background: #ffffff;\n            border-radius: 1.25rem;\n            position: relative;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);\n            overflow: hidden;\n            border: 1px solid #c3c6d5;\n            display: flex;\n            flex-direction: column;\n        }\n        .metallic-overlay {\n            background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 50%, rgba(255,255,255,0.2) 100%);\n            pointer-events: none;\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, transparent 0%, rgba(0, 71, 171, 0.05) 45%, rgba(111, 251, 190, 0.1) 50%, rgba(0, 71, 171, 0.05) 55%, transparent 100%);\n            background-size: 200% 200%;\n            animation: shimmer 4s infinite linear;\n        }\n        @keyframes shimmer {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}