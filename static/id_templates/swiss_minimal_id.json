{
  "name": "Swiss Minimal ID",
  "html": "<!-- Main Viewport -->\n<main class=\"flex flex-col items-center gap-12 py-12\">\n<!-- Typography Header for context -->\n<header class=\"text-center space-y-2\">\n<h1 class=\"font-id-name text-id-name text-primary uppercase tracking-widest\">ID Registry</h1>\n<p class=\"font-body-sm text-on-surface-variant\">Internal Personnel Identification / Swiss Minimal v1.0</p>\n</header>\n<!-- The ID Card (CR80 Portrait Adaptation) -->\n<div class=\"card-canvas bg-white swiss-border p-6 flex flex-col items-center relative overflow-hidden\">\n<!-- Top Label -->\n<div class=\"w-full flex justify-between items-start mb-12\">\n<span class=\"font-id-number text-[8px] uppercase tracking-tighter text-black opacity-80\">{Pass Type}</span>\n<span class=\"material-symbols-outlined text-black text-sm\" data-icon=\"badge\">badge</span>\n</div>\n<!-- Primary Content -->\n<div class=\"flex-1 w-full flex flex-col items-center justify-center space-y-8 text-center\">\n<!-- Name -->\n<div class=\"mb-4\">\n<h2 class=\"font-serif-display text-3xl text-black\">{Name}</h2>\n</div>\n<!-- Field Grid -->\n<div class=\"w-full space-y-4 px-4\">\n<!-- Field 1 -->\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-caps text-black opacity-50 mb-1\">ID</span>\n<span class=\"font-id-number text-id-number text-black\">{Registration Number}</span>\n<div class=\"hairline mt-2 opacity-20\"></div>\n</div>\n<!-- Field 2 -->\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-caps text-black opacity-50 mb-1\">DEPT</span>\n<span class=\"font-id-role text-black uppercase\">Infrastructure</span>\n<div class=\"hairline mt-2 opacity-20\"></div>\n</div>\n<!-- Field 3 -->\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-caps text-black opacity-50 mb-1\">BRANCH</span>\n<span class=\"font-id-role text-black uppercase\">{Unique ID}</span>\n<div class=\"hairline mt-2 opacity-20\"></div>\n</div>\n<!-- Field 4 -->\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-caps text-black opacity-50 mb-1\">EMAIL</span>\n<span class=\"font-body-sm text-black\">{Email Address}</span>\n<div class=\"hairline mt-2 opacity-20\"></div>\n</div>\n<!-- Field 5 -->\n<div class=\"flex flex-col items-center\">\n<span class=\"font-label-caps text-black opacity-50 mb-1\">ISSUED</span>\n<span class=\"font-id-number text-id-number text-black\">24.05.2024</span>\n</div>\n</div>\n</div>\n<!-- Bottom Section -->\n<div class=\"w-full mt-auto flex flex-col items-center space-y-4\">\n<!-- QR Code Placeholder -->\n<div class=\"w-24 h-24 swiss-border p-1 bg-white\">\n<img alt=\"QR Security Code\" class=\"w-full h-full grayscale contrast-125\" data-alt=\"A high-contrast, black and white QR code displayed on a clean white background. The image is framed by a thin, minimalist black border consistent with Swiss design principles. The lighting is perfectly flat and even, ensuring the geometric patterns of the code are sharp and easily scannable, evoking a sense of high security and technical precision.\" src=\"{QR_CODE_URL}\"/>\n</div>\n<div class=\"w-full flex justify-center\">\n<span class=\"font-id-number text-[8px] uppercase tracking-[0.2em] text-black opacity-60\">ENCRYPTED DATA</span>\n</div>\n</div>\n<!-- Subtle Texture Overlay for Physical Realism -->\n<div class=\"absolute inset-0 pointer-events-none opacity-[0.03]\" style=\"background-image: url('https://www.transparenttextures.com/patterns/pinstripe.png');\"></div>\n</div>\n<!-- Utility Footer -->\n<div class=\"flex gap-4\">\n<button class=\"bg-black text-white px-6 py-2 rounded-full font-label-caps hover:bg-neutral-800 transition-colors flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"print\">print</span>\n                PRINT PHYSICAL CARD\n            </button>\n<button class=\"border border-black text-black px-6 py-2 rounded-full font-label-caps hover:bg-neutral-100 transition-colors flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-sm\" data-icon=\"download\">download</span>\n                EXPORT PDF\n            </button>\n</div>\n</main>\n<!-- Bottom Navigation Shell (Filtered by relevance check: Task-focused sub-page) -->\n<!-- The prompt implies a specific template view, which typically functions as a \"Detail\" or \"Task\" view. \n         However, for the sake of demonstrating the predicted components, I will include the BottomNavBar \n         but set 'History' as active to represent viewing a specific record. -->\n<nav class=\"fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant shadow-lg md:hidden\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n<script>\n        // Simple interactive feedback for fields\n        document.querySelectorAll('.flex-col.items-center').forEach(field => {\n            field.addEventListener('mouseenter', () => {\n                field.style.transform = 'translateY(-2px)';\n                field.style.transition = 'transform 0.2s ease';\n            });\n            field.addEventListener('mouseleave', () => {\n                field.style.transform = 'translateY(0)';\n            });\n        });\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .card-canvas {\n            width: 320px;\n            height: 500px;\n            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);\n        }\n        .swiss-border {\n            border: 0.5px solid #000;\n        }\n        .hairline {\n            height: 0.5px;\n            background-color: #000;\n            width: 100%;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}