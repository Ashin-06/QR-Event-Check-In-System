{
  "name": "Monolith Modern ID",
  "html": "<div class=\"monolith-card bg-[#434653] relative flex overflow-hidden border-2 border-on-surface\">\n<!-- Left Side: Barcode -->\n<div class=\"w-16 h-full bg-surface-container-lowest border-r-2 border-on-surface flex flex-col items-center py-6 gap-4\">\n<div class=\"barcode-strip w-10 flex-grow opacity-90\"></div>\n<span class=\"vertical-text font-id-number text-id-number rotate-180 text-on-surface\">{Registration Number}</span>\n</div>\n<!-- Main Content Area -->\n<div class=\"flex-grow flex flex-col\">\n<!-- Top Section -->\n<div class=\"bg-on-surface text-surface-container-lowest py-3 px-6 flex justify-between items-center\">\n<span class=\"font-label-caps text-label-caps tracking-widest\">IDENTITY check_circle</span>\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"security\">security</span>\n</div>\n<div class=\"p-card-padding flex flex-col h-full justify-between\">\n<!-- Photo & Top Data -->\n<div class=\"flex flex-col gap-6\">\n<div class=\"w-full h-48 bg-surface-dim border-2 border-on-surface relative group overflow-hidden\">\n<img class=\"w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-105\" data-alt=\"A professional portrait of a man with a confident expression, set against a neutral, high-contrast studio background. The lighting is sharp and cinematic, emphasizing the structural minimalist aesthetic of the Monolith design. The overall mood is institutional and secure, featuring a muted color palette of slate grays and deep blues to maintain a high-end corporate modernist look.\" src=\"{PHOTO_URL}\"/>\n<div class=\"absolute bottom-0 right-0 bg-primary px-2 py-1 text-on-primary font-label-caps text-[8px] border-l-2 border-t-2 border-on-surface\">\n                                LVL 05 AUTHORIZED\n                            </div>\n</div>\n<!-- Data Grid (5 Fields) -->\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-2 border-t-2 border-on-surface/20 pt-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">SURNAME</span>\n<span class=\"font-id-name text-id-name text-surface-container-lowest\">{Surname}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">GIVEN NAMES</span>\n<span class=\"font-id-role text-id-role text-surface-container-lowest\">{Given Names}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">NATIONALITY</span>\n<span class=\"font-id-role text-id-role text-surface-container-lowest\">UNITED FEDERATION</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">EXPIRY DATE</span>\n<span class=\"font-id-number text-id-number text-surface-container-lowest\">2029 / 11 / 14</span>\n</div>\n<div class=\"flex flex-col col-span-2\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">CLEARANCE ID</span>\n<span class=\"font-id-number text-id-number text-primary-fixed\">{Unique ID}</span>\n</div>\n</div>\n</div>\n<!-- Footer Area with QR -->\n<div class=\"flex justify-between items-end mt-auto\">\n<div class=\"hologram-shimmer w-16 h-16 border border-on-surface/30 rounded-sm flex items-center justify-center overflow-hidden\">\n<span class=\"material-symbols-outlined text-surface-container-lowest/50 text-4xl\" data-icon=\"shield_lock\" style=\"font-variation-settings: 'FILL' 1;\">shield_lock</span>\n</div>\n<div class=\"bg-white p-2 border-2 border-on-surface\">\n<img class=\"w-16 h-16\" data-alt=\"A high-contrast black and white QR code presented as a stark graphic element. The code is crisp and functional, designed for high-security scanning environments. It is placed within a minimal white rectangular container, serving as the primary digital anchor for the identity card's brutalist aesthetic.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</div>\n</div>\n</div>",
  "css": "\n        .monolith-card {\n            width: 337.5px; /* Standard CR80 scale approx */\n            height: 531px;\n            box-shadow: 20px 20px 0px 0px rgba(18, 28, 42, 1);\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n        .barcode-strip {\n            background: repeating-linear-gradient(\n                to bottom,\n                #121c2a,\n                #121c2a 2px,\n                transparent 2px,\n                transparent 6px,\n                #121c2a 6px,\n                #121c2a 10px,\n                transparent 10px,\n                transparent 12px\n            );\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.2) 0%, rgba(255,0,255,0.2) 50%, rgba(255,221,184,0.2) 100%);\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface font-body-sm text-on-surface",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                \"primary-container\": \"#0047ab\",\n                \"on-surface-variant\": \"#434653\",\n                \"surface-container\": \"#e6eeff\",\n                \"surface-container-low\": \"#eff4ff\",\n                \"primary-fixed\": \"#dae2ff\",\n                \"on-background\": \"#121c2a\",\n                \"secondary\": \"#006c49\",\n                \"primary\": \"#00327d\",\n                \"surface\": \"#f8f9ff\",\n                \"error-container\": \"#ffdad6\",\n                \"surface-dim\": \"#d0dbed\",\n                \"background\": \"#f8f9ff\",\n                \"on-secondary-fixed\": \"#002113\",\n                \"on-primary-fixed\": \"#001946\",\n                \"on-primary-fixed-variant\": \"#00419e\",\n                \"surface-tint\": \"#2559bd\",\n                \"inverse-surface\": \"#27313f\",\n                \"on-secondary-container\": \"#00714d\",\n                \"surface-container-lowest\": \"#ffffff\",\n                \"on-secondary\": \"#ffffff\",\n                \"on-primary\": \"#ffffff\",\n                \"surface-variant\": \"#d9e3f6\",\n                \"outline-variant\": \"#c3c6d5\",\n                \"inverse-primary\": \"#b1c5ff\",\n                \"primary-fixed-dim\": \"#b1c5ff\",\n                \"on-tertiary-fixed-variant\": \"#653e00\",\n                \"surface-bright\": \"#f8f9ff\",\n                \"on-tertiary-fixed\": \"#2a1700\",\n                \"secondary-container\": \"#6cf8bb\",\n                \"tertiary-container\": \"#6e4400\",\n                \"tertiary\": \"#4f3000\",\n                \"on-surface\": \"#121c2a\",\n                \"on-error-container\": \"#93000a\",\n                \"error\": \"#ba1a1a\",\n                \"surface-container-highest\": \"#d9e3f6\",\n                \"on-error\": \"#ffffff\",\n                \"on-tertiary\": \"#ffffff\",\n                \"tertiary-fixed\": \"#ffddb8\",\n                \"inverse-on-surface\": \"#eaf1ff\",\n                \"on-secondary-fixed-variant\": \"#005236\",\n                \"secondary-fixed-dim\": \"#4edea3\",\n                \"secondary-fixed\": \"#6ffbbe\",\n                \"outline\": \"#737784\",\n                \"tertiary-fixed-dim\": \"#ffb95f\",\n                \"surface-container-high\": \"#dee9fc\",\n                \"on-tertiary-container\": \"#ffae3c\",\n                \"on-primary-container\": \"#a5bdff\"\n            },\n            \"borderRadius\": {\n                \"DEFAULT\": \"0.25rem\",\n                \"lg\": \"0.5rem\",\n                \"xl\": \"0.75rem\",\n                \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                \"element-gap\": \"0.75rem\",\n                \"photo-size-lg\": \"120px\",\n                \"card-padding\": \"1.5rem\",\n                \"section-margin\": \"1rem\",\n                \"photo-size-sm\": \"80px\"\n            },\n            \"fontFamily\": {\n                \"id-name\": [\"Hanken Grotesk\"],\n                \"id-role\": [\"Inter\"],\n                \"body-sm\": [\"Inter\"],\n                \"label-caps\": [\"Inter\"],\n                \"id-number\": [\"JetBrains Mono\"]\n            },\n            \"fontSize\": {\n                \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }"
}