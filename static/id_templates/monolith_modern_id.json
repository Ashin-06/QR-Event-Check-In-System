{
  "name": "Monolith Modern ID",
  "html": "<!-- Top AppBar Component Mapping -->\n<header class=\"bg-surface w-full top-0 sticky border-b border-outline-variant flex justify-between items-center px-section-margin fixed top-0 left-0 z-50\">\n<div class=\"flex items-center gap-2 py-4\">\n<span class=\"material-symbols-outlined text-primary\" data-icon=\"badge\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary\">ID Registry</h1>\n</div>\n<div class=\"flex items-center gap-4\">\n<nav class=\"hidden md:flex gap-6\">\n<span class=\"font-id-role text-id-role text-primary cursor-pointer transition-colors duration-200\">Registration</span>\n<span class=\"font-id-role text-id-role text-on-surface-variant hover:bg-surface-container cursor-pointer transition-colors duration-200 px-2 rounded\">Templates</span>\n<span class=\"font-id-role text-id-role text-on-surface-variant hover:bg-surface-container cursor-pointer transition-colors duration-200 px-2 rounded\">Analytics</span>\n</nav>\n<div class=\"w-10 h-10 rounded-full bg-surface-container-high border border-outline-variant flex items-center justify-center overflow-hidden\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</header>\n<main class=\"relative z-10 flex flex-col items-center gap-12 mt-20 mb-20\">\n<!-- Monolith Modern ID Card -->\n<div class=\"monolith-card bg-[#434653] relative flex overflow-hidden border-2 border-on-surface\">\n<!-- Left Side: Barcode -->\n<div class=\"w-16 h-full bg-surface-container-lowest border-r-2 border-on-surface flex flex-col items-center py-6 gap-4\">\n<div class=\"barcode-strip w-10 flex-grow opacity-90\"></div>\n<span class=\"vertical-text font-id-number text-id-number rotate-180 text-on-surface\">{Registration Number}</span>\n</div>\n<!-- Main Content Area -->\n<div class=\"flex-grow flex flex-col\">\n<!-- Top Section -->\n<div class=\"bg-on-surface text-surface-container-lowest py-3 px-6 flex justify-between items-center\">\n<span class=\"font-label-caps text-label-caps tracking-widest\">IDENTITY check_circle</span>\n<span class=\"material-symbols-outlined text-[16px]\" data-icon=\"security\">security</span>\n</div>\n<div class=\"p-card-padding flex flex-col h-full justify-between\">\n<!-- Photo & Top Data -->\n<div class=\"flex flex-col gap-6\">\n<div class=\"w-full h-48 bg-surface-dim border-2 border-on-surface relative group overflow-hidden\">\n<img class=\"w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-105\" data-alt=\"A professional portrait of a man with a confident expression, set against a neutral, high-contrast studio background. The lighting is sharp and cinematic, emphasizing the structural minimalist aesthetic of the Monolith design. The overall mood is institutional and secure, featuring a muted color palette of slate grays and deep blues to maintain a high-end corporate modernist look.\" src=\"{PHOTO_URL}\"/>\n<div class=\"absolute bottom-0 right-0 bg-primary px-2 py-1 text-on-primary font-label-caps text-[8px] border-l-2 border-t-2 border-on-surface\">\n                                LVL 05 AUTHORIZED\n                            </div>\n</div>\n<!-- Data Grid (5 Fields) -->\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-2 border-t-2 border-on-surface/20 pt-4\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">SURNAME</span>\n<span class=\"font-id-name text-id-name text-surface-container-lowest\">{Name}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">GIVEN NAMES</span>\n<span class=\"font-id-role text-id-role text-surface-container-lowest\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">NATIONALITY</span>\n<span class=\"font-id-role text-id-role text-surface-container-lowest\">UNITED FEDERATION</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">EXPIRY DATE</span>\n<span class=\"font-id-number text-id-number text-surface-container-lowest\">2029 / 11 / 14</span>\n</div>\n<div class=\"flex flex-col col-span-2\">\n<span class=\"font-label-caps text-label-caps text-surface-container-high opacity-70\">CLEARANCE ID</span>\n<span class=\"font-id-number text-id-number text-primary-fixed\">{Unique ID}</span>\n</div>\n</div>\n</div>\n<!-- Footer Area with QR -->\n<div class=\"flex justify-between items-end mt-auto\">\n<div class=\"hologram-shimmer w-16 h-16 border border-on-surface/30 rounded-sm flex items-center justify-center overflow-hidden\">\n<span class=\"material-symbols-outlined text-surface-container-lowest/50 text-4xl\" data-icon=\"shield_lock\" style=\"font-variation-settings: 'FILL' 1;\">shield_lock</span>\n</div>\n<div class=\"bg-white p-2 border-2 border-on-surface\">\n<img class=\"w-16 h-16\" data-alt=\"A high-contrast black and white QR code presented as a stark graphic element. The code is crisp and functional, designed for high-security scanning environments. It is placed within a minimal white rectangular container, serving as the primary digital anchor for the identity card's brutalist aesthetic.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Action Buttons -->\n<div class=\"flex gap-4\">\n<button class=\"bg-primary text-on-primary font-id-role text-id-role px-8 py-3 rounded-full hover:bg-primary-container transition-all active:scale-95 shadow-lg flex items-center gap-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"print\">print</span>\n                PRINT PHYSICAL\n            </button>\n<button class=\"bg-surface-container-highest text-on-surface font-id-role text-id-role px-8 py-3 rounded-full hover:bg-surface-variant transition-all active:scale-95 flex items-center gap-2\">\n<span class=\"material-symbols-outlined\" data-icon=\"share\">share</span>\n                EXPORT DIGITAL\n            </button>\n</div>\n</main>\n<!-- Bottom Navigation Component Mapping -->\n<footer class=\"md:hidden fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest border-t border-outline-variant shadow-lg z-50\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</footer>\n<!-- Background Subtle Micro-interaction -->\n<div class=\"fixed inset-0 pointer-events-none opacity-[0.03] z-0\">\n<div class=\"w-full h-full\" id=\"grid-pattern\" style=\"background-image: radial-gradient(#121c2a 1px, transparent 1px); background-size: 20px 20px;\"></div>\n</div>\n<script>\n        // Micro-interaction for the card following the mouse slightly\n        const card = document.querySelector('.monolith-card');\n        document.addEventListener('mousemove', (e) => {\n            const xAxis = (window.innerWidth / 2 - e.pageX) / 50;\n            const yAxis = (window.innerHeight / 2 - e.pageY) / 50;\n            card.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;\n        });\n\n        // Reset transform on mouse leave\n        document.addEventListener('mouseleave', () => {\n            card.style.transform = `rotateY(0deg) rotateX(0deg)`;\n        });\n    </script>",
  "css": "\n        .monolith-card {\n            width: 337.5px; /* Standard CR80 scale approx */\n            height: 531px;\n            box-shadow: 20px 20px 0px 0px rgba(18, 28, 42, 1);\n        }\n        .vertical-text {\n            writing-mode: vertical-rl;\n            text-orientation: mixed;\n        }\n        .barcode-strip {\n            background: repeating-linear-gradient(\n                to bottom,\n                #121c2a,\n                #121c2a 2px,\n                transparent 2px,\n                transparent 6px,\n                #121c2a 6px,\n                #121c2a 10px,\n                transparent 10px,\n                transparent 12px\n            );\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.2) 0%, rgba(255,0,255,0.2) 50%, rgba(255,221,184,0.2) 100%);\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}