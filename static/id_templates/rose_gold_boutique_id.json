{
  "name": "Rose Gold Boutique ID",
  "html": "<div class=\"cr80-card rounded-[24px] bg-boutique-cream shadow-2xl shadow-boutique-rose/40 border-[1px] border-boutique-gold/20 flex flex-col items-center text-center p-6 relative\">\n<!-- Background Decoration -->\n<div class=\"absolute top-0 left-0 w-full h-40 bg-gradient-to-b from-boutique-rose/50 to-transparent\"></div>\n<div class=\"absolute bottom-0 right-0 p-4 opacity-10\">\n<span class=\"material-symbols-outlined text-[100px] text-boutique-gold\">spa</span>\n</div>\n<!-- Header: Member Pass -->\n<div class=\"z-10 mt-2\">\n<h2 class=\"script-title text-[32px] text-boutique-gold leading-none\">Member Pass</h2>\n<div class=\"h-[1px] w-12 bg-boutique-gold mx-auto mt-2\"></div>\n</div>\n<!-- ID Photo Container (Tech/Creative Hybrid) -->\n<div class=\"relative mt-8 z-10\">\n<div class=\"w-32 h-32 rounded-full p-1 bg-gradient-to-tr from-boutique-gold via-white to-boutique-rose shadow-lg\">\n<div class=\"w-full h-full rounded-full overflow-hidden border-2 border-boutique-cream\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional studio portrait of a sophisticated woman with styled hair, wearing elegant cream-colored designer clothing. The lighting is soft and flattering, with a gentle rose-gold glow reflecting off the background. The aesthetic is clean, minimalist luxury, focused on high-end boutique branding with a warm, welcoming, and high-status atmosphere.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute bottom-0 right-0 bg-secondary text-on-secondary px-3 py-1 rounded-full text-[9px] font-bold tracking-widest shadow-md\">\n                        ACTIVE\n                    </div>\n</div>\n<!-- Data Fields: Bento Style / 6 fields -->\n<div class=\"mt-8 w-full grid grid-cols-2 gap-4 z-10 px-2\">\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">FULL NAME</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Name}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">MEMBER SINCE</span>\n<span class=\"font-id-role text-id-role text-on-surface\">Feb 2024</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">TIER LEVEL</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">LOCATION</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">ID NUMBER</span>\n<span class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">EXPIRY DATE</span>\n<span class=\"font-id-role text-id-role text-on-surface\">Dec 2026</span>\n</div>\n</div>\n<!-- Footer: QR Code & Exclusive Access -->\n<div class=\"mt-auto mb-4 w-full flex flex-col items-center z-10\">\n<div class=\"p-2 border-2 border-boutique-gold/30 rounded-xl mb-4 bg-white shadow-inner\">\n<div class=\"w-16 h-16 bg-white flex items-center justify-center p-1\">\n<!-- QR Code Simulated -->\n<span class=\"material-symbols-outlined text-[60px] text-on-surface\">qr_code_2</span>\n</div>\n</div>\n<p class=\"font-label-caps text-label-caps tracking-[0.2em] text-boutique-gold font-bold\">EXCLUSIVE ACCESS</p>\n</div>\n<!-- Hologram Overlay -->\n<div class=\"absolute bottom-4 right-4 w-12 h-12 rounded-full overflow-hidden opacity-30 pointer-events-none\">\n<div class=\"w-full h-full bg-gradient-to-tr from-cyan-300 via-pink-400 to-yellow-200 animate-pulse shimmer\"></div>\n</div>\n</div>",
  "css": "\n        .glass-card {\n            background: rgba(255, 255, 255, 0.7);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(197, 160, 89, 0.2);\n        }\n        .cr80-card {\n            width: 340px;\n            height: 540px;\n            position: relative;\n            overflow: hidden;\n        }\n        .shimmer {\n            background: linear-gradient(\n                90deg,\n                rgba(255,255,255,0) 0%,\n                rgba(255,255,255,0.4) 50%,\n                rgba(255,255,255,0) 100%\n            );\n            background-size: 200% 100%;\n            animation: shimmer-effect 3s infinite linear;\n        }\n        @keyframes shimmer-effect {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .script-title {\n            font-family: 'Great Vibes', cursive;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}