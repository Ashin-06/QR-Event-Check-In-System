{
  "name": "Rose Gold Boutique ID",
  "html": "<!-- Top Navigation Placeholder (Simulating Shared Component) -->\n<header class=\"w-full top-0 sticky bg-surface dark:bg-on-surface border-b border-outline-variant dark:border-outline flex justify-between items-center px-4 py-3 z-50 mb-8\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary-fixed\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary dark:text-primary-fixed\">ID Registry</h1>\n</div>\n<div class=\"h-10 w-10 rounded-full bg-surface-container overflow-hidden\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"{PHOTO_URL}\"/>\n</div>\n</header>\n<main class=\"flex flex-col items-center gap-12 w-full max-w-4xl\">\n<!-- ID CARD CONTAINER -->\n<div class=\"relative group\">\n<!-- Decorative Aura -->\n<div class=\"absolute -inset-10 bg-boutique-rose/30 blur-3xl rounded-full opacity-50 group-hover:opacity-80 transition-opacity\"></div>\n<!-- CR80 Physical Card Mockup -->\n<div class=\"cr80-card rounded-[24px] bg-boutique-cream shadow-2xl shadow-boutique-rose/40 border-[1px] border-boutique-gold/20 flex flex-col items-center text-center p-6 relative\">\n<!-- Background Decoration -->\n<div class=\"absolute top-0 left-0 w-full h-40 bg-gradient-to-b from-boutique-rose/50 to-transparent\"></div>\n<div class=\"absolute bottom-0 right-0 p-4 opacity-10\">\n<span class=\"material-symbols-outlined text-[100px] text-boutique-gold\">spa</span>\n</div>\n<!-- Header: Member Pass -->\n<div class=\"z-10 mt-2\">\n<h2 class=\"script-title text-[32px] text-boutique-gold leading-none\">Member Pass</h2>\n<div class=\"h-[1px] w-12 bg-boutique-gold mx-auto mt-2\"></div>\n</div>\n<!-- ID Photo Container (Tech/Creative Hybrid) -->\n<div class=\"relative mt-8 z-10\">\n<div class=\"w-32 h-32 rounded-full p-1 bg-gradient-to-tr from-boutique-gold via-white to-boutique-rose shadow-lg\">\n<div class=\"w-full h-full rounded-full overflow-hidden border-2 border-boutique-cream\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional studio portrait of a sophisticated woman with styled hair, wearing elegant cream-colored designer clothing. The lighting is soft and flattering, with a gentle rose-gold glow reflecting off the background. The aesthetic is clean, minimalist luxury, focused on high-end boutique branding with a warm, welcoming, and high-status atmosphere.\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Status Chip -->\n<div class=\"absolute bottom-0 right-0 bg-secondary text-on-secondary px-3 py-1 rounded-full text-[9px] font-bold tracking-widest shadow-md\">\n                        ACTIVE\n                    </div>\n</div>\n<!-- Data Fields: Bento Style / 6 fields -->\n<div class=\"mt-8 w-full grid grid-cols-2 gap-4 z-10 px-2\">\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">FULL NAME</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Name}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">MEMBER SINCE</span>\n<span class=\"font-id-role text-id-role text-on-surface\">Feb 2024</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">TIER LEVEL</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Pass Type}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">LOCATION</span>\n<span class=\"font-id-role text-id-role text-on-surface\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">ID NUMBER</span>\n<span class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col items-start border-b border-boutique-rose pb-1\">\n<span class=\"font-label-caps text-label-caps text-boutique-gold opacity-70\">EXPIRY DATE</span>\n<span class=\"font-id-role text-id-role text-on-surface\">Dec 2026</span>\n</div>\n</div>\n<!-- Footer: QR Code & Exclusive Access -->\n<div class=\"mt-auto mb-4 w-full flex flex-col items-center z-10\">\n<div class=\"p-2 border-2 border-boutique-gold/30 rounded-xl mb-4 bg-white shadow-inner\">\n<div class=\"w-16 h-16 bg-white flex items-center justify-center p-1\">\n<!-- QR Code Simulated -->\n<span class=\"material-symbols-outlined text-[60px] text-on-surface\">qr_code_2</span>\n</div>\n</div>\n<p class=\"font-label-caps text-label-caps tracking-[0.2em] text-boutique-gold font-bold\">EXCLUSIVE ACCESS</p>\n</div>\n<!-- Hologram Overlay -->\n<div class=\"absolute bottom-4 right-4 w-12 h-12 rounded-full overflow-hidden opacity-30 pointer-events-none\">\n<div class=\"w-full h-full bg-gradient-to-tr from-cyan-300 via-pink-400 to-yellow-200 animate-pulse shimmer\"></div>\n</div>\n</div>\n</div>\n<!-- Utility Sidebar / Controls (Bento Style) -->\n<section class=\"grid grid-cols-1 md:grid-cols-3 gap-6 w-full px-section-margin\">\n<!-- Details Card -->\n<div class=\"glass-card p-6 rounded-xl col-span-2\">\n<h3 class=\"font-id-name text-id-name text-primary mb-4\">Credential Details</h3>\n<div class=\"space-y-4\">\n<div class=\"flex justify-between items-center p-3 bg-white/50 rounded-lg\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-boutique-gold\">person</span>\n<span class=\"font-id-role text-id-role\">Biometric Hash check_circle</span>\n</div>\n<span class=\"material-symbols-outlined text-secondary\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n<div class=\"flex justify-between items-center p-3 bg-white/50 rounded-lg\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-boutique-gold\">history_edu</span>\n<span class=\"font-id-role text-id-role\">Smart Contract Registry</span>\n</div>\n<span class=\"material-symbols-outlined text-on-surface-variant\">arrow_forward_ios</span>\n</div>\n</div>\n</div>\n<!-- Quick Action Card -->\n<div class=\"bg-primary-container text-on-primary-container p-6 rounded-xl flex flex-col justify-between\">\n<div>\n<h3 class=\"font-id-name text-id-name mb-2\">Print Pass</h3>\n<p class=\"font-body-sm text-body-sm opacity-80\">Generate high-fidelity physical card layout with printer bleed.</p>\n</div>\n<button class=\"mt-4 bg-boutique-gold text-white font-id-role text-id-role py-3 rounded-full flex items-center justify-center gap-2 hover:bg-opacity-90 transition-all active:scale-95\">\n<span class=\"material-symbols-outlined\">local_printshop</span>\n                    Order Physical Card\n                </button>\n</div>\n</section>\n</main>\n<!-- Bottom Navigation (Mobile Only) -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest dark:bg-on-surface shadow-lg border-t border-outline-variant z-50\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2\" href=\"#\">\n<span class=\"material-symbols-outlined\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</a>\n</nav>\n<!-- Side Navigation (Desktop Only) -->\n<aside class=\"hidden md:flex fixed left-0 top-0 h-full w-20 flex-col items-center py-8 bg-surface-container-low shadow-md z-40 border-r border-outline-variant\">\n<div class=\"mb-12\">\n<span class=\"material-symbols-outlined text-boutique-gold text-3xl\">diamond</span>\n</div>\n<div class=\"flex flex-col gap-8\">\n<button class=\"p-3 rounded-xl hover:bg-surface-variant transition-colors group\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary\">app_registration</span>\n</button>\n<button class=\"p-3 rounded-xl bg-secondary-container text-on-secondary-container shadow-sm\">\n<span class=\"material-symbols-outlined\">style</span>\n</button>\n<button class=\"p-3 rounded-xl hover:bg-surface-variant transition-colors group\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary\">analytics</span>\n</button>\n<button class=\"p-3 rounded-xl hover:bg-surface-variant transition-colors group\">\n<span class=\"material-symbols-outlined text-on-surface-variant group-hover:text-primary\">settings</span>\n</button>\n</div>\n<div class=\"mt-auto\">\n<button class=\"p-3 rounded-xl hover:bg-surface-variant transition-colors\">\n<span class=\"material-symbols-outlined text-on-surface-variant\">logout</span>\n</button>\n</div>\n</aside>\n<script>\n        // Simple logic for card interactions or atmospheric effects\n        document.querySelector('.cr80-card').addEventListener('mousemove', (e) => {\n            const rect = e.currentTarget.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const rotateX = ((y - rect.height / 2) / rect.height) * 10;\n            const rotateY = ((x - rect.width / 2) / rect.width) * -10;\n            \n            e.currentTarget.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n\n        document.querySelector('.cr80-card').addEventListener('mouseleave', (e) => {\n            e.currentTarget.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n            e.currentTarget.style.transition = \"transform 0.5s ease\";\n        });\n\n        document.querySelector('.cr80-card').addEventListener('mouseenter', (e) => {\n            e.currentTarget.style.transition = \"none\";\n        });\n    </script>",
  "css": "\n        .glass-card {\n            background: rgba(255, 255, 255, 0.7);\n            backdrop-filter: blur(12px);\n            -webkit-backdrop-filter: blur(12px);\n            border: 1px solid rgba(197, 160, 89, 0.2);\n        }\n        .cr80-card {\n            width: 340px;\n            height: 540px;\n            position: relative;\n            overflow: hidden;\n        }\n        .shimmer {\n            background: linear-gradient(\n                90deg,\n                rgba(255,255,255,0) 0%,\n                rgba(255,255,255,0.4) 50%,\n                rgba(255,255,255,0) 100%\n            );\n            background-size: 200% 100%;\n            animation: shimmer-effect 3s infinite linear;\n        }\n        @keyframes shimmer-effect {\n            0% { background-position: -200% 0; }\n            100% { background-position: 200% 0; }\n        }\n        .script-title {\n            font-family: 'Great Vibes', cursive;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}