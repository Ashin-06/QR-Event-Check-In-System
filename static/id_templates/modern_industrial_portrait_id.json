{
  "name": "Modern Industrial Portrait ID",
  "html": "<!-- Main Content Canvas (ID Card Focus) -->\n<main class=\"relative\">\n<!-- Physical Card Container (Portrait CR80 Factor) -->\n<!-- Using high-contrast industrial style: sharp corners, heavy lines -->\n<div class=\"relative w-[340px] h-[540px] bg-white rounded-lg shadow-2xl overflow-hidden border-[6px] border-on-background flex flex-col\">\n<!-- Safety Orange Accent Bar -->\n<div class=\"h-14 bg-safety-orange flex items-center justify-between px-4 relative overflow-hidden shrink-0\">\n<div class=\"flex items-center gap-2 z-10\">\n<span class=\"material-symbols-outlined text-white\" style=\"font-variation-settings: 'FILL' 1;\">badge</span>\n<span class=\"font-id-name text-id-name text-white tracking-tight\">ID REGISTRY</span>\n</div>\n<!-- Watermark Text -->\n<div class=\"absolute inset-0 flex items-center justify-center opacity-20 pointer-events-none whitespace-nowrap\">\n<span class=\"font-label-caps text-[48px] font-black text-white rotate-[-5deg] select-none\">SECURITY AUTHENTICATED</span>\n</div>\n<div class=\"z-10 bg-white/20 px-2 py-1 rounded text-white font-label-caps text-[8px]\">LEVEL 04</div>\n</div>\n<!-- Body Layout: Asymmetrical Utility -->\n<div class=\"flex-1 flex relative\">\n<!-- Left Vertical Barcode Gutter -->\n<div class=\"w-12 bg-surface-container-highest border-r-2 border-on-background flex flex-col items-center justify-center gap-4 py-8 overflow-hidden\">\n<div class=\"font-id-number text-[10px] text-on-surface-variant rotate-90 whitespace-nowrap origin-center uppercase tracking-widest\">\n                        SYSTEM ACCESS SERIAL: 90210-MT\n                    </div>\n<!-- Mock Vertical Barcode -->\n<div class=\"flex flex-col gap-[2px] w-full px-2 opacity-80\">\n<div class=\"h-1 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n<div class=\"h-4 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div>\n<div class=\"h-1 bg-black w-full\"></div><div class=\"h-6 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n<div class=\"h-3 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div>\n<div class=\"h-5 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n<div class=\"h-4 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n</div>\n</div>\n<!-- Main Data Section -->\n<div class=\"flex-1 flex flex-col p-6 relative\">\n<!-- Subtle industrial background texture -->\n<div class=\"absolute inset-0 industrial-texture pointer-events-none\"></div>\n<!-- Photo Container -->\n<div class=\"relative mb-6 self-center\">\n<div class=\"w-[140px] h-[175px] border-4 border-on-background bg-surface-container-low overflow-hidden relative grayscale-[0.2] contrast-125\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional passport-style portrait of a rugged man in his late 30s with short dark hair and a serious expression. He is wearing a dark charcoal industrial utility shirt. The lighting is high-contrast studio style with soft shadows, creating a stark and authoritative corporate identification look. The background is a neutral cool gray, typical of high-security identification photography.\" src=\"{PHOTO_URL}\"/>\n<!-- Verification Overlay -->\n<div class=\"absolute bottom-0 left-0 right-0 bg-on-background/80 py-1 text-center\">\n<span class=\"font-label-caps text-white text-[9px] uppercase tracking-tighter\">check_circle BIO-MATCH</span>\n</div>\n</div>\n<!-- Photo Shadow/Industrial Accent -->\n<div class=\"absolute -bottom-2 -right-2 w-full h-full border-2 border-on-background -z-10\"></div>\n</div>\n<!-- Identity Info -->\n<div class=\"space-y-4\">\n<header>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block mb-1\">PERSONNEL NAME</label>\n<h1 class=\"font-id-name text-id-name text-on-background uppercase\">{Name}</h1>\n</header>\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-4\">\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">ASSIGNMENT</label>\n<span class=\"font-id-role text-id-role text-on-background font-bold uppercase\">{Pass Type}</span>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">ID NUMBER</label>\n<span class=\"font-id-number text-id-number text-on-background\">{Registration Number}</span>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">DEPLOYMENT SITE</label>\n<span class=\"font-id-role text-id-role text-on-background\">{Unique ID}</span>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">Pass Tier</label>\n<span class=\"font-id-role text-id-role text-error font-bold italic\">{Pass Type}</span>\n</div>\n</div>\n<div class=\"pt-2 border-t border-outline-variant\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">CONTACT &amp; CLEARANCE</label>\n<div class=\"flex flex-col\">\n<span class=\"font-body-sm text-body-sm text-on-surface\">{Email Address}</span>\n<div class=\"flex items-center gap-2 mt-1\">\n<span class=\"bg-secondary text-on-secondary font-label-caps text-[8px] px-2 py-0.5 rounded\">ACTIVE</span>\n<span class=\"font-id-number text-[10px] text-on-surface-variant uppercase\">Exp: 12 DEC 2026</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Bottom QR Section -->\n<div class=\"h-24 border-t-2 border-on-background flex items-center justify-between px-6 bg-surface-container-lowest relative\">\n<div class=\"flex flex-col gap-1\">\n<div class=\"flex gap-1\">\n<div class=\"w-4 h-4 bg-safety-orange\"></div>\n<div class=\"w-4 h-4 bg-on-background\"></div>\n<div class=\"w-4 h-4 bg-outline\"></div>\n</div>\n<span class=\"font-label-caps text-[8px] text-outline\">PROPERTY OF REGISTRY AUTHORITIES</span>\n</div>\n<div class=\"relative group\">\n<!-- QR Code Zone -->\n<div class=\"w-16 h-16 bg-white p-1 border border-outline flex items-center justify-center\">\n<img alt=\"QR Code\" class=\"w-full h-full grayscale contrast-150\" src=\"{QR_CODE_URL}\"/>\n</div>\n<!-- Digital Hologram Overlay (Bottom Right) -->\n<div class=\"absolute -top-1 -right-1 w-6 h-6 rounded-full hologram-shimmer border border-white/50 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[10px] text-on-background/40\">check_circle</span>\n</div>\n</div>\n</div>\n<!-- Magnetic Stripe Mock on Back (Visual Depth) -->\n<div class=\"absolute -z-20 top-0 left-0 w-full h-full bg-black/5 translate-x-2 translate-y-2 rounded-lg\"></div>\n</div>\n<!-- Floating UI Action Buttons (Contextual FAB Suppression) -->\n<div class=\"absolute -right-20 top-0 flex flex-col gap-4\">\n<button class=\"w-12 h-12 rounded-full bg-white shadow-lg border border-outline-variant flex items-center justify-center hover:bg-surface-variant transition-colors\" title=\"Print Hardcopy\">\n<span class=\"material-symbols-outlined text-primary\">print</span>\n</button>\n<button class=\"w-12 h-12 rounded-full bg-white shadow-lg border border-outline-variant flex items-center justify-center hover:bg-surface-variant transition-colors\" title=\"Edit Data\">\n<span class=\"material-symbols-outlined text-primary\">edit</span>\n</button>\n<button class=\"w-12 h-12 rounded-full bg-white shadow-lg border border-outline-variant flex items-center justify-center hover:bg-surface-variant transition-colors\" title=\"Export Digital\">\n<span class=\"material-symbols-outlined text-primary\">ios_share</span>\n</button>\n</div>\n</main>\n<!-- Top Navigation (Shell Implementation) -->\n<nav class=\"fixed top-0 left-0 w-full z-50 bg-surface border-b border-outline-variant px-6 h-16 flex items-center justify-between\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary text-3xl\">badge</span>\n<h2 class=\"font-id-name text-id-name text-primary uppercase\">ID Registry</h2>\n</div>\n<div class=\"hidden md:flex items-center gap-6\">\n<a class=\"font-label-caps text-on-surface-variant hover:text-primary transition-colors\" href=\"#\">Registration</a>\n<a class=\"font-label-caps text-on-surface-variant hover:text-primary transition-colors\" href=\"#\">Templates</a>\n<a class=\"font-label-caps text-on-surface-variant hover:text-primary transition-colors\" href=\"#\">Analytics</a>\n<a class=\"font-label-caps text-primary border-b-2 border-primary py-4\" href=\"#\">Card Viewer</a>\n</div>\n<div class=\"flex items-center gap-3\">\n<div class=\"text-right hidden sm:block\">\n<p class=\"font-id-role text-id-role text-on-surface leading-none\">System Admin</p>\n<p class=\"font-label-caps text-[10px] text-on-surface-variant\">Bulk Management</p>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container font-id-name\">\n                SA\n            </div>\n</div>\n</nav>\n<!-- Atmospheric Micro-interactions -->\n<script>\n        document.addEventListener('mousemove', (e) => {\n            const card = document.querySelector('.w-\\\\[340px\\\\]');\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            if (x > 0 && x < rect.width && y > 0 && y < rect.height) {\n                const rotateX = (y - rect.height / 2) / 25;\n                const rotateY = (rect.width / 2 - x) / 25;\n                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n            } else {\n                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n            }\n        });\n\n        // Add a subtle scanline effect to the photo\n        const photoContainer = document.querySelector('.w-\\\\[140px\\\\]');\n        const scanline = document.createElement('div');\n        scanline.style.position = 'absolute';\n        scanline.style.top = '0';\n        scanline.style.left = '0';\n        scanline.style.width = '100%';\n        scanline.style.height = '2px';\n        scanline.style.backgroundColor = 'rgba(255,255,255,0.2)';\n        scanline.style.boxShadow = '0 0 4px rgba(255,255,255,0.5)';\n        scanline.style.zIndex = '20';\n        photoContainer.appendChild(scanline);\n\n        let pos = 0;\n        function animateScanline() {\n            pos += 1.5;\n            if (pos > 175) pos = -10;\n            scanline.style.top = pos + 'px';\n            requestAnimationFrame(animateScanline);\n        }\n        animateScanline();\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .industrial-texture {\n            background-image: radial-gradient(#434653 0.5px, transparent 0.5px);\n            background-size: 12px 12px;\n            opacity: 0.1;\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.1) 0%, rgba(255,0,255,0.1) 50%, rgba(255,215,0,0.1) 100%);\n            mix-blend-mode: overlay;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}