{
  "name": "Modern Industrial Portrait ID",
  "html": "<div class=\"relative w-[340px] h-[540px] bg-white rounded-lg shadow-2xl overflow-hidden border-[6px] border-on-background flex flex-col\">\n<!-- Safety Orange Accent Bar -->\n<div class=\"h-14 bg-safety-orange flex items-center justify-between px-4 relative overflow-hidden shrink-0\">\n<div class=\"flex items-center gap-2 z-10\">\n<span class=\"material-symbols-outlined text-white\" style=\"font-variation-settings: 'FILL' 1;\">badge</span>\n<span class=\"font-id-name text-id-name text-white tracking-tight\">ID REGISTRY</span>\n</div>\n<!-- Watermark Text -->\n<div class=\"absolute inset-0 flex items-center justify-center opacity-20 pointer-events-none whitespace-nowrap\">\n<span class=\"font-label-caps text-[48px] font-black text-white rotate-[-5deg] select-none\">SECURITY AUTHENTICATED</span>\n</div>\n<div class=\"z-10 bg-white/20 px-2 py-1 rounded text-white font-label-caps text-[8px]\">LEVEL 04</div>\n</div>\n<!-- Body Layout: Asymmetrical Utility -->\n<div class=\"flex-1 flex relative\">\n<!-- Left Vertical Barcode Gutter -->\n<div class=\"w-12 bg-surface-container-highest border-r-2 border-on-background flex flex-col items-center justify-center gap-4 py-8 overflow-hidden\">\n<div class=\"font-id-number text-[10px] text-on-surface-variant rotate-90 whitespace-nowrap origin-center uppercase tracking-widest\">\n                        SYSTEM ACCESS SERIAL: 90210-MT\n                    </div>\n<!-- Mock Vertical Barcode -->\n<div class=\"flex flex-col gap-[2px] w-full px-2 opacity-80\">\n<div class=\"h-1 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n<div class=\"h-4 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div>\n<div class=\"h-1 bg-black w-full\"></div><div class=\"h-6 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n<div class=\"h-3 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div>\n<div class=\"h-5 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n<div class=\"h-4 bg-black w-full\"></div><div class=\"h-2 bg-black w-full\"></div><div class=\"h-1 bg-black w-full\"></div>\n</div>\n</div>\n<!-- Main Data Section -->\n<div class=\"flex-1 flex flex-col p-6 relative\">\n<!-- Subtle industrial background texture -->\n<div class=\"absolute inset-0 industrial-texture pointer-events-none\"></div>\n<!-- Photo Container -->\n<div class=\"relative mb-6 self-center\">\n<div class=\"w-[140px] h-[175px] border-4 border-on-background bg-surface-container-low overflow-hidden relative grayscale-[0.2] contrast-125\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A professional passport-style portrait of a rugged man in his late 30s with short dark hair and a serious expression. He is wearing a dark charcoal industrial utility shirt. The lighting is high-contrast studio style with soft shadows, creating a stark and authoritative corporate identification look. The background is a neutral cool gray, typical of high-security identification photography.\" src=\"{PHOTO_URL}\"/>\n<!-- Verification Overlay -->\n<div class=\"absolute bottom-0 left-0 right-0 bg-on-background/80 py-1 text-center\">\n<span class=\"font-label-caps text-white text-[9px] uppercase tracking-tighter\">check_circle BIO-MATCH</span>\n</div>\n</div>\n<!-- Photo Shadow/Industrial Accent -->\n<div class=\"absolute -bottom-2 -right-2 w-full h-full border-2 border-on-background -z-10\"></div>\n</div>\n<!-- Identity Info -->\n<div class=\"space-y-4\">\n<header>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block mb-1\">PERSONNEL NAME</label>\n<h1 class=\"font-id-name text-id-name text-on-background uppercase\">{Name}</h1>\n</header>\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-4\">\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">ASSIGNMENT</label>\n<span class=\"font-id-role text-id-role text-on-background font-bold uppercase\">{Pass Type}</span>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">ID NUMBER</label>\n<span class=\"font-id-number text-id-number text-on-background\">{Registration Number}</span>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">DEPLOYMENT SITE</label>\n<span class=\"font-id-role text-id-role text-on-background\">{Unique ID}</span>\n</div>\n<div>\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">Pass Tier</label>\n<span class=\"font-id-role text-id-role text-error font-bold italic\">{Pass Type}</span>\n</div>\n</div>\n<div class=\"pt-2 border-t border-outline-variant\">\n<label class=\"font-label-caps text-label-caps text-on-surface-variant block\">CONTACT &amp; CLEARANCE</label>\n<div class=\"flex flex-col\">\n<span class=\"font-body-sm text-body-sm text-on-surface\">{Email Address}</span>\n<div class=\"flex items-center gap-2 mt-1\">\n<span class=\"bg-secondary text-on-secondary font-label-caps text-[8px] px-2 py-0.5 rounded\">ACTIVE</span>\n<span class=\"font-id-number text-[10px] text-on-surface-variant uppercase\">Exp: 12 DEC 2026</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Bottom QR Section -->\n<div class=\"h-24 border-t-2 border-on-background flex items-center justify-between px-6 bg-surface-container-lowest relative\">\n<div class=\"flex flex-col gap-1\">\n<div class=\"flex gap-1\">\n<div class=\"w-4 h-4 bg-safety-orange\"></div>\n<div class=\"w-4 h-4 bg-on-background\"></div>\n<div class=\"w-4 h-4 bg-outline\"></div>\n</div>\n<span class=\"font-label-caps text-[8px] text-outline\">PROPERTY OF REGISTRY AUTHORITIES</span>\n</div>\n<div class=\"relative group\">\n<!-- QR Code Zone -->\n<div class=\"w-16 h-16 bg-white p-1 border border-outline flex items-center justify-center\">\n<img alt=\"QR Code\" class=\"w-full h-full grayscale contrast-150\" src=\"{QR_CODE_URL}\"/>\n</div>\n<!-- Digital Hologram Overlay (Bottom Right) -->\n<div class=\"absolute -top-1 -right-1 w-6 h-6 rounded-full hologram-shimmer border border-white/50 flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[10px] text-on-background/40\">check_circle</span>\n</div>\n</div>\n</div>\n<!-- Magnetic Stripe Mock on Back (Visual Depth) -->\n<div class=\"absolute -z-20 top-0 left-0 w-full h-full bg-black/5 translate-x-2 translate-y-2 rounded-lg\"></div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .industrial-texture {\n            background-image: radial-gradient(#434653 0.5px, transparent 0.5px);\n            background-size: 12px 12px;\n            opacity: 0.1;\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.1) 0%, rgba(255,0,255,0.1) 50%, rgba(255,215,0,0.1) 100%);\n            mix-blend-mode: overlay;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface-dim font-body-sm text-on-surface",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"on-primary-fixed-variant\": \"#00419e\",\n                    \"on-primary\": \"#ffffff\",\n                    \"surface-container-highest\": \"#d9e3f6\",\n                    \"on-background\": \"#121c2a\",\n                    \"on-primary-container\": \"#a5bdff\",\n                    \"error\": \"#ba1a1a\",\n                    \"outline\": \"#737784\",\n                    \"on-tertiary-fixed\": \"#2a1700\",\n                    \"background\": \"#f8f9ff\",\n                    \"surface-container-lowest\": \"#ffffff\",\n                    \"surface-container-high\": \"#dee9fc\",\n                    \"error-container\": \"#ffdad6\",\n                    \"surface-container-low\": \"#eff4ff\",\n                    \"secondary-fixed-dim\": \"#4edea3\",\n                    \"on-secondary\": \"#ffffff\",\n                    \"primary-fixed\": \"#dae2ff\",\n                    \"on-secondary-container\": \"#00714d\",\n                    \"surface-dim\": \"#d0dbed\",\n                    \"primary-fixed-dim\": \"#b1c5ff\",\n                    \"tertiary-fixed\": \"#ffddb8\",\n                    \"inverse-on-surface\": \"#eaf1ff\",\n                    \"on-error-container\": \"#93000a\",\n                    \"tertiary-fixed-dim\": \"#ffb95f\",\n                    \"on-tertiary-fixed-variant\": \"#653e00\",\n                    \"surface-container\": \"#e6eeff\",\n                    \"primary-container\": \"#0047ab\",\n                    \"outline-variant\": \"#c3c6d5\",\n                    \"secondary-fixed\": \"#6ffbbe\",\n                    \"inverse-surface\": \"#27313f\",\n                    \"on-surface-variant\": \"#434653\",\n                    \"on-surface\": \"#121c2a\",\n                    \"on-tertiary\": \"#ffffff\",\n                    \"on-primary-fixed\": \"#001946\",\n                    \"primary\": \"#00327d\",\n                    \"tertiary-container\": \"#6e4400\",\n                    \"on-error\": \"#ffffff\",\n                    \"surface-tint\": \"#2559bd\",\n                    \"secondary\": \"#006c49\",\n                    \"secondary-container\": \"#6cf8bb\",\n                    \"inverse-primary\": \"#b1c5ff\",\n                    \"surface-bright\": \"#f8f9ff\",\n                    \"surface\": \"#f8f9ff\",\n                    \"tertiary\": \"#4f3000\",\n                    \"surface-variant\": \"#d9e3f6\",\n                    \"on-tertiary-container\": \"#ffae3c\",\n                    \"on-secondary-fixed\": \"#002113\",\n                    \"on-secondary-fixed-variant\": \"#005236\",\n                    \"safety-orange\": \"#FF6B00\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"0.75rem\",\n                    \"photo-size-sm\": \"80px\",\n                    \"photo-size-lg\": \"120px\",\n                    \"section-margin\": \"1rem\",\n                    \"card-padding\": \"1.5rem\"\n            },\n            \"fontFamily\": {\n                    \"id-name\": [\"Hanken Grotesk\"],\n                    \"id-number\": [\"JetBrains Mono\"],\n                    \"body-sm\": [\"Inter\"],\n                    \"label-caps\": [\"Inter\"],\n                    \"id-role\": [\"Inter\"]\n            },\n            \"fontSize\": {\n                    \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                    \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}]\n            }\n          },\n        },\n      }"
}