{
  "name": "Stealth Tech Portrait ID",
  "html": "<div class=\"relative z-10 w-full max-w-[350px] aspect-[1/1.58] bg-on-surface rounded-[24px] shadow-2xl p-0.5 overflow-hidden id-card-bleed\">\n<!-- Neon Edge Accent -->\n<div class=\"absolute inset-0 border-[1px] border-secondary-fixed/30 rounded-[24px]\"></div>\n<!-- Interior Layout -->\n<div class=\"h-full w-full bg-on-surface flex flex-col p-card-padding relative overflow-hidden\">\n<!-- Stealth Tech Header Gradient -->\n<div class=\"absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-primary/20 to-transparent\"></div>\n<!-- Logo & Sector -->\n<div class=\"flex justify-between items-start z-10 mb-6\">\n<div class=\"flex items-center gap-1\">\n<div class=\"w-6 h-6 bg-secondary-fixed-dim rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-on-secondary-fixed\" data-icon=\"shield\">shield</span>\n</div>\n<span class=\"font-id-name text-on-primary tracking-widest text-[12px] uppercase\">STEALTH-TECH</span>\n</div>\n<div class=\"flex flex-col items-end\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Sector</span>\n<span class=\"font-id-role text-id-role text-on-primary\">OMEGA-9</span>\n</div>\n</div>\n<!-- Portrait Photo -->\n<div class=\"flex justify-center mb-8 relative z-10\">\n<div class=\"relative\">\n<div class=\"w-[140px] h-[140px] rounded-full p-1 bg-gradient-to-tr from-secondary-fixed via-primary-fixed-dim to-secondary-fixed neon-glow\">\n<div class=\"w-full h-full rounded-full border-4 border-on-surface overflow-hidden bg-surface-container-highest\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A cinematic portrait of a professional cybersecurity specialist with a futuristic, stealth-tech aesthetic. The individual has sharp features and is illuminated by a cool, neon blue rim light against a deep charcoal background. The image is styled as a high-security digital ID photograph with a slight glitch texture and ultra-modern finish.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n<!-- Status Chip Overlay -->\n<div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 bg-secondary-fixed text-on-secondary-fixed px-3 py-0.5 rounded-full font-label-caps text-[10px] shadow-lg border border-on-surface\">\n                            check_circle\n                        </div>\n</div>\n</div>\n<!-- User Identity -->\n<div class=\"text-center mb-8 relative z-10\">\n<h2 class=\"font-id-name text-id-name text-on-primary tracking-tight\">{Name}</h2>\n<p class=\"font-id-role text-id-role text-secondary-fixed-dim mt-1\">{Pass Type}</p>\n</div>\n<!-- Data Grid -->\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-4 mb-8 relative z-10\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-on-primary\">SK-4829-X0</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Clearance</span>\n<span class=\"font-id-number text-id-number text-on-primary font-bold\">LEVEL 5 ALPHA</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Issue Date</span>\n<span class=\"font-id-number text-id-number text-on-primary\">12 / 04 / 2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Expires</span>\n<span class=\"font-id-number text-id-number text-on-primary\">12 / 04 / 2026</span>\n</div>\n</div>\n<!-- Footer Section: QR & Contact -->\n<div class=\"mt-auto pt-4 border-t border-outline-variant/20 flex items-center justify-between z-10\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Secure Contact</span>\n<span class=\"font-id-number text-id-number text-on-primary lowercase\">k.drax@stealth.io</span>\n</div>\n<div class=\"w-16 h-16 bg-white p-1 rounded-lg shadow-inner\">\n<div class=\"w-full h-full bg-white relative\"><img alt=\"QR Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/></div>\n</div>\n</div>\n<!-- Hologram Effect (Digital) -->\n<div class=\"absolute -bottom-4 -right-4 w-24 h-24 bg-gradient-to-br from-secondary-fixed/40 via-primary/30 to-on-tertiary-container/30 blur-2xl opacity-50 rounded-full pointer-events-none\"></div>\n</div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .glass-card {\n            backdrop-filter: blur(12px);\n            background: rgba(18, 28, 42, 0.8);\n        }\n        .neon-glow {\n            box-shadow: 0 0 15px rgba(111, 251, 190, 0.4), 0 0 5px rgba(111, 251, 190, 0.2);\n        }\n        .id-card-bleed {\n            position: relative;\n            overflow: hidden;\n        }\n        .id-card-bleed::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            left: -50%;\n            width: 200%;\n            height: 200%;\n            background: radial-gradient(circle at center, transparent 30%, rgba(0, 50, 125, 0.05) 100%);\n            pointer-events: none;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-background text-on-background font-body-sm",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"on-primary-fixed-variant\": \"#00419e\",\n                    \"on-primary\": \"#ffffff\",\n                    \"surface-container-highest\": \"#d9e3f6\",\n                    \"on-background\": \"#121c2a\",\n                    \"on-primary-container\": \"#a5bdff\",\n                    \"error\": \"#ba1a1a\",\n                    \"outline\": \"#737784\",\n                    \"on-tertiary-fixed\": \"#2a1700\",\n                    \"background\": \"#f8f9ff\",\n                    \"surface-container-lowest\": \"#ffffff\",\n                    \"surface-container-high\": \"#dee9fc\",\n                    \"error-container\": \"#ffdad6\",\n                    \"surface-container-low\": \"#eff4ff\",\n                    \"secondary-fixed-dim\": \"#4edea3\",\n                    \"on-secondary\": \"#ffffff\",\n                    \"primary-fixed\": \"#dae2ff\",\n                    \"on-secondary-container\": \"#00714d\",\n                    \"surface-dim\": \"#d0dbed\",\n                    \"primary-fixed-dim\": \"#b1c5ff\",\n                    \"tertiary-fixed\": \"#ffddb8\",\n                    \"inverse-on-surface\": \"#eaf1ff\",\n                    \"on-error-container\": \"#93000a\",\n                    \"tertiary-fixed-dim\": \"#ffb95f\",\n                    \"on-tertiary-fixed-variant\": \"#653e00\",\n                    \"surface-container\": \"#e6eeff\",\n                    \"primary-container\": \"#0047ab\",\n                    \"outline-variant\": \"#c3c6d5\",\n                    \"secondary-fixed\": \"#6ffbbe\",\n                    \"inverse-surface\": \"#27313f\",\n                    \"on-surface-variant\": \"#434653\",\n                    \"on-surface\": \"#121c2a\",\n                    \"on-tertiary\": \"#ffffff\",\n                    \"on-primary-fixed\": \"#001946\",\n                    \"primary\": \"#00327d\",\n                    \"tertiary-container\": \"#6e4400\",\n                    \"on-error\": \"#ffffff\",\n                    \"surface-tint\": \"#2559bd\",\n                    \"secondary\": \"#006c49\",\n                    \"secondary-container\": \"#6cf8bb\",\n                    \"inverse-primary\": \"#b1c5ff\",\n                    \"surface-bright\": \"#f8f9ff\",\n                    \"surface\": \"#f8f9ff\",\n                    \"tertiary\": \"#4f3000\",\n                    \"surface-variant\": \"#d9e3f6\",\n                    \"on-tertiary-container\": \"#ffae3c\",\n                    \"on-secondary-fixed\": \"#002113\",\n                    \"on-secondary-fixed-variant\": \"#005236\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"0.75rem\",\n                    \"photo-size-sm\": \"80px\",\n                    \"photo-size-lg\": \"120px\",\n                    \"section-margin\": \"1rem\",\n                    \"card-padding\": \"1.5rem\"\n            },\n            \"fontFamily\": {\n                    \"id-name\": [\"Hanken Grotesk\"],\n                    \"id-number\": [\"JetBrains Mono\"],\n                    \"body-sm\": [\"Inter\"],\n                    \"label-caps\": [\"Inter\"],\n                    \"id-role\": [\"Inter\"]\n            },\n            \"fontSize\": {\n                    \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                    \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}]\n            }\n          },\n        },\n      }"
}