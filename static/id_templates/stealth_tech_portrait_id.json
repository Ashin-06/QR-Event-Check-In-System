{
  "name": "Stealth Tech Portrait ID",
  "html": "<!-- Top Navigation -->\n<header class=\"bg-surface dark:bg-on-surface text-primary dark:text-primary-fixed font-id-name text-id-name w-full top-0 sticky border-b border-outline-variant dark:border-outline flat no shadows transition-colors duration-200 flex justify-between items-center px-section-margin h-16 z-50\">\n<div class=\"flex items-center gap-2\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary-fixed\" data-icon=\"badge\">badge</span>\n<span class=\"font-id-name text-id-name text-primary dark:text-primary-fixed\">ID Registry</span>\n</div>\n<div class=\"flex items-center gap-4\">\n<nav class=\"hidden md:flex items-center gap-6\">\n<a class=\"text-primary dark:text-primary-fixed hover:bg-surface-container dark:hover:bg-inverse-surface px-3 py-2 rounded-lg transition-colors\" href=\"#\">Registration</a>\n<a class=\"text-on-surface-variant dark:text-outline-variant hover:bg-surface-container dark:hover:bg-inverse-surface px-3 py-2 rounded-lg transition-colors\" href=\"#\">Templates</a>\n<a class=\"text-on-surface-variant dark:text-outline-variant hover:bg-surface-container dark:hover:bg-inverse-surface px-3 py-2 rounded-lg transition-colors\" href=\"#\">Analytics</a>\n</nav>\n<div class=\"w-10 h-10 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container overflow-hidden border-2 border-primary\">\n<img alt=\"User Profile\" class=\"w-full h-full object-cover\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</header>\n<main class=\"flex-grow flex items-center justify-center p-6 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-surface-container-high via-background to-background relative overflow-hidden\">\n<!-- Background Decorative Element -->\n<div class=\"absolute inset-0 z-0\">\n\n</div>\n<!-- ID Card Container -->\n<div class=\"relative z-10 w-full max-w-[350px] aspect-[1/1.58] bg-on-surface rounded-[24px] shadow-2xl p-0.5 overflow-hidden id-card-bleed\">\n<!-- Neon Edge Accent -->\n<div class=\"absolute inset-0 border-[1px] border-secondary-fixed/30 rounded-[24px]\"></div>\n<!-- Interior Layout -->\n<div class=\"h-full w-full bg-on-surface flex flex-col p-card-padding relative overflow-hidden\">\n<!-- Stealth Tech Header Gradient -->\n<div class=\"absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-primary/20 to-transparent\"></div>\n<!-- Logo & Sector -->\n<div class=\"flex justify-between items-start z-10 mb-6\">\n<div class=\"flex items-center gap-1\">\n<div class=\"w-6 h-6 bg-secondary-fixed-dim rounded-full flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[14px] text-on-secondary-fixed\" data-icon=\"shield\">shield</span>\n</div>\n<span class=\"font-id-name text-on-primary tracking-widest text-[12px] uppercase\">STEALTH-TECH</span>\n</div>\n<div class=\"flex flex-col items-end\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Sector</span>\n<span class=\"font-id-role text-id-role text-on-primary\">OMEGA-9</span>\n</div>\n</div>\n<!-- Portrait Photo -->\n<div class=\"flex justify-center mb-8 relative z-10\">\n<div class=\"relative\">\n<div class=\"w-[140px] h-[140px] rounded-full p-1 bg-gradient-to-tr from-secondary-fixed via-primary-fixed-dim to-secondary-fixed neon-glow\">\n<div class=\"w-full h-full rounded-full border-4 border-on-surface overflow-hidden bg-surface-container-highest\">\n<img class=\"w-full h-full object-cover\" data-alt=\"A cinematic portrait of a professional cybersecurity specialist with a futuristic, stealth-tech aesthetic. The individual has sharp features and is illuminated by a cool, neon blue rim light against a deep charcoal background. The image is styled as a high-security digital ID photograph with a slight glitch texture and ultra-modern finish.\" src=\"{PHOTO_URL}\"/>\n</div>\n</div>\n<!-- Status Chip Overlay -->\n<div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 bg-secondary-fixed text-on-secondary-fixed px-3 py-0.5 rounded-full font-label-caps text-[10px] shadow-lg border border-on-surface\">\n                            check_circle\n                        </div>\n</div>\n</div>\n<!-- User Identity -->\n<div class=\"text-center mb-8 relative z-10\">\n<h2 class=\"font-id-name text-id-name text-on-primary tracking-tight\">{Name}</h2>\n<p class=\"font-id-role text-id-role text-secondary-fixed-dim mt-1\">{Pass Type}</p>\n</div>\n<!-- Data Grid -->\n<div class=\"grid grid-cols-2 gap-y-4 gap-x-4 mb-8 relative z-10\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">ID Number</span>\n<span class=\"font-id-number text-id-number text-on-primary\">SK-4829-X0</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Clearance</span>\n<span class=\"font-id-number text-id-number text-on-primary font-bold\">LEVEL 5 ALPHA</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Issue Date</span>\n<span class=\"font-id-number text-id-number text-on-primary\">12 / 04 / 2024</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Expires</span>\n<span class=\"font-id-number text-id-number text-on-primary\">12 / 04 / 2026</span>\n</div>\n</div>\n<!-- Footer Section: QR & Contact -->\n<div class=\"mt-auto pt-4 border-t border-outline-variant/20 flex items-center justify-between z-10\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-outline-variant uppercase\">Secure Contact</span>\n<span class=\"font-id-number text-id-number text-on-primary lowercase\">k.drax@stealth.io</span>\n</div>\n<div class=\"w-16 h-16 bg-white p-1 rounded-lg shadow-inner\">\n<div class=\"w-full h-full bg-white relative\">\n<!-- QR Code Mockup -->\n<div class=\"absolute inset-0 grid grid-cols-4 grid-rows-4 gap-0.5\">\n<div class=\"bg-on-surface col-span-1 row-span-1\"></div>\n<div class=\"bg-on-surface col-start-4\"></div>\n<div class=\"bg-on-surface row-start-4\"></div>\n<div class=\"bg-on-surface col-start-2 row-start-2 col-span-2 row-span-2\"></div>\n<div class=\"bg-on-surface col-start-4 row-start-4\"></div>\n<div class=\"bg-on-surface col-start-3 row-start-1\"></div>\n<div class=\"bg-on-surface col-start-1 row-start-3\"></div>\n</div>\n</div>\n</div>\n</div>\n<!-- Hologram Effect (Digital) -->\n<div class=\"absolute -bottom-4 -right-4 w-24 h-24 bg-gradient-to-br from-secondary-fixed/40 via-primary/30 to-on-tertiary-container/30 blur-2xl opacity-50 rounded-full pointer-events-none\"></div>\n</div>\n</div>\n</main>\n<!-- Mobile Navigation Bar -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full flex justify-around p-2 bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant shadow-lg z-50\">\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</div>\n<div class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</div>\n<div class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</div>\n</nav>\n<!-- Floating Action Button - Supressed for Detail view but included for logic demo -->\n<!-- (Normally hidden on Detail pages per rules) -->\n<script>\n        // Micro-interaction for ID Card hover\n        const card = document.querySelector('.id-card-bleed');\n        if (card) {\n            card.addEventListener('mousemove', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                \n                const centerX = rect.width / 2;\n                const centerY = rect.height / 2;\n                \n                const rotateX = (y - centerY) / 20;\n                const rotateY = (centerX - x) / 20;\n                \n                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n            });\n            \n            card.addEventListener('mouseleave', () => {\n                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;\n                card.style.transition = 'transform 0.5s ease';\n            });\n\n            card.addEventListener('mouseenter', () => {\n                card.style.transition = 'none';\n            });\n        }\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .glass-card {\n            backdrop-filter: blur(12px);\n            background: rgba(18, 28, 42, 0.8);\n        }\n        .neon-glow {\n            box-shadow: 0 0 15px rgba(111, 251, 190, 0.4), 0 0 5px rgba(111, 251, 190, 0.2);\n        }\n        .id-card-bleed {\n            position: relative;\n            overflow: hidden;\n        }\n        .id-card-bleed::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            left: -50%;\n            width: 200%;\n            height: 200%;\n            background: radial-gradient(circle at center, transparent 30%, rgba(0, 50, 125, 0.05) 100%);\n            pointer-events: none;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}