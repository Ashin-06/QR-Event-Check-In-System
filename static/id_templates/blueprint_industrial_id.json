{
  "name": "Blueprint Industrial ID",
  "html": "<!-- Primary ID Card Canvas (CR80 Portrait) -->\n<div class=\"relative w-[340px] h-[540px] blueprint-grid rounded-lg shadow-2xl overflow-hidden flex flex-col border-4 border-on-background\">\n<!-- Header Section -->\n<div class=\"bg-on-background text-primary-fixed p-4 flex justify-between items-center z-10\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps opacity-70\">AUTH_LEVEL_04</span>\n<h1 class=\"font-id-name text-id-name tracking-widest uppercase\">{Pass Type}</h1>\n</div>\n<span class=\"material-symbols-outlined text-primary-fixed text-3xl\">badge</span>\n</div>\n<!-- Main Content Area -->\n<div class=\"flex-grow p-6 flex flex-col relative\">\n<!-- Background Decorative Schematics -->\n<div class=\"absolute inset-0 opacity-10 pointer-events-none p-4\">\n<div class=\"w-full h-full border border-dashed border-white rounded flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-9xl\">settings_input_component</span>\n</div>\n</div>\n<!-- Data Fields Grid (Monospace Industrial Utility) -->\n<div class=\"grid grid-cols-1 gap-4 mt-4 z-10\">\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">ID_SERIAL_NUMBER</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">{Registration Number}</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">CLEARANCE_CODE</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">{Unique ID}</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">ISSUE_DATE</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">2024-OCT-12</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">EXPIRY_DATE</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">2029-OCT-11</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">FACILITY_ACCESS</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">HANGER_14 / LAB_B</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">EMERGENCY_PROT</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">PR_CODE_DELTA</p>\n</div>\n</div>\n<!-- Bottom QR / Schematic Box -->\n<div class=\"mt-auto mb-2 flex items-end justify-between\">\n<div class=\"w-24 h-24 bg-white p-1 rounded-sm schematic-border group relative overflow-hidden\">\n<!-- Placeholder QR logic using CSS/HTML for scanning reliability -->\n<div class=\"w-full h-full grid grid-cols-8 grid-rows-8 gap-0.5 opacity-90\">\n<div class=\"bg-black col-span-2 row-span-2\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div><div class=\"bg-black col-span-2 row-span-2\"></div>\n<div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div>\n<div class=\"bg-black\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div>\n<div class=\"bg-black col-span-2 row-span-2\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div><div class=\"bg-white\"></div><div class=\"bg-black\"></div>\n</div>\n<!-- Schematic Overlays -->\n<div class=\"corner-mark top-0 left-0 border-t border-l\"></div>\n<div class=\"corner-mark top-0 right-0 border-t border-r\"></div>\n<div class=\"corner-mark bottom-0 left-0 border-b border-l\"></div>\n<div class=\"corner-mark bottom-0 right-0 border-b border-r\"></div>\n</div>\n<div class=\"flex flex-col text-right\">\n<div class=\"crosshair -top-4 -right-4\"></div>\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">VERIFICATION_SCAN</p>\n<p class=\"font-id-number text-id-number text-white text-[10px]\">SCN_READY:0101</p>\n</div>\n</div>\n</div>\n<!-- Footer Section -->\n<div class=\"bg-on-background text-primary-fixed p-3 text-center border-t border-outline\">\n<h2 class=\"font-id-role text-id-role tracking-[0.2em] uppercase font-bold text-primary-fixed\">ENGINEERING DIVISION</h2>\n</div>\n<!-- Decorative Measurement Marks -->\n<div class=\"absolute right-0 top-1/2 -translate-y-1/2 h-32 w-1 flex flex-col justify-between items-center\">\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n</div>\n</div>\n<!-- UI Interaction Script -->\n<script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const card = document.querySelector('.blueprint-grid');\n            \n            // Subtle hover effect to simulate a digital screen shine\n            card.addEventListener('mousemove', (e) => {\n                const rect = card.getBoundingClientRect();\n                const x = e.clientX - rect.left;\n                const y = e.clientY - rect.top;\n                \n                card.style.background = `\n                    radial-gradient(circle at ${x}px ${y}px, rgba(255,255,255,0.08) 0%, transparent 60%),\n                    linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),\n                    linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px),\n                    #00327d`;\n                card.style.backgroundSize = `auto, 20px 20px, 20px 20px, auto`;\n            });\n\n            card.addEventListener('mouseleave', () => {\n                card.style.background = '';\n            });\n        });\n    </script>",
  "css": "\n        .blueprint-grid {\n            background-color: #00327d;\n            background-image: \n                linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);\n            background-size: 20px 20px;\n        }\n        .schematic-border {\n            border: 2px solid rgba(255, 255, 255, 0.4);\n            position: relative;\n        }\n        .schematic-border::before {\n            content: '';\n            position: absolute;\n            top: -5px;\n            left: -5px;\n            right: -5px;\n            bottom: -5px;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            pointer-events: none;\n        }\n        .corner-mark {\n            width: 10px;\n            height: 10px;\n            border-color: #ffffff;\n            position: absolute;\n        }\n        .crosshair {\n            position: absolute;\n            width: 20px;\n            height: 20px;\n        }\n        .crosshair::before, .crosshair::after {\n            content: '';\n            position: absolute;\n            background: rgba(255, 255, 255, 0.5);\n        }\n        .crosshair::before { width: 100%; height: 1px; top: 50%; left: 0; }\n        .crosshair::after { height: 100%; width: 1px; left: 50%; top: 0; }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}