{
  "name": "Blueprint Industrial ID",
  "html": "<div class=\"relative w-[340px] h-[540px] blueprint-grid rounded-lg shadow-2xl overflow-hidden flex flex-col border-4 border-on-background\">\n<!-- Header Section -->\n<div class=\"bg-on-background text-primary-fixed p-4 flex justify-between items-center z-10\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps opacity-70\">AUTH_LEVEL_04</span>\n<h1 class=\"font-id-name text-id-name tracking-widest uppercase\">{Pass Type}</h1>\n</div>\n<span class=\"material-symbols-outlined text-primary-fixed text-3xl\">badge</span>\n</div>\n<!-- Main Content Area -->\n<div class=\"flex-grow p-6 flex flex-col relative\">\n<!-- Background Decorative Schematics -->\n<div class=\"absolute inset-0 opacity-10 pointer-events-none p-4\">\n<div class=\"w-full h-full border border-dashed border-white rounded flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-9xl\">settings_input_component</span>\n</div>\n</div>\n<!-- Data Fields Grid (Monospace Industrial Utility) -->\n<div class=\"grid grid-cols-1 gap-4 mt-4 z-10\">\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">ID_SERIAL_NUMBER</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">{Registration Number}</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">CLEARANCE_CODE</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">{Unique ID}</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">ISSUE_DATE</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">2024-OCT-12</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">EXPIRY_DATE</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">2029-OCT-11</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">FACILITY_ACCESS</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">HANGER_14 / LAB_B</p>\n</div>\n<div class=\"border-l-2 border-primary-fixed pl-3 py-1\">\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">EMERGENCY_PROT</p>\n<p class=\"font-id-number text-id-number text-white uppercase tracking-wider\">PR_CODE_DELTA</p>\n</div>\n</div>\n<!-- Bottom QR / Schematic Box -->\n<div class=\"mt-auto mb-2 flex items-end justify-between\">\n<div class=\"w-24 h-24 bg-white p-1 rounded-sm schematic-border group relative overflow-hidden\"><img alt=\"QR Code\" class=\"w-full h-full object-contain\" src=\"{QR_CODE_URL}\"/></div>\n<div class=\"flex flex-col text-right\">\n<div class=\"crosshair -top-4 -right-4\"></div>\n<p class=\"font-label-caps text-label-caps text-primary-fixed opacity-60\">VERIFICATION_SCAN</p>\n<p class=\"font-id-number text-id-number text-white text-[10px]\">SCN_READY:0101</p>\n</div>\n</div>\n</div>\n<!-- Footer Section -->\n<div class=\"bg-on-background text-primary-fixed p-3 text-center border-t border-outline\">\n<h2 class=\"font-id-role text-id-role tracking-[0.2em] uppercase font-bold text-primary-fixed\">ENGINEERING DIVISION</h2>\n</div>\n<!-- Decorative Measurement Marks -->\n<div class=\"absolute right-0 top-1/2 -translate-y-1/2 h-32 w-1 flex flex-col justify-between items-center\">\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n<div class=\"w-full h-[1px] bg-white opacity-40\"></div>\n</div>\n</div>",
  "css": "\n        .blueprint-grid {\n            background-color: #00327d;\n            background-image: \n                linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),\n                linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);\n            background-size: 20px 20px;\n        }\n        .schematic-border {\n            border: 2px solid rgba(255, 255, 255, 0.4);\n            position: relative;\n        }\n        .schematic-border::before {\n            content: '';\n            position: absolute;\n            top: -5px;\n            left: -5px;\n            right: -5px;\n            bottom: -5px;\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            pointer-events: none;\n        }\n        .corner-mark {\n            width: 10px;\n            height: 10px;\n            border-color: #ffffff;\n            position: absolute;\n        }\n        .crosshair {\n            position: absolute;\n            width: 20px;\n            height: 20px;\n        }\n        .crosshair::before, .crosshair::after {\n            content: '';\n            position: absolute;\n            background: rgba(255, 255, 255, 0.5);\n        }\n        .crosshair::before { width: 100%; height: 1px; top: 50%; left: 0; }\n        .crosshair::after { height: 100%; width: 1px; left: 50%; top: 0; }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface-dim",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"primary-container\": \"#0047ab\",\n                    \"on-surface-variant\": \"#434653\",\n                    \"surface-container\": \"#e6eeff\",\n                    \"surface-container-low\": \"#eff4ff\",\n                    \"primary-fixed\": \"#dae2ff\",\n                    \"on-background\": \"#121c2a\",\n                    \"secondary\": \"#006c49\",\n                    \"primary\": \"#00327d\",\n                    \"surface\": \"#f8f9ff\",\n                    \"error-container\": \"#ffdad6\",\n                    \"surface-dim\": \"#d0dbed\",\n                    \"background\": \"#f8f9ff\",\n                    \"on-secondary-fixed\": \"#002113\",\n                    \"on-primary-fixed\": \"#001946\",\n                    \"on-primary-fixed-variant\": \"#00419e\",\n                    \"surface-tint\": \"#2559bd\",\n                    \"inverse-surface\": \"#27313f\",\n                    \"on-secondary-container\": \"#00714d\",\n                    \"surface-container-lowest\": \"#ffffff\",\n                    \"on-secondary\": \"#ffffff\",\n                    \"on-primary\": \"#ffffff\",\n                    \"surface-variant\": \"#d9e3f6\",\n                    \"outline-variant\": \"#c3c6d5\",\n                    \"inverse-primary\": \"#b1c5ff\",\n                    \"primary-fixed-dim\": \"#b1c5ff\",\n                    \"on-tertiary-fixed-variant\": \"#653e00\",\n                    \"surface-bright\": \"#f8f9ff\",\n                    \"on-tertiary-fixed\": \"#2a1700\",\n                    \"secondary-container\": \"#6cf8bb\",\n                    \"tertiary-container\": \"#6e4400\",\n                    \"tertiary\": \"#4f3000\",\n                    \"on-surface\": \"#121c2a\",\n                    \"on-error-container\": \"#93000a\",\n                    \"error\": \"#ba1a1a\",\n                    \"surface-container-highest\": \"#d9e3f6\",\n                    \"on-error\": \"#ffffff\",\n                    \"on-tertiary\": \"#ffffff\",\n                    \"tertiary-fixed\": \"#ffddb8\",\n                    \"inverse-on-surface\": \"#eaf1ff\",\n                    \"on-secondary-fixed-variant\": \"#005236\",\n                    \"secondary-fixed-dim\": \"#4edea3\",\n                    \"secondary-fixed\": \"#6ffbbe\",\n                    \"outline\": \"#737784\",\n                    \"tertiary-fixed-dim\": \"#ffb95f\",\n                    \"surface-container-high\": \"#dee9fc\",\n                    \"on-tertiary-container\": \"#ffae3c\",\n                    \"on-primary-container\": \"#a5bdff\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"0.75rem\",\n                    \"photo-size-lg\": \"120px\",\n                    \"card-padding\": \"1.5rem\",\n                    \"section-margin\": \"1rem\",\n                    \"photo-size-sm\": \"80px\"\n            },\n            \"fontFamily\": {\n                    \"id-name\": [\"Hanken Grotesk\"],\n                    \"id-role\": [\"Inter\"],\n                    \"body-sm\": [\"Inter\"],\n                    \"label-caps\": [\"Inter\"],\n                    \"id-number\": [\"JetBrains Mono\"]\n            },\n            \"fontSize\": {\n                    \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                    \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                    \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }"
}