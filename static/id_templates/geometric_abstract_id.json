{
  "name": "Geometric Abstract ID",
  "html": "<div class=\"cr80-card bg-surface-container-lowest rounded-[24px] shadow-2xl flex flex-col relative border border-outline-variant/30 transform transition-transform hover:rotate-y-6 hover:rotate-x-2 duration-500 group\">\n<!-- Geometric Background Patterns (Side Circles) -->\n<div class=\"absolute inset-0 pointer-events-none overflow-hidden\">\n<div class=\"absolute -left-20 top-1/4 w-48 h-48 rounded-full bg-primary-container opacity-20 blur-xl\"></div>\n<div class=\"absolute -left-10 top-1/3 w-32 h-32 rounded-full bg-secondary-container opacity-30 mix-blend-multiply\"></div>\n<div class=\"absolute -left-5 top-1/2 w-24 h-24 rounded-full bg-tertiary-fixed opacity-40 border-4 border-white/50\"></div>\n<div class=\"absolute -right-10 bottom-1/4 w-40 h-40 rounded-full bg-primary-container/10\"></div>\n</div>\n<!-- Header Section -->\n<div class=\"pt-8 px-8 relative z-10\">\n<div class=\"flex justify-between items-start\">\n<div class=\"space-y-1\">\n<h3 class=\"font-id-name text-id-name text-primary uppercase tracking-tighter leading-none\">INNOVATION LAB</h3>\n<p class=\"font-label-caps text-[8px] text-on-surface-variant/70 tracking-[0.2em]\">PRECISION · RESEARCH · FUTURE</p>\n</div>\n<div class=\"w-12 h-12 flex items-center justify-center bg-primary text-white rounded-xl shadow-lg\">\n<span class=\"material-symbols-outlined text-3xl\" data-icon=\"biotech\">biotech</span>\n</div>\n</div>\n</div>\n<!-- Main Identity Content -->\n<div class=\"mt-8 px-8 flex-grow relative z-10\">\n<!-- Dynamic Grid of 7 Data Fields -->\n<div class=\"grid grid-cols-2 gap-x-6 gap-y-5\">\n<div class=\"col-span-2\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">{Pass Type}</label>\n<span class=\"font-id-name text-[22px] text-on-background block border-b-2 border-primary-container/20 pb-1\">{Name}</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Clearance</label>\n<div class=\"bg-primary text-white px-3 py-1 rounded-full w-fit font-id-number text-[10px] tracking-widest\">LEVEL 09</div>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">ID Serial</label>\n<span class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Department</label>\n<span class=\"font-id-role text-id-role text-on-surface-variant font-bold\">{Unique ID}</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Assigned</label>\n<span class=\"font-id-role text-id-role text-on-surface-variant font-bold\">Jan 2024</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Location</label>\n<span class=\"font-id-role text-id-role text-on-surface-variant font-bold\">Silo A-4</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Status</label>\n<span class=\"font-id-role text-id-role text-secondary font-bold flex items-center gap-1\">\n<span class=\"w-2 h-2 rounded-full bg-secondary\"></span>\n                                ACTIVE\n                            </span>\n</div>\n</div>\n<!-- Integrated QR Code in Circle -->\n<div class=\"mt-12 flex justify-center\">\n<div class=\"relative\">\n<!-- Geometric background for QR -->\n<div class=\"absolute inset-0 bg-primary-container rounded-full scale-125 opacity-10\"></div>\n<div class=\"absolute -top-4 -right-4 w-12 h-12 rounded-full bg-secondary-container/30\"></div>\n<div class=\"relative w-32 h-32 bg-white p-3 rounded-2xl shadow-xl border border-outline-variant/30 flex items-center justify-center\">\n<img alt=\"QR Code\" class=\"w-full h-full opacity-90\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</div>\n</div>\n<!-- Footer Section -->\n<div class=\"h-20 bg-primary-container relative z-10 flex items-center justify-center overflow-hidden\">\n<!-- Shimmer overlay -->\n<div class=\"hologram-shimmer absolute inset-0 opacity-40\"></div>\n<div class=\"relative flex flex-col items-center\">\n<h4 class=\"font-id-name text-on-primary-container text-sm font-bold tracking-widest uppercase\">Global Tech Summit 2024</h4>\n<div class=\"flex gap-2 mt-1\">\n<div class=\"w-1.5 h-1.5 rounded-full bg-secondary-fixed\"></div>\n<div class=\"w-1.5 h-1.5 rounded-full bg-secondary-fixed/50\"></div>\n<div class=\"w-1.5 h-1.5 rounded-full bg-secondary-fixed/20\"></div>\n</div>\n</div>\n<!-- Digital Hologram (Shared Token) -->\n<div class=\"absolute bottom-2 right-4 opacity-30\">\n<span class=\"material-symbols-outlined text-4xl text-white\" data-icon=\"check_circle\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n</div>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .card-perspective {\n            perspective: 1000px;\n        }\n        .cr80-card {\n            width: 337.5px; /* Proportionally scaled CR80 ratio */\n            height: 531px;\n            overflow: hidden;\n            position: relative;\n        }\n        .glass-effect {\n            background: rgba(255, 255, 255, 0.4);\n            backdrop-filter: blur(8px);\n            border: 1px solid rgba(255, 255, 255, 0.3);\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.2) 0%, rgba(255,0,255,0.2) 50%, rgba(255,221,0,0.2) 100%);\n            mix-blend-mode: overlay;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  ",
  "body_class": "bg-surface-container-low font-body-sm text-on-surface",
  "tailwind_config": "{\n        darkMode: \"class\",\n        theme: {\n          extend: {\n            \"colors\": {\n                    \"primary-container\": \"#0047ab\",\n                    \"on-surface-variant\": \"#434653\",\n                    \"surface-container\": \"#e6eeff\",\n                    \"surface-container-low\": \"#eff4ff\",\n                    \"primary-fixed\": \"#dae2ff\",\n                    \"on-background\": \"#121c2a\",\n                    \"secondary\": \"#006c49\",\n                    \"primary\": \"#00327d\",\n                    \"surface\": \"#f8f9ff\",\n                    \"error-container\": \"#ffdad6\",\n                    \"surface-dim\": \"#d0dbed\",\n                    \"background\": \"#f8f9ff\",\n                    \"on-secondary-fixed\": \"#002113\",\n                    \"on-primary-fixed\": \"#001946\",\n                    \"on-primary-fixed-variant\": \"#00419e\",\n                    \"surface-tint\": \"#2559bd\",\n                    \"inverse-surface\": \"#27313f\",\n                    \"on-secondary-container\": \"#00714d\",\n                    \"surface-container-lowest\": \"#ffffff\",\n                    \"on-secondary\": \"#ffffff\",\n                    \"on-primary\": \"#ffffff\",\n                    \"surface-variant\": \"#d9e3f6\",\n                    \"outline-variant\": \"#c3c6d5\",\n                    \"inverse-primary\": \"#b1c5ff\",\n                    \"primary-fixed-dim\": \"#b1c5ff\",\n                    \"on-tertiary-fixed-variant\": \"#653e00\",\n                    \"surface-bright\": \"#f8f9ff\",\n                    \"on-tertiary-fixed\": \"#2a1700\",\n                    \"secondary-container\": \"#6cf8bb\",\n                    \"tertiary-container\": \"#6e4400\",\n                    \"tertiary\": \"#4f3000\",\n                    \"on-surface\": \"#121c2a\",\n                    \"on-error-container\": \"#93000a\",\n                    \"error\": \"#ba1a1a\",\n                    \"surface-container-highest\": \"#d9e3f6\",\n                    \"on-error\": \"#ffffff\",\n                    \"on-tertiary\": \"#ffffff\",\n                    \"tertiary-fixed\": \"#ffddb8\",\n                    \"inverse-on-surface\": \"#eaf1ff\",\n                    \"on-secondary-fixed-variant\": \"#005236\",\n                    \"secondary-fixed-dim\": \"#4edea3\",\n                    \"secondary-fixed\": \"#6ffbbe\",\n                    \"outline\": \"#737784\",\n                    \"tertiary-fixed-dim\": \"#ffb95f\",\n                    \"surface-container-high\": \"#dee9fc\",\n                    \"on-tertiary-container\": \"#ffae3c\",\n                    \"on-primary-container\": \"#a5bdff\"\n            },\n            \"borderRadius\": {\n                    \"DEFAULT\": \"0.25rem\",\n                    \"lg\": \"0.5rem\",\n                    \"xl\": \"0.75rem\",\n                    \"full\": \"9999px\"\n            },\n            \"spacing\": {\n                    \"element-gap\": \"0.75rem\",\n                    \"photo-size-lg\": \"120px\",\n                    \"card-padding\": \"1.5rem\",\n                    \"section-margin\": \"1rem\",\n                    \"photo-size-sm\": \"80px\"\n            },\n            \"fontFamily\": {\n                    \"id-name\": [\"Hanken Grotesk\"],\n                    \"id-role\": [\"Inter\"],\n                    \"body-sm\": [\"Inter\"],\n                    \"label-caps\": [\"Inter\"],\n                    \"id-number\": [\"JetBrains Mono\"]\n            },\n            \"fontSize\": {\n                    \"id-name\": [\"20px\", {\"lineHeight\": \"24px\", \"letterSpacing\": \"-0.02em\", \"fontWeight\": \"700\"}],\n                    \"id-role\": [\"14px\", {\"lineHeight\": \"18px\", \"letterSpacing\": \"0.05em\", \"fontWeight\": \"500\"}],\n                    \"body-sm\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}],\n                    \"label-caps\": [\"10px\", {\"lineHeight\": \"12px\", \"letterSpacing\": \"0.08em\", \"fontWeight\": \"600\"}],\n                    \"id-number\": [\"12px\", {\"lineHeight\": \"16px\", \"fontWeight\": \"400\"}]\n            }\n          },\n        },\n      }"
}