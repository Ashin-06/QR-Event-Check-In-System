{
  "name": "Geometric Abstract ID",
  "html": "<!-- Top App Bar (Shared Component) -->\n<header class=\"bg-surface dark:bg-on-surface w-full top-0 sticky border-b border-outline-variant dark:border-outline flex justify-between items-center px-section-margin w-full h-16 z-50\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-primary dark:text-primary-fixed\" data-icon=\"badge\">badge</span>\n<h1 class=\"font-id-name text-id-name text-primary dark:text-primary-fixed\">ID Registry</h1>\n</div>\n<div class=\"w-10 h-10 rounded-full bg-surface-variant flex items-center justify-center overflow-hidden border border-outline-variant\">\n<img alt=\"Profile\" class=\"w-full h-full object-cover\" data-alt=\"A professional headshot of a modern creative designer with soft lighting, set against a clean studio background. The style is minimalist with a focus on high-fidelity digital aesthetic, utilizing a palette of soft blues and crisp whites to match the corporate tech identity.\" src=\"{PHOTO_URL}\"/>\n</div>\n</header>\n<main class=\"flex-grow flex flex-col md:flex-row items-center justify-center p-6 gap-12 mb-20 md:mb-0\">\n<!-- Left Section: Designer Narrative -->\n<div class=\"max-w-md space-y-6 hidden lg:block\">\n<div class=\"space-y-2\">\n<span class=\"font-label-caps text-label-caps bg-secondary-container text-on-secondary-container px-3 py-1 rounded-full uppercase tracking-widest\">Creative Mode</span>\n<h2 class=\"text-4xl font-id-name text-primary font-extrabold leading-tight\">Geometric Abstract ID Framework</h2>\n<p class=\"text-on-surface-variant font-id-role\">A high-fidelity physical asset design utilizing asymmetric layouts and vibrant tech signatures to ensure institutional trust and aesthetic relevance.</p>\n</div>\n<div class=\"grid grid-cols-2 gap-4\">\n<div class=\"p-4 bg-surface-container rounded-xl border border-outline-variant\">\n<span class=\"material-symbols-outlined text-primary mb-2\" data-icon=\"brush\">brush</span>\n<p class=\"font-id-role text-xs text-on-surface\">Geometric patterns for unique identification.</p>\n</div>\n<div class=\"p-4 bg-surface-container rounded-xl border border-outline-variant\">\n<span class=\"material-symbols-outlined text-primary mb-2\" data-icon=\"print\">print</span>\n<p class=\"font-id-role text-xs text-on-surface\">Optimized for CR80 standard thermal printing.</p>\n</div>\n</div>\n</div>\n<!-- Right Section: The ID Card (Portrait) -->\n<div class=\"card-perspective\">\n<div class=\"cr80-card bg-surface-container-lowest rounded-[24px] shadow-2xl flex flex-col relative border border-outline-variant/30 transform transition-transform hover:rotate-y-6 hover:rotate-x-2 duration-500 group\">\n<!-- Geometric Background Patterns (Side Circles) -->\n<div class=\"absolute inset-0 pointer-events-none overflow-hidden\">\n<div class=\"absolute -left-20 top-1/4 w-48 h-48 rounded-full bg-primary-container opacity-20 blur-xl\"></div>\n<div class=\"absolute -left-10 top-1/3 w-32 h-32 rounded-full bg-secondary-container opacity-30 mix-blend-multiply\"></div>\n<div class=\"absolute -left-5 top-1/2 w-24 h-24 rounded-full bg-tertiary-fixed opacity-40 border-4 border-white/50\"></div>\n<div class=\"absolute -right-10 bottom-1/4 w-40 h-40 rounded-full bg-primary-container/10\"></div>\n</div>\n<!-- Header Section -->\n<div class=\"pt-8 px-8 relative z-10\">\n<div class=\"flex justify-between items-start\">\n<div class=\"space-y-1\">\n<h3 class=\"font-id-name text-id-name text-primary uppercase tracking-tighter leading-none\">INNOVATION LAB</h3>\n<p class=\"font-label-caps text-[8px] text-on-surface-variant/70 tracking-[0.2em]\">PRECISION · RESEARCH · FUTURE</p>\n</div>\n<div class=\"w-12 h-12 flex items-center justify-center bg-primary text-white rounded-xl shadow-lg\">\n<span class=\"material-symbols-outlined text-3xl\" data-icon=\"biotech\">biotech</span>\n</div>\n</div>\n</div>\n<!-- Main Identity Content -->\n<div class=\"mt-8 px-8 flex-grow relative z-10\">\n<!-- Dynamic Grid of 7 Data Fields -->\n<div class=\"grid grid-cols-2 gap-x-6 gap-y-5\">\n<div class=\"col-span-2\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">{Pass Type}</label>\n<span class=\"font-id-name text-[22px] text-on-background block border-b-2 border-primary-container/20 pb-1\">{Name}</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Clearance</label>\n<div class=\"bg-primary text-white px-3 py-1 rounded-full w-fit font-id-number text-[10px] tracking-widest\">LEVEL 09</div>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">ID Serial</label>\n<span class=\"font-id-number text-id-number text-on-surface\">{Registration Number}</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Department</label>\n<span class=\"font-id-role text-id-role text-on-surface-variant font-bold\">{Unique ID}</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Assigned</label>\n<span class=\"font-id-role text-id-role text-on-surface-variant font-bold\">Jan 2024</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Location</label>\n<span class=\"font-id-role text-id-role text-on-surface-variant font-bold\">Silo A-4</span>\n</div>\n<div class=\"col-span-1\">\n<label class=\"font-label-caps text-label-caps text-primary opacity-60 uppercase block mb-1\">Status</label>\n<span class=\"font-id-role text-id-role text-secondary font-bold flex items-center gap-1\">\n<span class=\"w-2 h-2 rounded-full bg-secondary\"></span>\n                                ACTIVE\n                            </span>\n</div>\n</div>\n<!-- Integrated QR Code in Circle -->\n<div class=\"mt-12 flex justify-center\">\n<div class=\"relative\">\n<!-- Geometric background for QR -->\n<div class=\"absolute inset-0 bg-primary-container rounded-full scale-125 opacity-10\"></div>\n<div class=\"absolute -top-4 -right-4 w-12 h-12 rounded-full bg-secondary-container/30\"></div>\n<div class=\"relative w-32 h-32 bg-white p-3 rounded-2xl shadow-xl border border-outline-variant/30 flex items-center justify-center\">\n<img alt=\"QR Code\" class=\"w-full h-full opacity-90\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n</div>\n</div>\n<!-- Footer Section -->\n<div class=\"h-20 bg-primary-container relative z-10 flex items-center justify-center overflow-hidden\">\n<!-- Shimmer overlay -->\n<div class=\"hologram-shimmer absolute inset-0 opacity-40\"></div>\n<div class=\"relative flex flex-col items-center\">\n<h4 class=\"font-id-name text-on-primary-container text-sm font-bold tracking-widest uppercase\">Global Tech Summit 2024</h4>\n<div class=\"flex gap-2 mt-1\">\n<div class=\"w-1.5 h-1.5 rounded-full bg-secondary-fixed\"></div>\n<div class=\"w-1.5 h-1.5 rounded-full bg-secondary-fixed/50\"></div>\n<div class=\"w-1.5 h-1.5 rounded-full bg-secondary-fixed/20\"></div>\n</div>\n</div>\n<!-- Digital Hologram (Shared Token) -->\n<div class=\"absolute bottom-2 right-4 opacity-30\">\n<span class=\"material-symbols-outlined text-4xl text-white\" data-icon=\"check_circle\" style=\"font-variation-settings: 'FILL' 1;\">check_circle</span>\n</div>\n</div>\n</div>\n</div>\n</main>\n<!-- Bottom Nav Bar (Shared Component - Mobile Only) -->\n<nav class=\"md:hidden fixed bottom-0 left-0 w-full bg-surface-container-highest dark:bg-on-surface border-t border-outline-variant flex justify-around p-2 z-50\">\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"dashboard\">dashboard</span>\n<span class=\"font-label-caps text-label-caps\">Dashboard</span>\n</a>\n<a class=\"flex flex-col items-center justify-center bg-primary-container text-on-primary-container rounded-xl p-2 active:scale-95 transition-transform\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"upload_file\">upload_file</span>\n<span class=\"font-label-caps text-label-caps\">Bulk Import</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"history\">history</span>\n<span class=\"font-label-caps text-label-caps\">History</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-on-surface-variant p-2 hover:bg-surface-variant transition-transform active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\" data-icon=\"person\">person</span>\n<span class=\"font-label-caps text-label-caps\">Profile</span>\n</a>\n</nav>\n<!-- Hidden Navigation Drawer (Web Structure Reference) -->\n<aside class=\"hidden md:block fixed left-0 top-16 h-[calc(100vh-64px)] w-20 lg:w-64 bg-surface-container-low border-r border-outline-variant z-40\">\n<div class=\"flex flex-col h-full py-6 px-4\">\n<div class=\"space-y-4\">\n<div class=\"flex items-center gap-3 p-3 bg-secondary-container text-on-secondary-container rounded-full group cursor-pointer transition-colors duration-200\">\n<span class=\"material-symbols-outlined\" data-icon=\"app_registration\">app_registration</span>\n<span class=\"font-id-role text-id-role hidden lg:inline\">Registration</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-full group cursor-pointer transition-colors duration-200\">\n<span class=\"material-symbols-outlined\" data-icon=\"style\">style</span>\n<span class=\"font-id-role text-id-role hidden lg:inline\">Templates</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-full group cursor-pointer transition-colors duration-200\">\n<span class=\"material-symbols-outlined\" data-icon=\"analytics\">analytics</span>\n<span class=\"font-id-role text-id-role hidden lg:inline\">Analytics</span>\n</div>\n<div class=\"flex items-center gap-3 p-3 text-on-surface-variant hover:bg-surface-variant rounded-full group cursor-pointer transition-colors duration-200\">\n<span class=\"material-symbols-outlined\" data-icon=\"settings\">settings</span>\n<span class=\"font-id-role text-id-role hidden lg:inline\">Settings</span>\n</div>\n</div>\n<div class=\"mt-auto p-4 bg-surface-container rounded-2xl hidden lg:block border border-outline-variant\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-10 h-10 rounded-full bg-primary-container text-white flex items-center justify-center\">\n<span class=\"material-symbols-outlined\" data-icon=\"help\">help</span>\n</div>\n<div>\n<p class=\"font-id-role text-xs font-bold text-on-surface\">Need Help?</p>\n<p class=\"font-body-sm text-[10px] text-on-surface-variant\">View Documentation</p>\n</div>\n</div>\n</div>\n</div>\n</aside>\n<script>\n        // Micro-interaction for the card following the mouse\n        const card = document.querySelector('.cr80-card');\n        const container = document.querySelector('.card-perspective');\n\n        container.addEventListener('mousemove', (e) => {\n            const rect = container.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            \n            const rotateX = (y - centerY) / 20;\n            const rotateY = (centerX - x) / 20;\n            \n            card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n\n        container.addEventListener('mouseleave', () => {\n            card.style.transform = 'rotateX(0deg) rotateY(0deg)';\n        });\n    </script>",
  "css": "\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .card-perspective {\n            perspective: 1000px;\n        }\n        .cr80-card {\n            width: 337.5px; /* Proportionally scaled CR80 ratio */\n            height: 531px;\n            overflow: hidden;\n            position: relative;\n        }\n        .glass-effect {\n            background: rgba(255, 255, 255, 0.4);\n            backdrop-filter: blur(8px);\n            border: 1px solid rgba(255, 255, 255, 0.3);\n        }\n        .hologram-shimmer {\n            background: linear-gradient(135deg, rgba(0,255,255,0.2) 0%, rgba(255,0,255,0.2) 50%, rgba(255,221,0,0.2) 100%);\n            mix-blend-mode: overlay;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}