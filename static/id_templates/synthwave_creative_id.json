{
  "name": "Synthwave Creative ID",
  "html": "<!-- Main Content Canvas -->\n<main class=\"relative w-full max-w-4xl mx-auto flex flex-col md:flex-row gap-8 items-start justify-center\">\n<!-- ID Card (The Masterwork) -->\n<div class=\"relative w-[340px] h-[540px] rounded-[24px] overflow-hidden synthwave-gradient shadow-2xl flex flex-col items-center p-0 group\">\n<!-- Scanline Overlay -->\n<div class=\"absolute inset-0 scanline opacity-20 pointer-events-none\"></div>\n<!-- Top Header -->\n<header class=\"w-full pt-8 pb-4 px-6 z-10 flex flex-col items-center\">\n<h1 class=\"font-retro text-[24px] tracking-widest text-white retro-glow italic uppercase\">\n                    CREATIVE HUB\n                </h1>\n<div class=\"w-full h-[2px] bg-gradient-to-r from-transparent via-tertiary-fixed to-transparent mt-2 opacity-50\"></div>\n</header>\n<!-- Side Badge (Floating) -->\n<div class=\"absolute right-0 top-32 z-20\">\n<div class=\"bg-[#ff4d00] text-white font-retro px-4 py-1 rounded-l-md shadow-lg transform rotate-90 origin-right translate-x-1 translate-y-8 tracking-tighter text-[14px]\">\n                    ARTIST\n                </div>\n</div>\n<!-- Profile Section -->\n<div class=\"relative mt-2 z-10\">\n<div class=\"w-32 h-32 rounded-full border-4 border-white/20 p-1 bg-gradient-to-tr from-[#0047ab] to-[#ff4d00]\">\n<img alt=\"Profile\" class=\"w-full h-full object-cover rounded-full\" data-alt=\"A cinematic portrait of a creative individual with neon purple and orange ambient lighting hitting their face. The person has an expressive, artistic look, set against a dark, hazy studio background that suggests a high-end synthwave aesthetic. The lighting is dramatic and directional, highlighting facial features with a vibrant, tech-inspired glow.\" src=\"{PHOTO_URL}\"/>\n</div>\n<div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 bg-white text-primary px-3 py-0.5 rounded-full shadow-md z-20\">\n<span class=\"material-symbols-outlined text-[14px] align-middle\" data-weight=\"fill\">check_circle</span>\n</div>\n</div>\n<!-- Identity Info -->\n<div class=\"mt-6 text-center z-10 w-full px-6\">\n<h2 class=\"font-id-name text-id-name text-white mb-1 uppercase tracking-wider\">{Name}</h2>\n<p class=\"font-id-role text-id-role text-[#ffb95f] uppercase tracking-widest\">{Pass Type}</p>\n</div>\n<!-- Data Fields Grid (The 6 Fields) -->\n<div class=\"mt-6 w-full px-8 z-10 grid grid-cols-2 gap-y-4 gap-x-2\">\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Registry ID</span>\n<span class=\"font-id-number text-id-number text-white\">{Registration Number}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Department</span>\n<span class=\"font-id-number text-id-number text-white\">{Unique ID}</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Access Lvl</span>\n<span class=\"font-id-number text-id-number text-white\">Prism-Tier 4</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Issue Date</span>\n<span class=\"font-id-number text-id-number text-white\">04.2088</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Exp Date</span>\n<span class=\"font-id-number text-id-number text-white\">04.2093</span>\n</div>\n<div class=\"flex flex-col\">\n<span class=\"font-label-caps text-label-caps text-white/60 uppercase\">Pass Tier</span>\n<span class=\"font-id-number text-id-number text-white\">{Pass Type}</span>\n</div>\n</div>\n<!-- QR Code & Footer -->\n<div class=\"mt-auto mb-8 w-full px-8 z-10 flex items-end justify-between\">\n<div class=\"flex flex-col gap-1\">\n<div class=\"w-8 h-1 bg-white/30 rounded-full\"></div>\n<div class=\"w-12 h-1 bg-white/30 rounded-full\"></div>\n<div class=\"w-6 h-1 bg-white/30 rounded-full\"></div>\n</div>\n<div class=\"p-2 bg-white/90 rounded-lg shadow-[0_8px_30px_rgb(0,0,0,0.3)] hover:scale-105 transition-transform duration-300\">\n<img alt=\"QR Code\" class=\"w-16 h-16 mix-blend-multiply opacity-90\" src=\"{QR_CODE_URL}\"/>\n</div>\n</div>\n<!-- Decorative Digital Shimmer -->\n<div class=\"absolute bottom-4 left-4 opacity-30 text-[8px] font-id-number text-white/50 tracking-tighter leading-tight pointer-events-none\">\n                ENCRYPTED_STREAM_ID: 0x9928AF1 <br/>\n                AUTH_PROTOCOL: RETRO_SYNC_v3.2\n            </div>\n</div>\n<!-- UI Sidebar / Info Panel (Admin Controls) -->\n<div class=\"flex-1 w-full max-w-sm space-y-6\">\n<div class=\"bg-surface rounded-xl p-6 shadow-sm border border-outline-variant\">\n<div class=\"flex items-center gap-3 mb-6\">\n<span class=\"material-symbols-outlined text-primary\" data-weight=\"fill\">badge</span>\n<h3 class=\"font-id-name text-id-name text-on-surface\">Card Management</h3>\n</div>\n<div class=\"space-y-4\">\n<div class=\"p-4 bg-surface-container-low rounded-lg border border-outline-variant/30\">\n<p class=\"font-label-caps text-label-caps text-on-surface-variant mb-1 uppercase\">Active Template</p>\n<p class=\"font-id-role text-id-role text-primary\">Synthwave Creative v2</p>\n</div>\n<div class=\"grid grid-cols-2 gap-3\">\n<button class=\"flex items-center justify-center gap-2 py-3 px-4 bg-primary text-on-primary rounded-lg font-id-role transition-all hover:bg-primary-container active:scale-95\">\n<span class=\"material-symbols-outlined text-sm\">edit</span>\n                            Edit Profile\n                        </button>\n<button class=\"flex items-center justify-center gap-2 py-3 px-4 border border-primary text-primary rounded-lg font-id-role transition-all hover:bg-primary-fixed-dim active:scale-95\">\n<span class=\"material-symbols-outlined text-sm\">print</span>\n                            Print Physical\n                        </button>\n</div>\n<div class=\"pt-4 border-t border-outline-variant\">\n<h4 class=\"font-label-caps text-label-caps text-on-surface-variant mb-3 uppercase\">Quick Status</h4>\n<div class=\"flex flex-wrap gap-2\">\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container text-[10px] font-bold uppercase tracking-wide\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n                                check_circle\n                            </span>\n<span class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-highest text-on-surface-variant text-[10px] font-bold uppercase tracking-wide\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-outline\"></span>\n                                NFC Active\n                            </span>\n</div>\n</div>\n</div>\n</div>\n<!-- Activity Log -->\n<div class=\"bg-surface rounded-xl p-6 shadow-sm border border-outline-variant\">\n<h3 class=\"font-label-caps text-label-caps text-on-surface-variant mb-4 uppercase\">Recent Terminal Access</h3>\n<div class=\"space-y-3\">\n<div class=\"flex items-center justify-between text-[11px] font-id-number\">\n<span class=\"text-on-surface-variant\">Main Entrance A</span>\n<span class=\"text-on-surface\">10:42 AM</span>\n</div>\n<div class=\"flex items-center justify-between text-[11px] font-id-number\">\n<span class=\"text-on-surface-variant\">Design Lab 4</span>\n<span class=\"text-on-surface\">09:15 AM</span>\n</div>\n<div class=\"flex items-center justify-between text-[11px] font-id-number\">\n<span class=\"text-on-surface-variant\">Cloud Server Hub</span>\n<span class=\"text-on-surface\">Yesterday</span>\n</div>\n</div>\n</div>\n</div>\n</main>\n<!-- Interactive Navigation (Floating Bottom) -->\n<nav class=\"fixed bottom-6 left-1/2 -translate-x-1/2 glass-panel rounded-full px-6 py-3 flex items-center gap-8 shadow-2xl z-50\">\n<button class=\"flex flex-col items-center gap-1 text-[#ffb95f] hover:text-white transition-colors group\">\n<span class=\"material-symbols-outlined text-[20px]\">dashboard</span>\n<span class=\"font-label-caps text-[8px] uppercase tracking-tighter group-hover:block hidden\">Dash</span>\n</button>\n<button class=\"flex flex-col items-center gap-1 text-white/50 hover:text-white transition-colors group\">\n<span class=\"material-symbols-outlined text-[20px]\">layers</span>\n<span class=\"font-label-caps text-[8px] uppercase tracking-tighter group-hover:block hidden\">Layers</span>\n</button>\n<div class=\"w-10 h-10 rounded-full bg-[#ff4d00] flex items-center justify-center text-white shadow-lg shadow-[#ff4d00]/30 cursor-pointer hover:rotate-90 transition-transform duration-300\">\n<span class=\"material-symbols-outlined text-[24px]\">add</span>\n</div>\n<button class=\"flex flex-col items-center gap-1 text-white/50 hover:text-white transition-colors group\">\n<span class=\"material-symbols-outlined text-[20px]\">settings</span>\n<span class=\"font-label-caps text-[8px] uppercase tracking-tighter group-hover:block hidden\">Config</span>\n</button>\n<button class=\"flex flex-col items-center gap-1 text-white/50 hover:text-white transition-colors group\">\n<span class=\"material-symbols-outlined text-[20px]\">person</span>\n<span class=\"font-label-caps text-[8px] uppercase tracking-tighter group-hover:block hidden\">Me</span>\n</button>\n</nav>\n<script>\n        // Simple Micro-interaction for the card\n        const card = document.querySelector('.group');\n        card.addEventListener('mousemove', (e) => {\n            const rect = card.getBoundingClientRect();\n            const x = e.clientX - rect.left;\n            const y = e.clientY - rect.top;\n            \n            const centerX = rect.width / 2;\n            const centerY = rect.height / 2;\n            \n            const rotateX = (y - centerY) / 20;\n            const rotateY = (centerX - x) / 20;\n            \n            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;\n        });\n        \n        card.addEventListener('mouseleave', () => {\n            card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0)';\n        });\n    </script>",
  "css": "\n        .synthwave-gradient {\n            background: linear-gradient(135deg, #2d004b 0%, #001946 50%, #ff4d00 100%);\n            background-size: 200% 200%;\n            animation: gradientShift 8s ease infinite;\n        }\n        @keyframes gradientShift {\n            0% { background-position: 0% 50%; }\n            50% { background-position: 100% 50%; }\n            100% { background-position: 0% 50%; }\n        }\n        .retro-glow {\n            text-shadow: 0 0 10px rgba(255, 77, 0, 0.8), 0 0 20px rgba(255, 77, 0, 0.5);\n        }\n        .glass-panel {\n            background: rgba(255, 255, 255, 0.1);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n        }\n        .scanline {\n            background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.1) 50%);\n            background-size: 100% 4px;\n        }\n    \n\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  "
}